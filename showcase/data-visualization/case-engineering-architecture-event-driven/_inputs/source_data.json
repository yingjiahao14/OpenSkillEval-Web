{
  "microservices": {
    "description": "The 6 microservices in the event-driven architecture with their roles and communication patterns",
    "data": [
      {
        "id": "svc-order",
        "name": "Order Service",
        "role": "producer",
        "domain": "order-management",
        "produces_topics": [
          "orders.created",
          "orders.updated"
        ],
        "consumes_topics": [],
        "retry_policy": "none",
        "health_endpoint": "/actuator/health",
        "alert_threshold_lag_ms": 500
      },
      {
        "id": "svc-payment",
        "name": "Payment Service",
        "role": "producer-consumer",
        "domain": "payment-processing",
        "produces_topics": [
          "payments.completed",
          "payments.failed"
        ],
        "consumes_topics": [
          "orders.created"
        ],
        "retry_policy": "exponential-backoff",
        "health_endpoint": "/actuator/health",
        "alert_threshold_lag_ms": 1000
      },
      {
        "id": "svc-inventory",
        "name": "Inventory Service",
        "role": "producer-consumer",
        "domain": "inventory-management",
        "produces_topics": [
          "inventory.reserved",
          "inventory.released"
        ],
        "consumes_topics": [
          "orders.created",
          "payments.failed"
        ],
        "retry_policy": "fixed-interval",
        "health_endpoint": "/actuator/health",
        "alert_threshold_lag_ms": 750
      },
      {
        "id": "svc-shipping",
        "name": "Shipping Service",
        "role": "consumer",
        "domain": "logistics",
        "produces_topics": [
          "shipping.dispatched"
        ],
        "consumes_topics": [
          "payments.completed",
          "inventory.reserved"
        ],
        "retry_policy": "exponential-backoff",
        "health_endpoint": "/actuator/health",
        "alert_threshold_lag_ms": 2000
      },
      {
        "id": "svc-notification",
        "name": "Notification Service",
        "role": "consumer",
        "domain": "communication",
        "produces_topics": [],
        "consumes_topics": [
          "orders.created",
          "payments.completed",
          "payments.failed",
          "shipping.dispatched"
        ],
        "retry_policy": "fixed-interval",
        "health_endpoint": "/actuator/health",
        "alert_threshold_lag_ms": 3000
      },
      {
        "id": "svc-analytics",
        "name": "Analytics Service",
        "role": "consumer",
        "domain": "reporting",
        "produces_topics": [],
        "consumes_topics": [
          "orders.created",
          "orders.updated",
          "payments.completed",
          "payments.failed",
          "inventory.reserved",
          "inventory.released",
          "shipping.dispatched"
        ],
        "retry_policy": "none",
        "health_endpoint": "/actuator/health",
        "alert_threshold_lag_ms": 5000
      }
    ]
  },
  "kafka_topics": {
    "description": "Kafka topics used for event routing between microservices, including partition and replication configuration",
