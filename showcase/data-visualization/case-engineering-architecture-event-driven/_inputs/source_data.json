  "retry_policies": {
    "description": "Retry strategy configuration for each consumer microservice",
    "data": [
      {
        "service_id": "svc-payment",
        "strategy": "exponential-backoff",
        "initial_delay_ms": 1000,
        "max_delay_ms": 60000,
        "multiplier": 2.0,
        "max_retries": 5,
        "dlq_topic": "dlq.payments",
        "jitter": true
      },
      {
        "service_id": "svc-inventory",
        "strategy": "fixed-interval",
        "initial_delay_ms": 3000,
        "max_delay_ms": 3000,
        "multiplier": 1.0,
        "max_retries": 3,
        "dlq_topic": "dlq.inventory",
        "jitter": false
      },
      {
        "service_id": "svc-shipping",
        "strategy": "exponential-backoff",
        "initial_delay_ms": 2000,
        "max_delay_ms": 30000,
        "multiplier": 2.0,
        "max_retries": 4,
        "dlq_topic": "dlq.shipping",
        "jitter": true
      },
      {
        "service_id": "svc-notification",
        "strategy": "fixed-interval",
        "initial_delay_ms": 5000,
        "max_delay_ms": 5000,
        "multiplier": 1.0,
        "max_retries": 2,
