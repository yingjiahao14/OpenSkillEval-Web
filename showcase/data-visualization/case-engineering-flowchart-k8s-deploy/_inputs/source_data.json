        "lane": "canary",
        "type": "check",
        "duration_min": 10,
        "order": 17
      },
      {
        "id": "canary-ramp-50",
        "label": "Ramp Canary to 50% Traffic",
        "lane": "canary",
        "type": "action",
        "traffic_pct": 50,
        "order": 18
      },
      {
        "id": "canary-gate",
        "label": "Canary Health Gate",
