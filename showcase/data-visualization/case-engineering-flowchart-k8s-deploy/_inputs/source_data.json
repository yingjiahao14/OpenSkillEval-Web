        "order": 14
      },
      {
        "id": "canary-hpa-check",
        "label": "HPA Scaling Check (Canary)",
        "lane": "canary",
        "type": "hpa_decision",
        "cpu_threshold_pct": 50,
        "mem_threshold_pct": 60,
        "order": 15
      },
      {
        "id": "canary-ramp-25",
        "label": "Ramp Canary to 25% Traffic",
        "lane": "canary",
        "type": "action",
        "traffic_pct": 25,
        "order": 16
      },
      {
        "id": "canary-observe-2",
