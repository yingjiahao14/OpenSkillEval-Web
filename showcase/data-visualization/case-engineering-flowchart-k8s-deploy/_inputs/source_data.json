      {
        "id": "src-commit",
        "label": "Source Commit & PR Merge",
        "lane": "dev",
        "type": "action",
        "order": 1
      },
      {
        "id": "ci-build",
        "label": "CI Build & Unit Tests",
        "lane": "dev",
        "type": "action",
        "order": 2
      },
      {
        "id": "docker-push",
        "label": "Docker Image Build & Push",
        "lane": "dev",
        "type": "action",
        "order": 3
      },
      {
        "id": "dev-deploy",
        "label": "Deploy to Dev Namespace",
        "lane": "dev",
        "type": "action",
        "order": 4
      },
      {
