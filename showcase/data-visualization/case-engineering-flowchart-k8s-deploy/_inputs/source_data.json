        "mem_threshold_pct": 70,
        "order": 6
      },
      {
        "id": "dev-gate",
        "label": "Dev Health Gate",
        "lane": "dev",
        "type": "decision",
        "error_rate_threshold_pct": 5.0,
        "order": 7
      },
      {
        "id": "staging-deploy",
        "label": "Deploy to Staging Namespace",
        "lane": "staging",
        "type": "action",
        "order": 8
      },
      {
        "id": "staging-integration",
        "label": "Integration & E2E Tests",
        "lane": "staging",
        "type": "check",
        "order": 9
      },
      {
        "id": "staging-hpa-check",
        "label": "HPA Scaling Check (Staging)",
        "lane": "staging",
        "type": "hpa_decision",
        "cpu_threshold_pct": 55,
        "mem_threshold_pct": 65,
        "order": 10
      },
      {
        "id": "staging-perf",
        "label": "Performance / Load Tests",
