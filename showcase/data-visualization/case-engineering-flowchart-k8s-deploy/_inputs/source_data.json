        "error_rate_threshold_pct": 1.0,
        "p99_latency_ms_threshold": 250,
        "order": 19
      },
      {
        "id": "prod-blue-green-prep",
        "label": "Prepare Standby Slot (Green)",
        "lane": "production",
        "type": "action",
        "order": 20
      },
      {
        "id": "prod-deploy-green",
        "label": "Deploy to Green Slot",
        "lane": "production",
        "type": "action",
        "order": 21
      },
      {
        "id": "prod-green-healthcheck",
        "label": "Green Slot Health Check",
        "lane": "production",
        "type": "check",
        "order": 22
      },
      {
        "id": "prod-hpa-check",
        "label": "HPA Scaling Check (Prod)",
        "lane": "production",
        "type": "hpa_decision",
        "cpu_threshold_pct": 45,
        "mem_threshold_pct": 55,
        "order": 23
      },
      {
        "id": "prod-bg-switch-gate",
        "label": "Blue-Green Switch Decision",
        "lane": "production",
        "type": "decision",
        "error_rate_threshold_pct": 0.5,
        "p99_latency_ms_threshold": 200,
        "order": 24
      },
      {
        "id": "prod-switch-traffic",
        "label": "Switch 100% Traffic → Green",
        "lane": "production",
        "type": "action",
        "order": 25
      },
      {
        "id": "prod-verify",
        "label": "Post-Switch Verification (3 min)",
        "lane": "production",
        "type": "check",
        "duration_min": 3,
        "order": 26
      },
      {
        "id": "prod-finalize",
        "label": "Decommission Blue Slot",
        "lane": "production",
        "type": "action",
        "order": 27
      },
      {
        "id": "pipeline-complete",
        "label": "Pipeline Complete ✓",
        "lane": "production",
        "type": "terminal",
        "order": 28
      },
      {
        "id": "rollback-dev",
        "label": "Rollback Dev Deployment",
        "lane": "dev",
        "type": "rollback",
        "order": 100
      },
      {
        "id": "rollback-staging",
        "label": "Rollback Staging Deployment",
        "lane": "staging",
        "type": "rollback",
        "order": 101
      },
      {
        "id": "rollback-canary",
        "label": "Rollback Canary (Shift Traffic to Stable)",
        "lane": "canary",
        "type": "rollback",
        "order": 102
      },
      {
        "id": "rollback-prod",
        "label": "Rollback: Revert Traffic → Blue",
        "lane": "production",
        "type": "rollback",
        "order": 103
      },
      {
        "id": "hpa-scale-up",
        "label": "HPA: Scale Up Replicas",
        "lane": "global",
        "type": "hpa_action",
        "order": 200
      },
      {
        "id": "hpa-scale-down",
        "label": "HPA: Scale Down Replicas",
        "lane": "global",
        "type": "hpa_action",
        "order": 201
      },
      {
        "id": "alert-oncall",
        "label": "Alert On-Call & Open Incident",
        "lane": "global",
        "type": "action",
        "order": 202
      }
    ]
  },
