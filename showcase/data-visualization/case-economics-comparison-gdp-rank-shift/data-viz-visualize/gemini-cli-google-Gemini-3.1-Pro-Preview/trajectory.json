          "arguments": {
            "content": "<!DOCTYPE html>\n<html lang=\"en\" class=\"theme-light\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Global GDP Rankings: 1970–2025</title>\n  <link href=\"/app/libs/fonts/inter.css\" rel=\"stylesheet\">\n  <script src=\"/app/libs/chart.js\"></script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n    :root { interpolate-size: allow-keywords; }\n\n    /* ===== THEMES ===== */\n    html.theme-dark {\n      --bg: #0A0A0A; --surface: #141414; --surface-hover: #1C1C1C;\n      --border: rgba(255,255,255,0.08);\n      --text: #EDEDED; --text-secondary: #888;\n      --accent: #3b82f6; --accent-secondary: #8b5cf6;\n      --positive: #10b981; --negative: #f43f5e; --warning: #f59e0b;\n    }\n    html.theme-light {\n      --bg: #FAFAF9; --surface: #FFFFFF; --surface-hover: #F5F5F4;\n      --border: rgba(0,0,0,0.08);\n      --text: #0f172a; --text-secondary: #64748b;\n      --accent: #2563eb; --accent-secondary: #7c3aed;\n      --positive: #059669; --negative: #e11d48; --warning: #d97706;\n    }\n\n    body {\n      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n      background: var(--bg); color: var(--text);\n      line-height: 1.6; -webkit-font-smoothing: antialiased;\n      letter-spacing: -0.01em; \n      /* Hide overflow to prevent scrollbars in screenshot */\n      overflow: hidden; \n      /* Fixed size for perfect screenshot */\n      width: 1200px;\n      height: 800px;\n      display: flex;\n      flex-direction: column;\n    }\n    \n    h1,h2,h3 { color: var(--text); letter-spacing: -0.03em; line-height: 1.1; text-wrap: balance; }\n    h1 { font-weight: 700; font-size: 2.5rem; margin-bottom: 0.5rem; }\n    p { font-weight: 400; color: var(--text-secondary); font-size: 1.125rem; max-width: 900px; }\n    \n    .header { padding: 48px 48px 24px 48px; }\n    .content-area { flex: 1; padding: 0 48px 48px 48px; display: flex; flex-direction: column; }\n    \n    .chart-container {\n      flex: 1;\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 12px;\n      padding: 30px;\n      position: relative;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>The Great GDP Shift (1970–2025)</h1>\n    <p>Ranking the Top 15 Global Economies by Nominal GDP. <br/>China's spectacular climb and India's late-stage surge contrast sharply with Japan's slide and the stability of established Western economies.</p>\n  </div>\n\n  <div class=\"content-area\">\n    <div class=\"chart-container\" role=\"img\" aria-label=\"Bump chart showing the GDP ranking of 15 countries over decades from 1970 to 2025. China, Japan, and India are highlighted.\">\n      <canvas id=\"bumpChart\"></canvas>\n    </div>\n  </div>\n\n  <script>\n    Chart.defaults.animation = false;\n    \n    const rawData = [\n      {\"country\": \"United States\", \"ranks\": [1, 1, 1, 1, 1, 1]},\n      {\"country\": \"Japan\", \"ranks\": [3, 2, 2, 2, 3, 4]},\n      {\"country\": \"Germany\", \"ranks\": [2, 3, 3, 3, 4, 3]},\n      {\"country\": \"France\", \"ranks\": [4, 4, 4, 5, 5, 7]},\n      {\"country\": \"United Kingdom\", \"ranks\": [5, 5, 6, 4, 6, 6]},\n      {\"country\": \"Italy\", \"ranks\": [6, 6, 5, 6, 7, 9]},\n      {\"country\": \"Canada\", \"ranks\": [7, 7, 7, 7, 9, 10]},\n      {\"country\": \"China\", \"ranks\": [9, 10, 10, 6, 2, 2]},\n      {\"country\": \"Brazil\", \"ranks\": [8, 8, 9, 9, 8, 8]},\n      {\"country\": \"India\", \"ranks\": [13, 13, 13, 12, 10, 5]},\n      {\"country\": \"Australia\", \"ranks\": [10, 11, 11, 11, 13, 13]},\n      {\"country\": \"South Korea\", \"ranks\": [15, 15, 15, 13, 14, 12]},\n      {\"country\": \"Mexico\", \"ranks\": [12, 12, 12, 10, 11, 14]},\n      {\"country\": \"Spain\", \"ranks\": [11, 9, 8, 8, 12, 15]},\n      {\"country\": \"Russia\", \"ranks\": [14, 14, 14, 14, 15, 11]}\n    ];\n\n    function buildCharts() {\n      const isDark = document.documentElement.classList.contains('theme-dark');\n      const rootStyles = getComputedStyle(document.documentElement);\n      \n      const textColor = rootStyles.getPropertyValue('--text').trim();\n      const textMuted = rootStyles.getPropertyValue('--text-secondary').trim();\n      const gridColor = rootStyles.getPropertyValue('--border').trim();\n      \n      const chinaColor = rootStyles.getPropertyValue('--negative').trim();\n      const japanColor = rootStyles.getPropertyValue('--warning').trim();\n      const indiaColor = rootStyles.getPropertyValue('--positive').trim();\n      \n      const stableColor = isDark ? 'rgba(255,255,255,0.3)' : 'rgba(0,0,0,0.3)';\n      const otherColor = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';\n\n      const datasets = rawData.map(d => {\n        let color = otherColor;\n        let width = 2;\n        let zIndex = 0;\n        let showInLegend = false;\n        \n        if (d.country === 'China') { color = chinaColor; width = 5; zIndex = 10; showInLegend = true; }\n        else if (d.country === 'Japan') { color = japanColor; width = 4; zIndex = 9; showInLegend = true; }\n        else if (d.country === 'India') { color = indiaColor; width = 4; zIndex = 8; showInLegend = true; }\n        else if (['United States', 'Germany', 'France', 'United Kingdom'].includes(d.country)) {\n          color = stableColor; width = 3; zIndex = 5; showInLegend = true;\n        }\n\n        return {\n          label: d.country,\n          data: d.ranks,\n          borderColor: color,\n          backgroundColor: color,\n          borderWidth: width,\n          tension: 0.4,\n          pointRadius: zIndex > 0 ? 5 : 0,\n          pointHoverRadius: 8,\n          order: 100 - zIndex,\n          showInLegend: showInLegend\n        };\n      });\n\n      const ctx = document.getElementById('bumpChart');\n      if (window.myChart) { window.myChart.destroy(); }\n      \n      window.myChart = new Chart(ctx, {\n        type: 'line',\n        data: {\n          labels: ['1970', '1980', '1990', '2000', '2010', '2025'],\n          datasets: datasets\n        },\n        options: {\n          responsive: true,\n          maintainAspectRatio: false,\n          animation: false,\n          layout: { padding: { top: 10, right: 30, bottom: 10, left: 10 } },\n          plugins: {\n            tooltip: {\n              enabled: true,\n              mode: 'index',\n              intersect: false,\n              padding: 12,\n              cornerRadius: 8,\n              titleFont: { size: 14, family: 'Inter' },\n              bodyFont: { size: 13, family: 'Inter' },\n              callbacks: {\n                label: function(context) {\n                  return context.dataset.label + ': Rank ' + context.raw;\n                }\n              }\n            },\n            legend: {\n              position: 'right',\n              labels: {\n                color: textColor,\n                font: { family: 'Inter', size: 14, weight: 500 },\n                usePointStyle: true,\n                padding: 20,\n                filter: function(item, chart) {\n                  return chart.datasets[item.datasetIndex].showInLegend;\n                }\n              }\n            }\n          },\n          scales: {\n            y: {\n              reverse: true,\n              min: 1,\n              max: 15,\n              ticks: {\n                stepSize: 1,\n                color: textColor,\n                font: { family: 'Inter', size: 14 }\n              },\n              grid: { color: gridColor },\n              title: { \n                display: true, \n                text: 'GDP Rank (1 = Highest)', \n                color: textMuted, \n                font: { family: 'Inter', size: 14, weight: 600 },\n                padding: { bottom: 16 }\n              },\n              border: { display: false }\n            },\n            x: {\n              ticks: { \n                color: textColor, \n                font: { family: 'Inter', size: 14, weight: 600 }\n              },\n              grid: { display: false },\n              border: { color: gridColor }\n            }\n          }\n        }\n      });\n    }\n\n    document.addEventListener('DOMContentLoaded', buildCharts);\n  </script>\n</body>\n</html>\n",
