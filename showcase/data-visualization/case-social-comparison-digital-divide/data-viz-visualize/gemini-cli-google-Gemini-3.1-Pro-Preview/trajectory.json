background: var(--text-secondary); opacity: 0.6; }\n\n    /* Grid layout */\n    .chart-container {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n    }\n    \n    .chart-grid {\n      display: grid;\n      grid-template-columns: 200px 100px 1fr 1fr 1fr;\n      gap: 32px;\n      align-items: center;\n    }\n    \n    .grid-header {\n      font-size: 13px;\n      font-weight: 600;\n      color: var(--text-secondary);\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      border-bottom: 2px solid var(--border);\n      padding-bottom: 16px;\n      margin-bottom: 16px;\n    }\n    \n    .grid-header.center { text-align: center; }\n\n    .region-row {\n      display: contents;\n    }\n    \n    .region-name {\n      font-weight: 700;\n      font-size: 18px;\n      color: var(--text);\n      padding-right: 16px;\n    }\n    \n    .overall-stat {\n      font-size: 24px;\n      font-weight: 700;\n      color: var(--text);\n      text-align: center;\n    }\n    \n    .overall-label {\n      font-size: 12px;\n      color: var(--text-secondary);\n      text-align: center;\n      display: block;\n      margin-top: -4px;\n    }\n\n    .row-divider {\n      grid-column: 1 / -1;\n      height: 1px;\n      background: var(--border);\n      margin: 16px 0;\n    }\n\n    /* Dumbbell Chart Elements */\n    .dumbbell-track {\n      position: relative;\n      height: 48px;\n      width: 100%;\n      display: flex;\n      align-items: center;\n    }\n    \n    .dumbbell-bg {\n      position: absolute;\n      left: 0; right: 0;\n      height: 2px;\n      background: var(--border);\n    }\n    \n    .dumbbell-bg-ticks {\n      position: absolute;\n      left: 0; right: 0; top: 0; bottom: 0;\n      pointer-events: none;\n    }\n    .tick {\n      position: absolute;\n      width: 1px; height: 6px;\n      background: var(--border);\n      top: 21px;\n    }\n    .tick-label {\n      position: absolute;\n      top: 30px;\n      transform: translateX(-50%