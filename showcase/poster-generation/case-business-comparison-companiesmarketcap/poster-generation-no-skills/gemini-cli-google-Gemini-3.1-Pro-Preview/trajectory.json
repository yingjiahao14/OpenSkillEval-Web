            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>The World's Most Valuable Companies in 2025</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700;900&family=Space+Grotesk:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n    :root {\n        --bg-color: #0B101E; /* deep navy/charcoal */\n        --surface-color: #151C2D;\n        --accent-blue: #00E5FF; /* electric blue */\n        --accent-gold: #FFB300;\n        --accent-white: #FFFFFF;\n        --text-muted: #8F99B2;\n        --font-main: 'Inter', sans-serif;\n        --font-mono: 'Space Grotesk', sans-serif;\n    }\n\n    * {\n        box-sizing: border-box;\n        margin: 0;\n        padding: 0;\n    }\n\n    body {\n        background-color: var(--bg-color);\n        color: var(--accent-white);\n        font-family: var(--font-main);\n        width: 1200px;\n        height: 1600px;\n        padding: 60px 80px;\n        position: relative;\n        overflow: hidden;\n    }\n\n    /* Grid Layout */\n    .grid {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        grid-template-rows: auto auto 1fr auto;\n        gap: 40px;\n        height: 100%;\n    }\n\n    /* HEADER */\n    .header {\n        grid-column: 1 / -1;\n        border-bottom: 2px solid rgba(255, 255, 255, 0.1);\n        padding-bottom: 30px;\n    }\n    \n    .header h1 {\n        font-family: var(--font-mono);\n        font-size: 56px;\n        font-weight: 700;\n        text-transform: uppercase;\n        letter-spacing: -1px;\n        margin-bottom: 15px;\n        line-height: 1.1;\n    }\n\n    .header p {\n        font-size: 22px;\n        color: var(--text-muted);\n        max-width: 900px;\n        line-height: 1.5;\n        font-weight: 300;\n    }\n\n    /* HEADLINE STAT */\n    .headline-stat {\n        grid-column: 1 / -1;\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        background: linear-gradient(135deg, rgba(0, 229, 255, 0.1) 0%, rgba(0, 0, 0, 0) 100%);\n        border-left: 6px solid var(--accent-blue);\n        padding: 40px 50px;\n        border-radius: 8px;\n        margin-bottom: 20px;\n    }\n\n    .headline-stat .number {\n        font-family: var(--font-mono);\n        font-size: 140px;\n        font-weight: 700;\n        color: var(--accent-blue);\n        line-height: 1;\n        text-shadow: 0 0 30px rgba(0, 229, 255, 0.3);\n    }\n    .headline-stat .number span {\n        font-size: 60px;\n    }\n\n    .headline-stat .text {\n        text-align: right;\n    }\n\n    .headline-stat .text h2 {\n        font-size: 42px;\n        font-weight: 700;\n        margin-bottom: 10px;\n        text-transform: uppercase;\n    }\n\n    .headline-stat .text p {\n        font-size: 24px;\n        color: var(--text-muted);\n    }\n\n    /* TRILLION DOLLAR CLUB */\n    .centerpiece {\n        grid-column: 1 / -1;\n        background: var(--surface-color);\n        border-radius: 12px;\n        padding: 40px;\n        display: flex;\n        flex-direction: column;\n    }\n\n    .section-title {\n        font-family: var(--font-mono);\n        font-size: 28px;\n        text-transform: uppercase;\n        color: var(--accent-white);\n        margin-bottom: 30px;\n        display: flex;\n        align-items: center;\n        gap: 15px;\n    }\n\n    .section-title::before {\n        content: '';\n        display: inline-block;\n        width: 12px;\n        height: 12px;\n        background-color: var(--accent-gold);\n    }\n\n    .bar-chart {\n        display: flex;\n        flex-direction: column;\n        gap: 15px;\n    }\n\n    .bar-row {\n        display: flex;\n        align-items: center;\n        gap: 20px;\n    }\n\n    .bar-label {\n        width: 160px;\n        font-weight: 600;\n        font-size: 20px;\n        text-align: right;\n    }\n    \n    .bar-ticker {\n        color: var(--text-muted);\n        font-size: 14px;\n        margin-left: 5px;\n    }\n\n    .bar-container {\n        flex-grow: 1;\n        height: 32px;\n        background-color: rgba(255, 255, 255, 0.05);\n        border-radius: 4px;\n        position: relative;\n    }\n\n    .bar {\n        height: 100%;\n        border-radius: 4px;\n        display: flex;\n        align-items: center;\n        justify-content: flex-end;\n        padding-right: 15px;\n        font-family: var(--font-mono);\n        font-weight: 700;\n        font-size: 16px;\n    }\n\n    .bar.top5 {\n        background: linear-gradient(90deg, #005A66 0%, var(--accent-blue) 100%);\n    }\n\n    .bar.rest {\n        background: linear-gradient(90deg, #3A4150 0%, #5E6982 100%);\n    }\n\n    .gap-indicator {\n        margin: 15px 0 15px 180px;\n        border-top: 1px dashed rgba(255, 255, 255, 0.3);\n        padding-top: 10px;\n        color: var(--accent-gold);\n        font-size: 14px;\n        font-weight: 600;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n    }\n\n    /* LOWER SECTION */\n    .lower-section {\n        grid-column: 1 / -1;\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 40px;\n    }\n\n    .card {\n        background: var(--surface-color);\n        padding: 40px;\n        border-radius: 12px;\n    }\n\n    /* COUNTRY DOMINANCE */\n    .country-stats {\n        display: flex;\n        flex-direction: column;\n        gap: 20px;\n    }\n\n    .us-dominance {\n        display: flex;\n        align-items: baseline;\n        gap: 15px;\n    }\n    .us-dominance .big-num {\n        font-family: var(--font-mono);\n        font-size: 80px;\n        font-weight: 700;\n        color: var(--accent-gold);\n    }\n    .us-dominance .desc {\n        font-size: 22px;\n        color: var(--accent-white);\n        line-height: 1.3;\n    }\n\n    .dots-grid {\n        display: grid;\n        grid-template-columns: repeat(10, 1fr);\n        gap: 10px;\n        margin-top: 20px;\n    }\n\n    .dot {\n        aspect-ratio: 1;\n        border-radius: 50%;\n    }\n    .dot.us {\n        background-color: var(--accent-gold);\n        box-shadow: 0 0 10px rgba(255, 179, 0, 0.4);\n    }\n    .dot.other {\n        background-color: rgba(255, 255, 255, 0.2);\n    }\n\n    .country-list {\n        margin-top: 25px;\n        display: flex;\n        flex-wrap: wrap;\n        gap: 12px;\n    }\n\n    .country-tag {\n        background: rgba(255, 255, 255, 0.05);\n        padding: 8px 16px;\n        border-radius: 20px;\n        font-size: 14px;\n        color: var(--text-muted);\n        border: 1px solid rgba(255, 255, 255, 0.1);\n    }\n\n    /* SCALE IN CONTEXT */\n    .context-stats {\n        display: flex;\n        flex-direction: column;\n        gap: 30px;\n        height: 100%;\n        justify-content: center;\n    }\n    .stat-row {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n        padding-bottom: 20px;\n    }\n    .stat-row:last-child {\n        border-bottom: none;\n        padding-bottom: 0;\n    }\n\n    .stat-label {\n        font-size: 20px;\n        color: var(--text-muted);\n        max-width: 250px;\n        line-height: 1.4;\n    }\n    .stat-value {\n        font-family: var(--font-mono);\n        font-size: 48px;\n        font-weight: 700;\n        color: var(--accent-white);\n    }\n    .stat-value.highlight {\n        color: var(--accent-blue);\n    }\n\n    /* BACKGROUND ELEMENTS */\n    .bg-circle {\n        position: absolute;\n        border-radius: 50%;\n        filter: blur(100px);\n        z-index: -1;\n    }\n    .bg-circle-1 {\n        top: -100px;\n        right: -100px;\n        width: 600px;\n        height: 600px;\n        background: rgba(0, 229, 255, 0.05);\n    }\n    .bg-circle-2 {\n        bottom: -200px;\n        left: -100px;\n        width: 800px;\n        height: 800px;\n        background: rgba(255, 179, 0, 0.03);\n    }\n\n    /* SECTOR NOTE */\n    .sector-note {\n        grid-column: 1 / -1;\n        text-align: center;\n        margin-top: 20px;\n        font-size: 16px;\n        color: var(--text-muted);\n        border-top: 1px solid rgba(255,255,255,0.1);\n        padding-top: 30px;\n        line-height: 1.6;\n    }\n</style>\n</head>\n<body>\n    <div class=\"bg-circle bg-circle-1\"></div>\n    <div class=\"bg-circle bg-circle-2\"></div>\n\n    <div class=\"grid\">\n        <div class=\"header\">\n            <h1>The World's Most Valuable Companies in 2025</h1>\n            <p>A comparative snapshot of the top 20 publicly traded companies by market capitalization, revealing the dominance of U.S. tech giants and the immense concentration of global wealth.</p>\n        </div>\n\n        <div class=\"headline-stat\">\n            <div class=\"number\">$4.82<span>T</span></div>\n            <div class=\"text\">\n                <h2>NVIDIA</h2>\n                <p>The World's Most Valuable Company</p>\n            </div>\n        </div>\n\n        <div class=\"centerpiece\">\n            <div class=\"section-title\">The Trillion-Dollar Club</div>\n            <div class=\"bar-chart\">\n                <div class=\"bar-row\">\n                    <div class=\"bar-label\">NVIDIA <span class=\"bar-ticker\">NVDA</span></div>\n                    <div class=\"bar-container\"><div class=\"bar top5\" style=\"width: 100%;\">$4.82T</div></div>\n                </div>\n                <div class=\"bar-row\">\n                    <div class=\"bar-label\">Alphabet <span class=\"bar-ticker\">GOOG</span></div>\n                    <div class=\"bar-container\"><div class=\"bar top5\" style=\"width: 83.5%;\">$4.03T</div></div>\n                </div>\n                <div class=\"bar-row\">\n                    <div class=\"bar-label\">Apple <span class=\"bar-ticker\">AAPL</span></div>\n                    <div class=\"bar-container\"><div class=\"bar top5\" style=\"width: 80.3%;\">$3.87T</div></div>\n                </div>\n                <div class=\"bar-row\">\n                    <div class=\"bar-label\">Microsoft <span class=\"bar-ticker\">MSFT</span></div>\n                    <div class=\"bar-container\"><div class=\"bar top5\" style=\"width: 64.8%;\">$3.12T</div></div>\n                </div>\n                <div class=\"bar-row\">\n                    <div class=\"bar-label\">Amazon <span class=\"bar-ticker\">AMZN</span></div>\n                    <div class=\"bar-container\"><div class=\"bar top5\" style=\"width: 55.7%;\">$2.69T</div></div>\n                </div>\n                \n                <div class=\"gap-indicator\">▲ Top 5 hold over $18.5T — ~13% of all tracked public value ▼</div>\n\n                <div class=\"bar-row\">\n                    <div class=\"bar-label\">Broadcom <span class=\"bar-ticker\">AVGO</span></div>\n                    <div class=\"bar-container\"><div class=\"bar rest\" style=\"width: 39.2%;\">$1.89T</div></div>\n                </div>\n                <div class=\"bar-row\">\n                    <div class=\"bar-label\">TSMC <span class=\"bar-ticker\">TSM</span></div>\n                    <div class=\"bar-container\"><div class=\"bar rest\" style=\"width: 39.1%;\">$1.88T</div></div>\n                </div>\n                <div class=\"bar-row\">\n                    <div class=\"bar-label\">Saudi Aramco <span class=\"bar-ticker\">2222.SR</span></div>\n                    <div class=\"bar-container\"><div class=\"bar rest\" style=\"width: 36.8%;\">$1.77T</div></div>\n                </div>\n                <div class=\"bar-row\">\n                    <div class=\"bar-label\">Meta <span class=\"bar-ticker\">META</span></div>\n                    <div class=\"bar-container\">