\n    }\n\n    .column {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      gap: 40px;\n    }\n\n    .chart-box {\n      background: rgba(30, 41, 59, 0.6);\n      border-radius: 20px;\n      padding: 30px;\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .chart-container {\n      flex: 1;\n      width: 100%;\n      height: 100%;\n      min-height: 280px;\n    }\n\n  </style>\n</head>\n<body>\n  <div class=\"poster-container\">\n    <div class=\"header\">\n      <h1>The State of Global Education</h1>\n      <p>A comparative look at how far the world has come in expanding education access — and the critical gaps that remain in quality, attendance, and equity.</p>\n    </div>\n\n    <div class=\"hero-stat\">\n      <div class=\"hero-label\">Children Still Out of School</div>\n      <div class=\"hero-value\">244 MILLION</div>\n      <div id=\"chart-out-of-school\" class=\"hero-chart\"></div>\n    </div>\n\n    <div class=\"main-stats\">\n      <div class=\"column\">\n        <div class=\"chart-box\">\n          <div id=\"chart-history\" class=\"chart-container\"></div>\n        </div>\n        <div class=\"chart-box\">\n          <div id=\"chart-learning\" class=\"chart-container\"></div>\n        </div>\n      </div>\n      <div class=\"column\">\n        <div class=\"chart-box\">\n          <div id=\"chart-quality\" class=\"chart-container\"></div>\n        </div>\n        <div class=\"chart-box\">\n          <div id=\"chart-gender\" class=\"chart-container\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script src=\"/app/vendor/infographic.min.js\"></script>\n  <script>\n    function renderChart(id, syntax) {\n      const infographic = new AntVInfographic.Infographic({\n        container: '#' + id,\n        theme: 'dark'\n      });\n      document.fonts?.ready.then(() => {\n        infographic.render(syntax);\n      }).catch((error) => {\n        infographic.render(syntax);\n      });\n    