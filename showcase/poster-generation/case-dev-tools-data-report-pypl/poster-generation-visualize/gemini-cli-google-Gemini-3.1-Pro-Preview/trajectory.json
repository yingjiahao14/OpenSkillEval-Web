            "content": "<!DOCTYPE html>\n<html lang=\"en\" class=\"theme-dark\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>PYPL Programming Language Popularity Index — April 2026</title>\n  <link href=\"/app/libs/fonts/inter.css\" rel=\"stylesheet\">\n  <script src=\"/app/libs/html-to-image.js\"></script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n    :root { interpolate-size: allow-keywords; }\n\n    /* ===== THEMES ===== */\n    html.theme-dark {\n      --bg: #090B10; --surface: #121621; --surface-hover: #1A1F2E;\n      --border: rgba(255,255,255,0.06);\n      --text: #F3F4F6; --text-secondary: #9CA3AF;\n      --accent: #3B82F6; --accent-secondary: #8B5CF6;\n      --positive: #10B981; --negative: #F43F5E; --warning: #F59E0B;\n      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n    }\n    html.theme-light {\n      --bg: #FAFAF9; --surface: #FFFFFF; --surface-hover: #F5F5F4;\n      --border: rgba(0,0,0,0.06);\n      --text: #0F172A; --text-secondary: #64748B;\n      --accent: #2563EB; --accent-secondary: #7C3AED;\n      --positive: #059669; --negative: #E11D48; --warning: #D97706;\n      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n    }\n\n    body {\n      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n      background: var(--bg); color: var(--text);\n      line-height: 1.6; -webkit-font-smoothing: antialiased;\n      letter-spacing: -0.01em; \n      \n      /* FIXED DIMENSIONS FOR POSTER */\n      width: 1080px; height: 1920px;\n      overflow: hidden;\n      display: flex; flex-direction: column;\n    }\n\n    h1, h2, h3, h4 { \n      color: var(--text); \n      letter-spacing: -0.03em; \n      line-height: 1.1;\n      text-wrap: balance;\n    }\n    h1 { font-weight: 800; font-size: 64px; margin-bottom: 24px; }\n    h2 { font-weight: 700; font-size: 36px; margin-bottom: 32px; border-bottom: 2px solid var(--border); padding-bottom: 16px; }\n    h3 { font-weight: 600; font-size: 24px; margin-bottom: 16px; }\n    \n    .text-secondary { color: var(--text-secondary); }\n    .mono { font-family: var(--font-mono); }\n    .positive { color: var(--positive); }\n    .negative { color: var(--negative); }\n\n    /* ===== POSTER LAYOUT ===== */\n    .poster-container {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      padding: 64px;\n      gap: 48px;\n    }\n\n    .poster-header {\n      display: flex;\n      flex-direction: column;\n    }\n    \n    .subtitle {\n      font-family: var(--font-mono);\n      color: var(--accent);\n      font-size: 18px;\n      font-weight: 600;\n      letter-spacing: 0.1em;\n      text-transform: uppercase;\n      margin-bottom: 16px;\n    }\n\n    .one-liner {\n      font-size: 24px;\n      color: var(--text-secondary);\n      max-width: 800px;\n      line-height: 1.4;\n    }\n\n    /* ===== HERO STATS ===== */\n    .hero-stats {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 32px;\n    }\n\n    .stat-card {\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-top: 4px solid var(--accent);\n      border-radius: 12px;\n      padding: 32px;\n      display: flex;\n      flex-direction: column;\n      position: relative;\n    }\n    .stat-card.stat-python { border-top-color: var(--accent); }\n    .stat-card.stat-cpp { border-top-color: var(--positive); }\n    .stat-card.stat-java { border-top-color: var(--negative); }\n\n    .stat-label {\n      font-size: 20px;\n      font-weight: 600;\n      color: var(--text-secondary);\n      margin-bottom: 8px;\n    }\n    .stat-value {\n      font-size: 64px;\n      font-weight: 800;\n      font-family: var(--font-mono);\n      letter-spacing: -0.05em;\n      margin-bottom: 12px;\n      display: flex;\n      align-items: baseline;\n      gap: 16px;\n    }\n    .stat-trend {\n      font-size: 24px;\n      font-weight: 600;\n      padding: 6px 12px;\n      border-radius: 8px;\n      background: rgba(16, 185, 129, 0.1);\n    }\n    .stat-trend.down {\n      background: rgba(244, 63, 94, 0.1);\n      color: var(--negative);\n    }\n    .stat-context {\n      font-size: 18px;\n      color: var(--text-secondary);\n    }\n\n    /* ===== MAIN CONTENT GRID ===== */\n    .poster-body {\n      display: grid;\n      grid-template-columns: 1.5fr 1fr;\n      gap: 48px;\n      flex: 1;\n    }\n\n    /* ===== RANKINGS TABLE ===== */\n    .rankings-table {\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n    \n    .ranking-row {\n      display: grid;\n      grid-template-columns: 40px 180px 1fr 100px 100px;\n      align-items: center;\n      gap: 16px;\n      padding: 16px 20px;\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      font-size: 20px;\n    }\n    .ranking-row.header {\n      background: transparent;\n      border: none;\n      font-size: 16px;\n      font-weight: 600;\n      color: var(--text-secondary);\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      padding: 0 20px 8px;\n    }\n    \n    .rank-num { font-family: var(--font-mono); font-weight: 700; color: var(--text-secondary); }\n    .lang-name { font-weight: 700; }\n    \n    .share-bar-container {\n      width: 100%;\n      height: 8px;\n      background: rgba(255,255,255,0.05);\n      border-radius: 4px;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n    }\n    .share-bar {\n      height: 100%;\n      background: var(--accent);\n      border-radius: 4px;\n    }\n    .lang-share { font-family: var(--font-mono); font-weight: 600; text-align: right; }\n    .lang-trend { font-family: var(--font-mono); font-weight: 600; text-align: right; }\n\n    /* ===== SIDE COLUMN ===== */\n    .side-column {\n      display: flex;\n      flex-direction: column;\n      gap: 40px;\n    }\n\n    .trend-box {\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 12px;\n      padding: 32px;\n    }\n    \n    .trend-item {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 16px 0;\n      border-bottom: 1px solid var(--border);\n    }\n    .trend-item:last-child { border-bottom: none; padding-bottom: 0; }\n    .trend-item:first-child { padding-top: 0; }\n    \n    .trend-lang { font-size: 20px; font-weight: 600; }\n    .trend-val { font-size: 24px; font-family: var(--font-mono); font-weight: 700; }\n\n    .methodology-box {\n      margin-top: auto;\n      padding: 24px;\n      background: rgba(255,255,255,0.02);\n      border-radius: 8px;\n      border: 1px dashed var(--border);\n    }\n    .methodology-box h3 { font-size: 18px; color: var(--text-secondary); margin-bottom: 8px; }\n    .methodology-box p { font-size: 16px; color: var(--text-secondary); line-height: 1.5; }\n\n    .poster-footer {\n      padding: 0 64px 40px;\n      font-size: 16px;\n      color: var(--text-secondary);\n      font-family: var(--font-mono);\n      display: flex;\n      justify-content: space-between;\n      border-top: 1px solid var(--border);\n      padding-top: 24px;\n      margin: 0 64px;\n    }\n\n    /* ===== ANIMATIONS ===== */\n    @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }\n    .animate { animation: fadeInUp 0.8s ease-out both; }\n    .delay-1 { animation-delay: 0.1s; }\n    .delay-2 { animation-delay: 0.2s; }\n    .delay-3 { animation-delay: 0.3s; }\n    .delay-4 { animation-delay: 0.4s; }\n\n    /* ===== MENU ===== */\n    .viz-menu { position: fixed; top: 16px; right: 16px; z-index: 9999; }\n    .viz-menu-toggle {\n      width: 44px; height: 44px; border-radius: 12px;\n      background: var(--surface); border: 1px solid var(--border);\n      color: var(--text); cursor: pointer; display: flex;\n      align-items: center; justify-content: center;\n      backdrop-filter: blur(12px); transition: all 0.2s;\n    }\n    .viz-menu-toggle:hover { background: var(--surface-hover); }\n    .viz-menu-dropdown {\n      position: absolute; top: 52px; right: 0; min-width: 200px;\n      background: var(--surface); border: 1px solid var(--border);\n      border-radius: 12px; padding: 8px;\n      opacity: 0; visibility: hidden; transform: translateY(-8px);\n      transition: all 0.2s; backdrop-filter: blur(16px);\n    }\n    .viz-menu-dropdown.open { opacity: 1; visibility: visible; transform: translateY(0); }\n    .viz-menu-dropdown button {\n      width: 100%; padding: 10px 14px; border: none; border-radius: 8px;\n      background: transparent; color: var(--text); font-size: 14px;\n      font-family: inherit; cursor: pointer; text-align: left;\n      display: flex; align-items: center; gap: 10px; transition: background 0.15s;\n    }\n    .viz-menu-dropdown button:hover { background: var(--surface-hover); }\n\n  </style>\n</head>\n<body>\n  \n  <div class=\"viz-menu\">\n    <button class=\"viz-menu-toggle\" onclick=\"toggleMenu()\" aria-label=\"Menu\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\">\n        <line x1=\"3\" y1=\"5\" x2=\"17\" y2=\"5\"/><line x1=\"3\" y1=\"10\" x2=\"17\" y2=\"10\"/><line x1=\"3\" y1=\"15\" x2=\"17\" y2=\"15\"/>\n      </svg>\n    </button>\n    <div class=\"viz-menu-dropdown\" id=\"vizMenuDropdown\">\n      <button onclick=\"cycleTheme()\"><span id=\"themeIcon\">☀️</span><span id=\"themeLabel\">Light</span></button>\n      <button onclick=\"downloadImage()\"><span>📥</span><span>Download PNG</span></button>\n      <button onclick=\"window.print()\"><span>🖨️</span><span>Print / PDF</span></button>\n    </div>\n  </div>\n\n  <main clas