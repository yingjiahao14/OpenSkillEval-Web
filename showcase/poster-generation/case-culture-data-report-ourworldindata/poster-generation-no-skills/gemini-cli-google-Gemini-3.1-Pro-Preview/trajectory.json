            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Poster</title>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Lato:wght@300;400;700&display=swap');\n\n        body {\n            margin: 0;\n            padding: 0;\n            width: 2384px;\n            height: 3370px;\n            background-color: #f4ecd8; /* Deep parchment tone */\n            background-image: url('data:image/svg+xml;utf8,<svg width=\"200\" height=\"200\" xmlns=\"http://www.w3.org/2000/svg\"><filter id=\"noise\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.8\" numOctaves=\"4\" stitchTiles=\"stitch\"/></filter><rect width=\"100%\" height=\"100%\" filter=\"url(%23noise)\" opacity=\"0.05\"/></svg>');\n            color: #3b2f2f; /* Aged-ink brown */\n            font-family: 'Lato', sans-serif;\n            position: relative;\n            box-sizing: border-box;\n            padding: 120px;\n            display: flex;\n            flex-direction: column;\n            overflow: hidden;\n        }\n\n        h1, h2, h3, h4 {\n            font-family: 'Playfair Display', serif;\n            margin: 0;\n            color: #2b1f1f;\n        }\n\n        .header {\n            text-align: center;\n            margin-bottom: 80px;\n            border-bottom: 4px solid #b33939; /* Deep red accent */\n            padding-bottom: 60px;\n        }\n\n        .header h1 {\n            font-size: 130px;\n            font-weight: 700;\n            line-height: 1.1;\n            margin-bottom: 30px;\n            text-transform: uppercase;\n            letter-spacing: 4px;\n        }\n\n        .header .subtitle {\n            font-size: 56px;\n            font-family: 'Playfair Display', serif;\n            font-style: italic;\n            color: #b33939;\n            margin-bottom: 40px;\n        }\n\n        .header .one-liner {\n            font-size: 40px;\n            font-weight: 300;\n            max-width: 1800px;\n            margin: 0 auto;\n            line-height: 1.5;\n        }\n\n        .main-content {\n            flex: 1;\n            display: flex;\n            flex-direction: column;\n            gap: 80px;\n        }\n\n        .section {\n            display: flex;\n            flex-direction: column;\n            gap: 30px;\n        }\n\n        .section-title {\n            font-size: 60px;\n            border-left: 12px solid #b33939;\n            padding-left: 30px;\n        }\n\n        .chart-container-large {\n            width: 100%;\n            height: 800px;\n            background: rgba(255, 255, 255, 0.4);\n            border-radius: 10px;\n            padding: 40px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.05);\n            box-sizing: border-box;\n            position: relative;\n        }\n\n        .annotation {\n            position: absolute;\n            background: rgba(179, 57, 57, 0.9);\n            color: white;\n            padding: 20px 30px;\n            border-radius: 8px;\n            font-size: 32px;\n            font-weight: 700;\n            box-shadow: 0 10px 20px rgba(0,0,0,0.2);\n            pointer-events: none;\n        }\n\n        .annotation::after {\n            content: '';\n            position: absolute;\n            bottom: -15px;\n            left: 50%;\n            transform: translateX(-50%);\n            border-width: 15px 15px 0;\n            border-style: solid;\n            border-color: rgba(179, 57, 57, 0.9) transparent transparent transparent;\n        }\n\n        .two-columns {\n            display: flex;\n            gap: 80px;\n        }\n\n        .column {\n            flex: 1;\n            display: flex;\n            flex-direction: column;\n            gap: 40px;\n        }\n\n        .text-box {\n            font-size: 36px;\n            line-height: 1.6;\n            background: rgba(255, 255, 255, 0.3);\n            padding: 50px;\n            border-radius: 10px;\n            border: 2px solid rgba(179, 57, 57, 0.2);\n        }\n\n        .chart-container-small {\n            width: 100%;\n            height: 500px;\n            background: rgba(255, 255, 255, 0.4);\n            border-radius: 10px;\n            padding: 30px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.05);\n            box-sizing: border-box;\n        }\n\n        .footer {\n            margin-top: auto;\n            border-top: 2px solid rgba(59, 47, 47, 0.2);\n            padding-top: 40px;\n            display: flex;\n            justify-content: space-between;\n            font-size: 28px;\n            font-weight: 300;\n        }\n\n        .metrics-grid {\n            display: grid;\n            grid-template-columns: repeat(3, 1fr);\n            gap: 30px;\n            margin-top: 40px;\n        }\n\n        .metric-card {\n            background: rgba(255, 255, 255, 0.5);\n            padding: 30px;\n            border-radius: 8px;\n            text-align: center;\n        }\n\n        .metric-value {\n            font-family: 'Playfair Display', serif;\n            font-size: 48px;\n            color: #b33939;\n            font-weight: 700;\n            margin-bottom: 10px;\n        }\n\n        .metric-label {\n            font-size: 26px;\n            color: #5a4b4b;\n        }\n        \n        .closing-narrative {\n            background: #b33939;\n            color: #f4ecd8;\n            padding: 60px;\n            border-radius: 15px;\n            text-align: center;\n            font-size: 42px;\n            font-weight: 300;\n            line-height: 1.5;\n            margin-top: 20px;\n        }\n        .closing-narrative strong {\n            font-weight: 700;\n            font-family: 'Playfair Display', serif;\n            font-size: 48px;\n        }\n    </style>\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n</head>\n<body>\n\n    <div class=\"header\">\n        <h1>The History of Books</h1>\n        <div class=\"subtitle\">From Manuscripts to Mass Production</div>\n        <div class=\"one-liner\">A data-driven look at how book production evolved from rare handwritten manuscripts to millions of printed titles over the past 1,500 years.</div>\n    </div>\n\n    <div class=\"main-content\">\n\n        <div class=\"section\">\n            <h2 class=\"section-title\">The Long Arc of Book Production (6th–21st Century)</h2>\n            <div class=\"chart-container-large\">\n                <canvas id=\"mainChart\"></canvas>\n                <div class=\"annotation\" style=\"top: 150px; left: 1050px;\">Gutenberg's Press (~1440)<br><span style=\"font-size:24px; font-weight:400;\">The inflection point that changed everything</span></div>\n            </div>\n            <p class=\"text-box\" style=\"margin-top: 0;\">For a millennium, manuscript production grew at a slow, painstaking crawl—luxury items for the elite. But around 1440, Johannes Gutenberg's printing press ignited an explosive surge in knowledge dissemination, permanently shattering the scarcity of written works and fundamentally reshaping human civilization.</p>\n        </div>\n\n        <div class=\"two-columns\">\n            <div class=\"column\">\n                <h2 class=\"section-title\">Modern Book Publishing</h2>\n                <p class=\"text-box\" style=\"padding-bottom:30px;\">Today, the legacy of the press continues. However, modern book production is highly uneven, reflecting disparities in global education, literacy, and wealth. New book titles per million people highlight these stark cultural and economic differences.</p>\n                <div class=\"chart-container-small\">\n                    <canvas id=\"barChart\"></canvas>\n                </div>\n            </div>\n\n            <div class=\"column\">\n                <h2 class=\"section-title\">Key Metrics</h2>\n                <div class=\"metrics-grid\">\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value\">~1440</div>\n                        <div class=\"metric-label\">Gutenberg's Press Invented</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value\">10 Centuries</div>\n                        <div class=\"metric-label\">of Manuscript Data Covered</div>\n                    </div>\n                    <div class=\"metric-card\">\n                        <div class=\"metric-value\">1500–2009</div>\n                        <div class=\"metric-label\">Printed Book Data Span</div>\n                    </div>\n                    <div class=\"metric-card\" style=\"grid-column: span 3;\">\n                        <div class=\"metric-value\">>49 pages</div>\n                        <div class=\"metric-label\">UNESCO Standard Definition of a Book</div>\n                    </div>\n                </div>\n\n                <div class=\"closing-narrative\">\n                    <strong>Books as a Mirror of Society</strong><br><br>\n                    Book production is more than just manufacturing—it serves as a powerful proxy for human development. High output correlates strongly with <b>literacy rates</b>, rising <b>income</b>, expansive <b>education systems</b>, and the rich evolution of culture.\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <div class=\"footer\">\n        <div><strong>Sources:</strong> Buringh & Van Zanden (2009); Fink-Jensen (2015); Roser & Ritchie (2023)</div>\n        <div>Produced for Data-Journalism / Historical Data Exhibition</div>\n    </div>\n\n    <script>\n        // Main Chart (Area Chart)\n        const ctxMain = document.getElementById('mainChart').getContext('2d');\n        \n        // Data approximation for visual effect\n        const labels = ['6th C', '9th C', '12th C', '14th C', '1400', '1440', '1500', '1600', '1700', '1800', '1900', '2000'];\n        const manuscriptData = [0.01, 0.05, 0.2, 1.0, 5.0, 6.0, null, null, null, null, null, null];\n        const printData = [null, null, null, null, null, 6.0, 50, 500, 2000, 10000, 200000, 1000000];\n\n        new Chart(ctxMain, {\n            type: 'line',\n            data: {\n                labels: labels,\n                datasets: [\n                    {\n                        label: 'Manuscript Production (Thousands)',\n                        data: manuscriptData,\n                        borderColor: '#5a4b4b',\n                        backgroundColor: 'rgba(90, 75, 75, 0.5)',\n                        fill: true,\n                        tension: 0.4,\n                        borderWidth: 4,\n                        pointRadius: 0\n                    },\n                    {\n                        label: 'Printed Books (Thousands)',\n                        data: printData,\n                        borderColor: '#b33939',\n                        backgroundColor: 'rgba(179, 57, 57, 0.5)',\n                        fill: true,\n                        tension: 0.4,\n                        borderWidth: 6,\n                        pointRadius: 0\n                    }\n                ]\n            },\n            options: {\n                responsive: true,\n                maintainAspectRatio: false,\n                scales: {\n                    y: {\n                        type: 'logarithmic',\n                        title: {\n                            display: true,\n                            text: 'Output (Log Scale)',\n                            font: { size: 28, family: 'Lato' },\n                            color: '#3b2f2f'\n                        },\n                        ticks: {\n                            font: { size: 24, family: 'Lato' },\n                            color: '#3b2f2f',\n                            callback: function(value, index, values) {\n                                if (value === 0.01 || value === 0.1 || value === 1 || value === 10 || value === 100 || value === 1000 || value === 10000 || value === 100000 || value === 1000000) {\n                                    return value.toLocaleString();\n                                }\n                                return null;\n                            }\n                        },\n                        grid: {\n                            color: 'rgba(59, 47, 47, 0.1)'\n                        }\n                    },\n                    x: {\n                        ticks: {\n                            font: { size: 28, family: 'Lato' },\n                            color: '#3b2f2f'\n                        },\n                        grid: {\n                            color: 'rgba(59, 47, 47, 0.1)'\n                        }\n                    }\n                },\n                plugins: {\n                    legend: {\n                        labels: {\n                            font: { size: 28, family: 'Lato' },\n                            color: '#3b2f2f'\n                        }\n                    },\n                    tooltip: { enabled: false }\n                },\n                animation: false\n            }\n        });\n\n        // Bar Chart (Modern Publishing)\n        const ctxBar = document.getElementById('barChart').getContext('2d');\n        new Chart(ctxBar, {\n            type: 'bar',\n            data: {\n                labels: ['UK', 'USA', 'France', 'China', 'India'],\n                datasets: [{\n                    label: 'New Titles per Million People',\n                    data: [2800, 1000, 1000, 300, 75],\n                    backgroundColor: [\n                        '#b33939',\n                        '#d2691e',\n                        '#d2691e',\n                        '#5a4b4b',\n                        '#5a4b4b'\n                    ],\n                    borderRadius: 5\n                }]\n            },\n            options: {\n                responsive: true,\n                maintainAspectRatio: false,\n                scales: {\n                    y: {\n                        title: {\n                            display: true,\n                            text: 'Titles per Million',\n                            font: { size: 24, family: 'Lato' },\n                            color: '#3b2f2f'\n                        },\n                        ticks: {\n                            font: { size: 20, family: 'Lato' },\n                            color: '#3b2f2f'\n                        },\n                        grid: { color: 'rgba(59, 47, 47, 0.1)' }\n                    },\n                    x: {\n                        ticks: {\n                            font: { size: 24, family: 'Lato' },\n                            color: '#3b2f2f'\n                        },\n                        grid: { display: false }\n                    }\n                },\n                plugins: {\n                    legend: { display: false },\n                    tooltip: { enabled: false }\n                },\n                animation: false\n            }\n        });\n    </script>\n</body>\n</html>\n",
