ine-height: 1.1; }\n    h1 { font-weight: 800; font-size: 64px; margin-bottom: 16px; background: linear-gradient(135deg, #60a5fa, #a78bfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n    h2 { font-weight: 700; font-size: 32px; margin-bottom: 24px; }\n    h3 { font-weight: 600; font-size: 24px; }\n    \n    .text-secondary { color: var(--text-secondary); }\n    .accent { color: var(--accent); }\n    \n    /* Layout */\n    .poster-header { padding: 64px 64px 32px; z-index: 1; }\n    .poster-subtitle { font-size: 24px; max-width: 900px; color: var(--text-secondary); }\n    \n    .poster-body { flex: 1; padding: 0 64px; display: flex; flex-direction: column; gap: 40px; z-index: 1; overflow: hidden; }\n    .poster-footer { padding: 32px 64px 48px; display: flex; justify-content: space-between; font-size: 18px; color: var(--text-secondary); z-index: 1; border-top: 1px solid var(--border); margin-top: auto; }\n\n    /* Cards */\n    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 32px; }\n    \n    /* Metrics Row */\n    .metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; flex-shrink: 0; }\n    .metric-card { display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden; }\n    .metric-value { font-size: 48px; font-weight: 800; margin-bottom: 8px; line-height: 1; }\n    .metric-label { font-size: 18px; color: var(--text-secondary); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }\n    .metric-card.primary { border-color: var(--accent); background: linear-gradient(180deg, var(--surface) 0%, rgba(59,130,246,0.05) 100%); }\n    .metric-card.primary .metric-value { color: var(--accent); }\n\n    /* Main Grid */\n    .main-grid { display: grid; grid-template-columns: 3fr 2fr; gap: 40px; flex: 1; min-height: 0; }\n    \n    /* Table Area */\n    .table-container { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; height: 100%; }\n    .table-header-area { padding: 24px 32px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; }\n    .repo-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 18px; }\n    .repo-table th { padding: 16px 32px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; font-size: 14px; letter-spacing: 0.05em; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--surface); z-index: 10; }\n    .repo-table td { padding: 14px 32px; border-bottom: 1px solid var(--border); }\n    .repo-table tr:last-child td { border-bottom: none; }\n    .repo-table tr.ai-row td { background: var(--ai-highlight); }\n    \n    .rank-badge { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 8px; background: rgba(255,255,255,0.1); font-weight: 700; font-size: 16px; }\n    html.theme-light .rank-badge { background: rgba(0,0,0,0.05); }\n    .rank-1 { background: #f59e0b !important; color: #fff; }\n    .rank-2 { background: #94a3b8 !important; color: #fff; }\n    .rank-3 { background: #b45309 !important; color: #fff; }\n    \n    .repo-name { font-weight: 600; font-family: monospace; font-size: 18px; }\n    .repo-author { color: var(--text-secondary); font-weight: 400; }\n    .lang-pill { display: inline-block; padding: 4px 12px; border-radius: 100px; font-size: 14px; font-weight: 500; border: 1px solid var(--border); background: var(--bg); }\n    \n    .stat-flex { display: flex; align-items: center; gap: 6px; }\n    .stat-icon { color: var(--text-secondary); }\n\n    /* Side Area */\n    .side-flex { display: flex; flex-direction: column; gap: 40px; height: 100%; overflow: hidden; }\n    .chart-box { flex: 1; min-height: 360px; display: flex; flex-direction: column; }\n    .chart-container { flex: 1; position: relative; min-height: 0; padding: 20px 0; }\n    \n    .themes-box { display: flex; flex-direction: column; gap: 20px; flex-shrink: 0; }\n    .theme-item { display: flex; gap: 16px; align-items: flex-start; padding: 20px; border-radius: 12px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); }\n    html.theme-light .theme-item { background: rgba(0,0,0,0.02); }\n    .theme-icon { width: 48px; height: 48px; border-radius: 12px; background: var(--accent); color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }\n    .theme-icon.green { background: var(--positive); }\n    .theme-icon.purple { background: var(--accent-secondary); }\n    .theme-content h4 { font-size: 20px; margin-bottom: 8px; color: var(--text); }\n    .theme-content p { font-size: 16px; color: var(--text-secondary); line-height: 1.5; }\n\n    /* Animations */\n    .animate { animation: fadeInUp 0.6s ease-out both; }\n    @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }\n    .delay-1 { animation-delay: 0.1s; } .delay-2 { animation-delay: 0.2s; } .delay-3 { animation-delay: 0.3s; }\n\n    /* Menu (hidden for poster export) */\n    .viz-menu { position: fixed; top: 24px; right: 24px; z-index: 9999; }\n    .viz-menu-toggle { width: 48px; height: 48px; border-radius: 12px; background: var(--surface); border: 1px solid var(--border); color: var(--text); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; }\n    .viz-menu-dropdown { position: absolute; top: 60px; right: 0; min-width: 220px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 8px; opacity: 0; visibility: hidden; transform: translateY(-8px); transition: 0.2s; }\n    .viz-menu-dropdown.open { opacity: 1; visibility: visible; transform: translateY(0); }\n    .viz-menu-dropdown button { width: 100%; padding: 12px 16px;