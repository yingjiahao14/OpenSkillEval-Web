ed(1) : Math.round(val);\n          el.textContent = prefix + valStr + suffix;\n          if (p < 1) requestAnimationFrame(tick);\n        }\n        requestAnimationFrame(tick);\n      });\n    }\n    var counterEl = document.querySelector('[data-count]');\n    if (counterEl) {\n      var cObs = new IntersectionObserver(function(entries) {\n        entries.forEach(function(e) { if (e.isIntersecting) { animateCounters(); cObs.disconnect(); } });\n      }, { threshold: 0.1 });\n      cObs.observe(counterEl);\n    }\n\n    // Chart.js Setup\n    var chartsBuilt = false;\n    \n    function resetCanvas(id) {\n      var old = document.getElementById(id);\n      if (!old) return null;\n      var parent = old.parentNode;\n      var canvas = document.createElement('canvas');\n      canvas.id = id;\n      parent.replaceChild(canvas, old);\n      return canvas;\n    }\n\n    function buildCharts() {\n      if (chartsBuilt || typeof Chart === 'undefined') return;\n      \n      var isDark = document.documentElement.classList.contains('theme-dark');\n      var textColor = isDark ? '#EDEDED' : '#0f172a';\n      \n      var ctx = resetCanvas('langChart');\n      if (ctx) {\n        window.langChart = new Chart(ctx, {\n          type: 'doughnut',\n          data: {\n            labels: ['Python', 'TypeScript', 'Rust', 'Others'],\n            datasets: [{\n              data: [35, 25, 10, 30],\n              backgroundColor: ['#3b82f6', '#8b5cf6', '#10b981', isDark ? '#374151' : '#cbd5e1'],\n              borderWidth: 0,\n              hoverOffset: 4\n            }]\n          },\n          options: {\n            responsive: true,\n            maintainAspectRatio: false,\n            animation: false,\n            plugins: {\n              tooltip: {\n                enabled: true,\n                padding: 12,\n                cornerRadius: 8,\n                callbacks: {\n                  label: function(context) { return ' ' + context.label + ': ' + context.raw + '%'; }\n                }\n              },\n              legend: {\n                position: 'bottom',\n                labels: { color: textColor, font: { family: 'Inter', size: 14 }, padding: 20 }\n              }\n            },\n            cutout: '65%',\n            layout: { padding: 10 }\n          }\n        });\n      }\n      \n      chartsBuilt = true;\n    }\n\n    function onThemeChange() {\n      chartsBuilt = false;\n      setTimeout(buildCharts, 50);\n    }\n    \n    document.addEventListener('DOMContentLoaded', buildCharts);\n  </script>\n</body>\n</html>",
