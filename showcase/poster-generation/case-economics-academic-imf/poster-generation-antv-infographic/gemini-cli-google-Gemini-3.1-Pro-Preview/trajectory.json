            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Poster</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');\n  body {\n    margin: 0;\n    padding: 0;\n    width: 2384px;  /* roughly A0 aspect ratio */\n    height: 3370px;\n    background-color: #f8fafc;\n    font-family: 'Inter', sans-serif;\n    color: #1e293b;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n  }\n  .poster-container {\n    padding: 100px;\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    box-sizing: border-box;\n  }\n  .header {\n    background-color: #002244;\n    color: #ffffff;\n    padding: 80px;\n    border-radius: 24px;\n    margin-bottom: 60px;\n  }\n  .header h1 {\n    font-size: 100px;\n    margin: 0 0 20px 0;\n    font-weight: 800;\n  }\n  .header h2 {\n    font-size: 50px;\n    margin: 0;\n    font-weight: 400;\n    color: #94a3b8;\n  }\n  .highlight-banner {\n    background-color: #f59e0b;\n    color: #ffffff;\n    padding: 40px;\n    border-radius: 16px;\n    font-size: 60px;\n    font-weight: 800;\n    text-align: center;\n    margin-bottom: 60px;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n  }\n  .content-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    grid-gap: 60px;\n    flex: 1;\n  }\n  .full-width {\n    grid-column: 1 / -1;\n  }\n  .card {\n    background: #ffffff;\n    border-radius: 24px;\n    box-shadow: 0 10px 30px rgba(0,0,0,0.05);\n    padding: 60px;\n    display: flex;\n    flex-direction: column;\n  }\n  .card-title {\n    font-size: 50px;\n    font-weight: 800;\n    color: #002244;\n    margin-bottom: 40px;\n    border-bottom: 4px solid #f59e0b;\n    padding-bottom: 20px;\n    display: inline-block;\n  }\n  .chart-container {\n    flex: 1;\n    min-height: 800px;\n    width: 100%;\n  }\n  .chart-container-small {\n    flex: 1;\n    min-height: 600px;\n    width: 100%;\n  }\n  .footer {\n    margin-top: 60px;\n    font-size: 30px;\n    color: #64748b;\n    text-align: center;\n  }\n</style>\n</head>\n<body>\n  <div class=\"poster-container\">\n    <div class=\"header\">\n      <h1>Global Economy in the Shadow of War</h1>\n      <h2>IMF World Economic Outlook Trends 2024–2026</h2>\n    </div>\n\n    <div class=\"highlight-banner\">\n      Risk Balance: Consistently Tilted to the Downside\n    </div>\n\n    <div class=\"content-grid\">\n      <!-- Growth Trajectory -->\n      <div class=\"card full-width\">\n        <div class=\"card-title\">A Narrow Band of Mediocrity: Global Growth Projections</div>\n        <div id=\"chart-growth\" class=\"chart-container\"></div>\n      </div>\n\n      <!-- Downside Risks -->\n      <div class=\"card\">\n        <div class=\"card-title\">Dominant Downside Risks</div>\n        <div id=\"chart-risks\" class=\"chart-container-small\"></div>\n      </div>\n\n      <!-- Policy Evolution -->\n      <div class=\"card\">\n        <div class=\"card-title\">Evolving Policy Priorities</div>\n        <div id=\"chart-policy\" class=\"chart-container-small\"></div>\n      </div>\n    </div>\n    \n    <div class=\"footer\">\n      Source: IMF World Economic Outlook (Jul 2024 - Apr 2026) | IMF-World Bank Annual Meetings Research Symposium\n    </div>\n  </div>\n\n  <script src=\"./vendor/infographic.min.js\"></script>\n  <script>\n    const syntaxGrowth = `infographic chart-line-plain-text\ndata\n  title Global Growth Forecasts (2024-2026)\n  desc Hovering between 3.0% and 3.3%, below the 3.8% pre-pandemic historical average.\n  values\n    - label Jul 24\n      value 3.2\n    - label Oct 24\n      value 3.2\n    - label Jan 25\n      value 3.3\n    - label Apr 25\n      value 3.15\n    - label Jul 25\n      value 3.0\n    - label Oct 25\n      value 3.1\n    - label Jan 26\n      value 3.3\n    - label Apr 26\n      value 3.15\ntheme\n  palette #002244 #f59e0b #6b7280\n  base\n    text\n      font-family Inter`;\n\n    const syntaxRisks = `infographic list-grid-badge-card\ndata\n  title Threat Matrix\n  desc Escalating pressures across the forecast horizon\n  lists\n    - label Trade Escalation\n      desc Tariffs & retaliatory measures\n      icon alert triangle\n    - label Geopolitics\n      desc Conflicts & broader security\n      icon shield\n    - label Tech Correction\n      desc Overvalued expectations in AI\n      icon desktop\n    - label Sticky Inflation\n      desc Persistent services inflation\n      icon chart arrow up\ntheme\n  palette #f59e0b #002244 #6b7280\n  base\n    text\n      font-family Inter`;\n\n    const syntaxPolicy = `infographic sequence-timeline-simple\ndata\n  title Policy Adaptation\n  desc From stabilization to structural defense\n  sequences\n    - label Mid-Late 2024\n      desc Disinflation & Monetary Pivot\n    - label Early-Mid 2025\n      desc Rebuild Buffers & Confidence\n    - label Late 2025-Early 2026\n      desc Agile Defense Trade-offs\ntheme\n  palette #002244 #6b7280 #f59e0b\n  base\n    text\n      font-family Inter`;\n\n    const infographicGrowth = new AntVInfographic.Infographic({ container: '#chart-growth', width: '100%', height: '100%' });\n    infographicGrowth.render(syntaxGrowth);\n\n    const infographicRisks = new AntVInfographic.Infographic({ container: '#chart-risks', width: '100%', height: '100%' });\n    infographicRisks.render(syntaxRisks);\n\n    const infographicPolicy = new AntVInfographic.Infographic({ container: '#chart-policy', width: '100%', height: '100%' });\n    infographicPolicy.render(syntaxPolicy);\n\n    document.fonts?.ready.then(() => {\n      infographicGrowth.render(syntaxGrowth);\n      infographicRisks.render(syntaxRisks);\n      infographicPolicy.render(syntaxPolicy);\n    });\n  </script>\n</body>\n</html>",
