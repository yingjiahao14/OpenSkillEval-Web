            "content": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Web Summit Lisbon 2026</title>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');\n    body, html {\n      margin: 0;\n      padding: 0;\n      width: 1000px;\n      height: 1400px;\n      background: #050510;\n      color: #ffffff;\n      font-family: 'Inter', sans-serif;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n    }\n    .hero {\n      padding: 60px 80px 40px;\n      background: radial-gradient(circle at top right, #1d0f2a 0%, #050510 60%);\n      position: relative;\n    }\n    .hero::before {\n      content: '';\n      position: absolute;\n      top: 0; left: 0; right: 0; bottom: 0;\n      background: url('data:image/svg+xml;utf8,<svg width=\"200\" height=\"200\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M100 0 L200 100 L100 200 L0 100 Z\" fill=\"none\" stroke=\"rgba(219,39,119,0.05)\" stroke-width=\"2\"/></svg>') repeat;\n      z-index: 0;\n      pointer-events: none;\n    }\n    .hero-content {\n      position: relative;\n      z-index: 1;\n    }\n    .dates {\n      font-size: 24px;\n      font-weight: 700;\n      color: #06b6d4;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      margin-bottom: 20px;\n    }\n    .title {\n      font-size: 80px;\n      font-weight: 900;\n      line-height: 1.1;\n      margin: 0 0 20px 0;\n      background: linear-gradient(135deg, #ffffff 0%, #a5b4fc 100%);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n    }\n    .subtitle {\n      font-size: 32px;\n      font-weight: 400;\n      color: #94a3b8;\n      margin: 0 0 50px 0;\n    }\n    .offer-box {\n      background: linear-gradient(135deg, #db2777 0%, #9333ea 100%);\n      border-radius: 24px;\n      padding: 40px;\n      box-shadow: 0 20px 40px rgba(219, 39, 119, 0.3);\n      text-align: center;\n      border: 2px solid rgba(255,2