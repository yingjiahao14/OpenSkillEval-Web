ht: 900;\n    color: var(--cyan);\n    letter-spacing: -2px;\n    line-height: 1;\n  }\n  .metric p {\n    margin: 10px 0 0 0;\n    font-size: 18px;\n    text-transform: uppercase;\n    color: var(--text-muted);\n    font-weight: 600;\n    letter-spacing: 2px;\n  }\n\n  /* Lower Section: Speakers & Testimonial */\n  .lower-section {\n    display: grid;\n    grid-template-columns: 1.2fr 0.8fr;\n    gap: 50px;\n    margin-top: 50px;\n  }\n  .section-title {\n    font-size: 20px;\n    color: var(--magenta);\n    text-transform: uppercase;\n    letter-spacing: 3px;\n    margin: 0 0 25px 0;\n    font-weight: 800;\n    display: flex;\n    align-items: center;\n  }\n  .section-title::before {\n    content: '';\n    display: inline-block;\n    width: 12px; height: 12px;\n    background: var(--magenta);\n    margin-right: 12px;\n  }\n  .speakers-list {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 15px;\n  }\n  .speaker {\n    background: rgba(255,255,255,0.03);\n    border: 1px solid rgba(255,255,255,0.15);\n    padding: 14px 22px;\n    font-size: 18px;\n    font-weight: 600;\n    color: #fff;\n    letter-spacing: 0.5px;\n    transition: all 0.3s ease;\n  }\n  .speaker-bold {\n    color: var(--cyan);\n    border-color: rgba(0,229,255,0.3);\n  }\n\n  .quote-box {\n    background: linear-gradient(135deg, rgba(0,229,255,0.08) 0%, rgba(0,0,0,0) 100%);\n    border-left: 4px solid var(--cyan);\n    padding: 30px;\n    position: relative;\n  }\n  .quote-icon {\n    font-size: 60px;\n    color: rgba(0,229,255,0.2);\n    position: absolute;\n    top: 10px; left: 15px;\n    font-family: serif;\n    line-height: 1;\n  }\n  .quote-text {\n    font-size: 26px;\n    font-weight: 600;\n    font-style: italic;\n    line-height: 1.4;\n    color: #fff;\n    margin: 0 0 20px 0;\n    position: relative;\n    z-index: 2;\n  }\n  .quote-author {\n    font-size: 16px;\n    color: var(--text-muted);\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n  }\n\n  /*