            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>DeployCloud Blog — Discover the latest in web development</title>\n<meta name=\"description\" content=\"A tech blog showcasing engineering insights, product updates, and community stories from a cloud deployment platform.\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n/* CSS Reset and Variables */\n:root {\n  --primary: #171717;\n  --accent: #0072F5;\n  --bg-light: #FAFAFA;\n  --text-primary: #171717;\n  --text-secondary: #666666;\n  --border: #EAEAEA;\n  --card-bg: #FFFFFF;\n  --radius-sm: 6px;\n  --radius-md: 12px;\n  --radius-lg: 16px;\n  --shadow-sm: 0 2px 8px rgba(0,0,0,0.04);\n  --shadow-md: 0 4px 16px rgba(0,0,0,0.08);\n  --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  --font-sans: 'Inter', system-ui, -apple-system, sans-serif;\n}\n\nbody {\n  font-family: var(--font-sans);\n  background-color: var(--bg-light);\n  color: var(--text-primary);\n  margin: 0;\n  line-height: 1.6;\n  -webkit-font-smoothing: antialiased;\n}\n\n* {\n  box-sizing: border-box;\n}\n\n/* Base Layout */\n.container {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 24px;\n}\n\n/* Header */\n.site-header {\n  background: rgba(255, 255, 255, 0.85);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border-bottom: 1px solid var(--border);\n  position: sticky;\n  top: 0;\n  z-index: 100;\n}\n\n.header-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 64px;\n}\n\n.logo {\n  font-weight: 700;\n  font-size: 1.25rem;\n  letter-spacing: -0.02em;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  text-decoration: none;\n  color: var(--primary);\n}\n\n.nav-links {\n  display: flex;\n  gap: 24px;\n  align-items: center;\n}\n\n.nav-item {\n  position: relative;\n  font-size: 0.875rem;\n  font-weight: 500;\n  color: var(--text-secondary);\n  cursor: pointer;\n  transition: var(--transition);\n  text-decoration: none;\n  padding: 8px 0;\n}\n\n.nav-item:hover, .nav-item:focus-within {\n  color: var(--primary);\n}\n\n.dropdown-menu {\n  position: absolute;\n  top: 100%;\n  left: 50%;\n  transform: translateX(-50%) translateY(10px);\n  background: var(--card-bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-md);\n  padding: 32px;\n  opacity: 0;\n  visibility: hidden;\n  transition: var(--transition);\n  display: flex;\n  gap: 48px;\n  pointer-events: none;\n  white-space: nowrap;\n}\n\n.nav-item.dropdown:hover .dropdown-menu,\n.nav-item.dropdown:focus-within .dropdown-menu {\n  opacity: 1;\n  visibility: visible;\n  transform: translateX(-50%) translateY(0);\n  pointer-events: auto;\n}\n\n.dropdown-col-title {\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: var(--text-secondary);\n  margin-bottom: 16px;\n  font-weight: 600;\n}\n\n.dropdown-links {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.dropdown-link {\n  font-size: 0.875rem;\n  color: var(--primary);\n  text-decoration: none;\n  font-weight: 500;\n  display: flex;\n  flex-direction: column;\n  transition: var(--transition);\n}\n\n.dropdown-link span {\n  font-size: 0.75rem;\n  color: var(--text-secondary);\n  font-weight: 400;\n  margin-top: 2px;\n}\n\n.dropdown-link:hover {\n  color: var(--accent);\n}\n\n.header-actions {\n  display: flex;\n  gap: 16px;\n  align-items: center;\n}\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 8px 16px;\n  font-size: 0.875rem;\n  font-weight: 500;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  transition: var(--transition);\n  text-decoration: none;\n}\n\n.btn-outline {\n  border: 1px solid var(--border);\n  background: transparent;\n  color: var(--primary);\n}\n\n.btn-outline:hover {\n  border-color: var(--text-secondary);\n  background: var(--card-bg);\n}\n\n.btn-primary {\n  background: var(--primary);\n  color: #fff;\n  border: 1px solid var(--primary);\n}\n\n.btn-primary:hover {\n  background: #333;\n  border-color: #333;\n}\n\n/* Page Header */\n.page-header {\n  padding: 80px 0 60px;\n  text-align: center;\n}\n\n.page-title {\n  font-size: 3rem;\n  font-weight: 700;\n  letter-spacing: -0.03em;\n  margin-bottom: 16px;\n  line-height: 1.1;\n  color: var(--primary);\n}\n\n.page-subtitle {\n  font-size: 1.25rem;\n  color: var(--text-secondary);\n  max-width: 600px;\n  margin: 0 auto;\n}\n\n/* Filters & Search */\n.filters-section {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 48px;\n  flex-wrap: wrap;\n  gap: 24px;\n}\n\n.categories {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.category-pill {\n  padding: 6px 14px;\n  border-radius: 999px;\n  font-size: 0.875rem;\n  font-weight: 500;\n  color: var(--text-secondary);\n  background: transparent;\n  border: 1px solid transparent;\n  cursor: pointer;\n  transition: var(--transition);\n  font-family: inherit;\n}\n\n.category-pill:hover, .category-pill:focus {\n  color: var(--primary);\n  background: var(--border);\n  outline: none;\n}\n\n.category-pill.active {\n  background: var(--primary);\n  color: #fff;\n}\n\n.search-box {\n  position: relative;\n  width: 100%;\n  max-width: 320px;\n}\n\n.search-input {\n  width: 100%;\n  padding: 10px 16px 10px 40px;\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border);\n  background: var(--card-bg);\n  font-size: 0.875rem;\n  font-family: var(--font-sans);\n  color: var(--primary);\n  outline: none;\n  transition: var(--transition);\n}\n\n.search-input:focus {\n  border-color: var(--accent);\n  box-shadow: 0 0 0 3px rgba(0, 114, 245, 0.1);\n}\n\n.search-icon {\n  position: absolute;\n  left: 14px;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 16px;\n  height: 16px;\n  color: var(--text-secondary);\n  pointer-events: none;\n}\n\n/* Featured Section */\n.featured-section {\n  margin-bottom: 80px;\n  display: grid;\n  grid-template-columns: 3fr 2fr;\n  grid-template-rows: auto auto;\n  gap: 24px;\n}\n\n.featured-card {\n  background: var(--card-bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: 40px;\n  display: flex;\n  flex-direction: column;\n  transition: var(--transition);\n  text-decoration: none;\n  color: var(--primary);\n}\n\n.featured-card:hover, .featured-card:focus {\n  box-shadow: var(--shadow-md);\n  transform: translateY(-2px);\n  outline: none;\n}\n\n.featured-card.main {\n  grid-column: 1 / 2;\n  grid-row: 1 / 3;\n}\n\n.featured-card.sub {\n  padding: 32px;\n}\n\n.card-meta {\n  font-size: 0.875rem;\n  color: var(--text-secondary);\n  margin-bottom: 16px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.card-category {\n  color: var(--accent);\n  font-weight: 600;\n}\n\n.featured-title {\n  font-size: 2.25rem;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  margin-bottom: 16px;\n  line-height: 1.2;\n}\n\n.sub .featured-title {\n  font-size: 1.5rem;\n}\n\n.card-excerpt {\n  font-size: 1.125rem;\n  color: var(--text-secondary);\n  margin-bottom: 32px;\n  flex-grow: 1;\n}\n\n.sub .card-excerpt {\n  font-size: 1rem;\n  margin-bottom: 24px;\n}\n\n.card-author {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-top: auto;\n}\n\n.author-avatar {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background: var(--bg-light);\n  border: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n  font-size: 0.75rem;\n  color: var(--primary);\n}\n\n.author-name {\n  font-size: 0.875rem;\n  font-weight: 500;\n}\n\n.agentic-stats {\n  background: var(--bg-light);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  padding: 24px;\n  margin: 16px 0 32px 0;\n}\n\n.stat-title {\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: var(--text-secondary);\n  font-weight: 600;\n  margin-bottom: 16px;\n}\n\n.stat-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.stat-list li {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  font-size: 0.875rem;\n  color: var(--primary);\n  font-weight: 500;\n}\n\n.stat-icon {\n  color: var(--accent);\n  margin-top: 2px;\n  flex-shrink: 0;\n}\n\n/* Latest News Grid */\n.section-title {\n  font-size: 1.75rem;\n  font-weight: 700;\n  margin-bottom: 32px;\n  letter-spacing: -0.02em;\n}\n\n.posts-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px;\n  margin-bottom: 48px;\n}\n\n.post-card {\n  background: var(--card-bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  padding: 24px;\n  display: flex;\n  flex-direction: column;\n  transition: var(--transition);\n  text-decoration: none;\n  color: var(--primary);\n  height: 100%;\n}\n\n.post-card:hover, .post-card:focus {\n  box-shadow: var(--shadow-md);\n  border-color: #ddd;\n  outline: none;\n}\n\n.post-title {\n  font-size: 1.25rem;\n  font-weight: 600;\n  letter-spacing: -0.01em;\n  margin-bottom: 12px;\n  line-height: 1.4;\n}\n\n.post-excerpt {\n  font-size: 0.875rem;\n  color: var(--text-secondary);\n  margin-bottom: 24px;\n  flex-grow: 1;\n}\n\n.no-results {\n  grid-column: 1 / -1;\n  text-align: center;\n  padding: 64px 0;\n  color: var(--text-secondary);\n  font-size: 1rem;\n  display: none;\n  background: var(--card-bg);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n}\n\n.load-more-container {\n  text-align: center;\n  margin-bottom: 80px;\n}\n\n/* CTA Banner */\n.cta-banner {\n  background: var(--primary);\n  border-radius: var(--radius-lg);\n  padding: 80px 40px;\n  text-align: center;\n  color: #fff;\n  margin-bottom: 80px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.cta-headline {\n  font-size: 2.5rem;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  margin-bottom: 32px;\n  max-width: 600px;\n  line-height: 1.2;\n}\n\n.cta-actions {\n  display: flex;\n  gap: 16px;\n  margin-bottom: 48px;\n}\n\n.btn-cta-primary {\n  background: #fff;\n  color: var(--primary);\n  padding: 14px 28px;\n  font-size: 1rem;\n  font-weight: 600;\n  border-radius: var(--radius-sm);\n  text-decoration: none;\n  transition: var(--transition);\n}\n\n.btn-cta-primary:hover {\n  background: #f0f0f0;\n}\n\n.btn-cta-outline {\n  background: transparent;\n  color: #fff;\n  border: 1px solid rgba(255,255,255,0.3);\n  padding: 14px 28px;\n  font-size: 1rem;\n  font-weight: 600;\n  border-radius: var(--radius-sm);\n  text-decoration: none;\n  transition: var(--transition);\n}\n\n.btn-cta-outline:hover {\n  border-color: #fff;\n}\n\n.enterprise-block {\n  background: rgba(255,255,255,0.05);\n  border: 1px solid rgba(255,255,255,0.1);\n  border-radius: var(--radius-md);\n  padding: 32px;\n  max-width: 600px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 24px;\n}\n\n.enterprise-text {\n  font-size: 0.875rem;\n  color: rgba(255,255,255,0.8);\n  line-height: 1.6;\n}\n\n/* Footer */\n.site-footer {\n  border-top: 1px solid var(--border);\n  padding: 80px 0 40px;\n  background: var(--card-bg);\n}\n\n.footer-grid {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  gap: 32px;\n  margin-bottom: 80px;\n}\n\n.footer-col-title {\n  font-size: 0.875rem;\n  font-weight: 600;\n  margin-bottom: 24px;\n  color: var(--primary);\n}\n\n.footer-links {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.footer-links a {\n  text-decoration: none;\n  color: var(--text-secondary);\n  font-size: 0.875rem;\n  transition: var(--transition);\n}\n\n.footer-links a:hover {\n  color: var(--accent);\n}\n\n.footer-bottom {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding-top: 32px;\n  border-top: 1px solid var(--border);\n  font-size: 0.875rem;\n  color: var(--text-secondary);\n}\n\n.status-indicator {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--primary);\n  font-weight: 500;\n  text-decoration: none;\n  transition: var(--transition);\n}\n\n.status-indicator:hover {\n  color: var(--accent);\n}\n\n.status-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: #00C853;\n  box-shadow: 0 0 0 2px rgba(0, 200, 83, 0.2);\n}\n\n/* Responsive Breakpoints */\n@media (max-width: 1024px) {\n  .posts-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .featured-section {\n    grid-template-columns: 1fr;\n  }\n  .featured-card.main {\n    grid-column: 1 / -1;\n    grid-row: 1 / 2;\n  }\n  .footer-grid {\n    grid-template-columns: repeat(3, 1fr);\n    gap: 48px;\n  }\n  .nav-links {\n    gap: 16px;\n  }\n}\n\n@media (max-width: 768px) {\n  .nav-links, .header-actions .nav-item {\n    display: none;\n  }\n  .page-title {\n    font-size: 2.25rem;\n  }\n  .posts-grid {\n    grid-template-columns: 1fr;\n  }\n  .filters-section {\n    flex-direction: column;\n    align-items: stretch;\n  }\n  .search-box {\n    max-width: 100%;\n  }\n  .featured-card {\n    padding: 24px;\n  }\n  .footer-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .cta-headline {\n    font-size: 2rem;\n  }\n  .cta-actions {\n    flex-direction: column;\n    width: 100%;\n  }\n  .btn-cta-primary, .btn-cta-outline {\n    width: 100%;\n    text-align: center;\n  }\n  .footer-bottom {\n    flex-direction: column;\n    gap: 24px;\n    align-items: flex-start;\n  }\n}\n</style>\n</head>\n<body>\n\n<header class=\"site-header\">\n  <div class=\"container header-inner\">\n    <a hre