            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>WellSource — Expert health guidance you can trust</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      --primary: #02838D;\n      --primary-dark: #016b73;\n      --dark: #231F20;\n      --white: #FFFFFF;\n      --bg-light: #F9F9F7;\n      --gray-light: #E5E7EB;\n      --gray-medium: #9CA3AF;\n      --gray-dark: #4B5563;\n      --accent: #E07A5F;\n      --accent-hover: #D0694E;\n    }\n    \n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    \n    body {\n      font-family: 'Inter', sans-serif;\n      color: var(--dark);\n      background-color: var(--white);\n      line-height: 1.5;\n      overflow-x: hidden;\n    }\n\n    a { text-decoration: none; color: inherit; transition: color 0.2s; }\n    ul { list-style: none; }\n\n    .container {\n      max-width: 1200px;\n      margin: 0 auto;\n      padding: 0 20px;\n    }\n\n    h1, h2, h3, h4, h5 { font-weight: 700; line-height: 1.2; margin-bottom: 0.5em; color: var(--dark); }\n    h1 { font-size: 2.5rem; }\n    h2 { font-size: 2rem; }\n    h3 { font-size: 1.5rem; }\n    p { margin-bottom: 1rem; color: var(--gray-dark); }\n    \n    .btn {\n      display: inline-block;\n      padding: 10px 20px;\n      border-radius: 6px;\n      font-weight: 600;\n      cursor: pointer;\n      transition: all 0.2s;\n      border: none;\n      text-align: center;\n    }\n    .btn-primary { background-color: var(--accent); color: var(--white); }\n    .btn-primary:hover { background-color: var(--accent-hover); }\n    .btn-outline { border: 1px solid var(--primary); color: var(--primary); background: transparent; }\n    .btn-outline:hover { background-color: var(--primary); color: var(--white); }\n    .btn-dark { background-color: var(--dark); color: var(--white); }\n    .btn-dark:hover { background-color: #000; }\n\n    /* Ticker */\n    .ticker-wrap {\n      background-color: var(--dark);\n      color: var(--white);\n      overflow: hidden;\n      height: 40px;\n      display: flex;\n      align-items: center;\n      font-size: 0.875rem;\n      font-weight: 500;\n      white-space: nowrap;\n    }\n    .ticker {\n      display: inline-flex;\n      animation: ticker 25s linear infinite;\n    }\n    .ticker__item { padding: 0 2rem; display: flex; align-items: center; }\n    .ticker__item::before { content: \"•\"; margin-right: 2rem; color: var(--primary); font-size: 1.2rem; }\n    .ticker__item:first-child::before { display: none; }\n    @keyframes ticker {\n      0% { transform: translateX(0); }\n      100% { transform: translateX(-50%); }\n    }\n\n    /* Header Nav */\n    header {\n      border-bottom: 1px solid var(--gray-light);\n      position: sticky;\n      top: 0;\n      background: var(--white);\n      z-index: 100;\n    }\n    .nav-container { display: flex; justify-content: space-between; align-items: center; height: 80px; position: relative; }\n    .logo { font-size: 1.75rem; font-weight: 800; color: var(--primary); letter-spacing: -0.5px; }\n    .main-nav { display: flex; height: 100%; }\n    .nav-item { height: 100%; display: flex; align-items: center; padding: 0 1rem; font-weight: 600; cursor: pointer; }\n    .nav-item:hover { color: var(--primary); }\n    \n    /* Mega Menu */\n    .mega-menu {\n      position: absolute;\n      top: 100%;\n      left: 0;\n      width: 100%;\n      background: var(--white);\n      border-top: 1px solid var(--gray-light);\n      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);\n      visibility: hidden;\n      opacity: 0;\n      transition: all 0.2s;\n      padding: 2rem 0;\n      z-index: 99;\n    }\n    .nav-item:hover .mega-menu { visibility: visible; opacity: 1; }\n    .mega-menu-content {\n      max-width: 1200px;\n      margin: 0 auto;\n      padding: 0 20px;\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 2rem;\n    }\n    .mega-menu h4 {\n      margin-bottom: 1rem;\n      color: var(--dark);\n      border-bottom: 2px solid var(--primary);\n      display: inline-block;\n      padding-bottom: 0.25rem;\n      font-size: 1.1rem;\n    }\n    .mega-menu ul li { margin-bottom: 0.75rem; }\n    .mega-menu ul li a { color: var(--gray-dark); font-weight: 400; font-size: 0.95rem; }\n    .mega-menu ul li a:hover { color: var(--primary); }\n    \n    .sec-actions { display: flex; align-items: center; gap: 1.5rem; }\n    .subscribe { color: var(--primary); font-weight: 600; }\n    .sign-in { font-weight: 500; color: var(--gray-dark); }\n    .sign-in:hover { color: var(--primary); }\n    \n    /* Hero & Trending */\n    .hero-trending { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin: 3rem auto; }\n    .hero-card {\n      position: relative;\n      border-radius: 12px;\n      overflow: hidden;\n      min-height: 450px;\n      display: flex;\n      flex-direction: column;\n      justify-content: flex-end;\n      padding: 3rem 2.5rem;\n      color: var(--white);\n      background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 100%), url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"800\" height=\"600\"><rect width=\"800\" height=\"600\" fill=\"%2302838D\"/><circle cx=\"400\" cy=\"300\" r=\"200\" fill=\"%23E07A5F\" opacity=\"0.8\"/></svg>') center/cover;\n    }\n    .hero-card .category {\n      background: var(--accent);\n      color: var(--white);\n      padding: 0.35rem 0.85rem;\n      border-radius: 4px;\n      font-size: 0.875rem;\n      font-weight: 700;\n      text-transform: uppercase;\n      align-self: flex-start;\n      margin-bottom: 1.5rem;\n      letter-spacing: 0.5px;\n    }\n    .hero-card h2 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--white); }\n    .hero-card p { color: #F3F4F6; font-size: 1.125rem; max-width: 600px; margin: 0; }\n    \n    .trending-list { background: var(--bg-light); padding: 2rem; border-radius: 12px; }\n    .trending-list h3 { font-size: 1.25rem; margin-bottom: 1.5rem; border-bottom: 2px solid var(--primary); display: inline-block; padding-bottom: 0.25rem; }\n    .trending-item { display: flex; flex-direction: column; margin-bottom: 1.25rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--gray-light); }\n    .trending-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }\n    .trending-item .cat { font-size: 0.75rem; font-weight: 700; color: var(--primary); text-transform: uppercase; margin-bottom: 0.35rem; letter-spacing: 0.5px; }\n    .trending-item a { font-weight: 600; font-size: 1.05rem; color: var(--dark); line-height: 1.4; }\n    .trending-item a:hover { color: var(--primary); }\n    \n    /* Newsletter Banner */\n    .newsletter-banner { background-color: var(--primary); color: var(--white); padding: 4rem 20px; text-align: center; margin: 4rem 0; }\n    .newsletter-banner h2 { color: var(--white); margin-bottom: 1rem; }\n    .newsletter-banner p { color: rgba(255,255,255,0.9); font-size: 1.1rem; max-width: 600px; margin: 0 auto 2rem; }\n    .newsletter-form { display: flex; justify-content: center; gap: 0.5rem; max-width: 500px; margin: 0 auto; }\n    .newsletter-form input { flex: 1; padding: 14px 16px; border: none; border-radius: 6px; font-size: 1rem; outline: none; }\n    .newsletter-privacy { font-size: 0.8rem; color: rgba(255,255,255,0.7); margin-top: 1rem; }\n    \n    /* Section Headers */\n    .section-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; }\n    .section-title { font-size: 1.75rem; margin: 0; }\n    .view-all { color: var(--primary); font-weight: 600; display: flex; align-items: center; gap: 0.25rem; }\n    .view-all:hover { text-decoration: underline; }\n    \n    /* Health Topics Carousel */\n    .carousel-container { position: relative; margin-bottom: 4rem; }\n    .carousel { display: flex; gap: 2.5rem; overflow-x: auto; scroll-behavior: smooth; padding: 1rem 0 2rem; scrollbar-width: none; }\n    .carousel::-webkit-scrollbar { display: none; }\n    .topic-card { display: flex; flex-direction: column; align-items: center; min-width: 140px; cursor: pointer; text-align: center; }\n    .topic-img { width: 140px; height: 140px; border-radius: 50%; margin-bottom: 1rem; transition: transform 0.3s ease; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }\n    .topic-card:hover .topic-img { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }\n    .topic-card span { font-weight: 600; color: var(--dark); font-size: 1.05rem; }\n    .carousel-btn { position: absolute; top: 70px; transform: translateY(-50%); background: var(--white); border: 1px solid var(--gray-light); border-radius: 50%; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.1); z-index: 10; font-size: 1.25rem; color: var(--dark); transition: all 0.2s; }\n    .carousel-btn:hover { background: var(--primary); color: var(--white); border-color: var(--primary); }\n    .carousel-btn.left { left: -22px; }\n    .carousel-btn.right { right: -22px; }\n\n    /* Topic Gradients */\n    .bg-grad-1 { background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); }\n    .bg-grad-2 { background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); }\n    .bg-grad-3 { background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); }\n    .bg-grad-4 { background: linear-gradient(135deg, #cfd9df 0%, #e2ebf0 100%); }\n    .bg-grad-5 { background: linear-gradient(135deg, #fbc2eb 0%, #a6c1ee 100%); }\n    .bg-grad-6 { background: linear-gradient(135deg, #fdcbf1 0%, #e6dee9 100%); }\n\n    /* Tools Section */\n    .tools-section { background-color: var(--bg-light); padding: 5rem 0; margin-bottom: 5rem; }\n    .tools-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }\n    .tools-column { background: var(--white); padding: 3rem; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }\n    .tools-column h3 { font-size: 1.75rem; color: var(--primary); margin-bottom: 1rem; }\n    .tools-column > p { font-size: 1.05rem; margin-bottom: 2rem; min-height: 48px; }\n    .tool-list { margin-top: 2rem; display: flex; flex-direction: column; gap: 1.5rem; }\n    .tool-item h4 { font-size: 1.15rem; margin-bottom: 0.35rem; }\n    .tool-item p { font-size: 0.95rem; margin-bottom: 0.5rem; color: var(--gray-dark); }\n    .tool-item a { color: var(--accent); font-weight: 600; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 0.25rem; }\n    .tool-item a:hover { color: var(--accent-hover); text-decoration: underline; }\n    \n    /* Recommended Reads */\n    .recommended-section { margin-bottom: 5rem; }\n    .tabs { display: flex; gap: 2rem; margin-bottom: 2.5rem; border-bottom: 1px solid var(--gray-light); overflow-x: auto; scrollbar-width: none; }\n    .tabs::-webkit-scrollbar { display: none; }\n    .tab-btn { background: none; border: none; padding: 12px 0; font-size: 1.05rem; font-weight: 600; color: var(--gray-medium); cursor: pointer; border-bottom: 3px solid transparent; white-space: nowrap; transition: all 0.2s; }\n    .tab-btn:hover { color: var(--dark); }\n    .tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }\n    \n    .articles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem; }\n    .article-card { display: none; flex-direction: column; cursor: pointer; }\n    .article-card:hover h4 { color: var(--primary); }\n    .article-card.active { display: flex; animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n    .article-img { background: var(--bg-light) linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%); height: 180px; border-radius: 8px; margin-bottom: 1rem; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05); }\n    .article-img.img-2 { background: linear-gradient(135deg, #f6d365 0%, #fda085 100%); }\n    .article-img.img-3 { background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%); }\n    .article-img.img-4 { background: linear-gradient(135deg, #fccb90 0%, #d57eeb 100%); }\n    .article-img.img-5 { background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%); }\n    .article-img.img-6 { background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); }\n    .article-card h4 { font-size: 1.15rem; margin-bottom: 0.5rem; line-height: 1.4; transition: color 0.2s; }\n    \n    /* Trust Pillars */\n    .trust-section { text-align: center; padding: 5rem 0; border-top: 1px solid var(--gray-light); border-bottom: 1px solid var(--gray-light); margin-bottom: 5rem; background-color: var(--bg-light); }\n    .trust-section h2 { margin-bottom: 3rem; }\n    .trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2.5rem; }\n    .trust-pillar { display: flex; flex-direction: column; align-items: center; }\n    .trust-icon { width: 70px; height: 70px; background: var(--white); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; box-shadow: 0 4px 10px rgba(0,0,0,0.05); font-size: 2rem; }\n    .trust-pillar h4 { font-size: 1.15rem; margin-bottom: 0.75rem; }\n    .trust-pillar p { font-size: 0.95rem; line-height: 1.6; }\n    \n    /* Featured Programs & Videos */\n    .cards-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 5rem; }\n    .program-card { background: var(--bg-light); border-radius: 8px; overflow: hidden; display: block; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 2px 5px rgba(0,0,0,0.02); }\n    .program-card:hover { transform: translateY