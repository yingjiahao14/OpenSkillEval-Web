            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ScreenVault — UI & UX design inspiration</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      --primary: #141414;\n      --bg: #FFFFFF;\n      --surface: #F5F5F5;\n      --surface-hover: #E5E5E5;\n      --accent: #4F46E5;\n      --accent-hover: #4338CA;\n      --text: #141414;\n      --text-muted: #52525B;\n      --border: #E4E4E7;\n      \n      --radius-sm: 8px;\n      --radius-md: 12px;\n      --radius-lg: 24px;\n      --radius-pill: 9999px;\n      \n      --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);\n      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);\n      --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);\n      --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);\n      \n      --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: 'Inter', sans-serif;\n      color: var(--text);\n      background-color: var(--bg);\n      line-height: 1.5;\n      -webkit-font-smoothing: antialiased;\n      overflow-x: hidden;\n    }\n\n    a {\n      text-decoration: none;\n      color: inherit;\n      transition: color var(--transition);\n    }\n\n    ul {\n      list-style: none;\n    }\n\n    /* Typography */\n    h1, h2, h3, h4, h5 {\n      font-weight: 700;\n      line-height: 1.1;\n      letter-spacing: -0.02em;\n      color: var(--text);\n    }\n    \n    h1 { font-size: clamp(2.5rem, 5vw, 4.5rem); }\n    h2 { font-size: clamp(2rem, 4vw, 3rem); }\n    h3 { font-size: 1.5rem; }\n    h4 { font-size: 1.125rem; font-weight: 600; }\n\n    p {\n      color: var(--text-muted);\n      font-size: 1.125rem;\n    }\n    p.large {\n      font-size: 1.25rem;\n    }\n\n    /* Layout */\n    .container {\n      max-width: 1240px;\n      margin: 0 auto;\n      padding: 0 24px;\n    }\n    \n    section {\n      padding: 96px 0;\n    }\n    @media (max-width: 768px) {\n      section {\n        padding: 64px 0;\n      }\n    }\n\n    .text-center { text-align: center; }\n    .bg-surface { background-color: var(--surface); }\n    .mt-4 { margin-top: 2rem; }\n    .mt-5 { margin-top: 3rem; }\n    .hidden { display: none !important; }\n\n    /* Buttons */\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      padding: 12px 24px;\n      border-radius: var(--radius-pill);\n      font-weight: 500;\n      font-size: 1rem;\n      transition: all 0.2s ease;\n      cursor: pointer;\n      border: none;\n      text-align: center;\n    }\n\n    .btn-primary {\n      background-color: var(--accent);\n      color: white;\n    }\n    .btn-primary:hover {\n      background-color: var(--accent-hover);\n      transform: translateY(-1px);\n      box-shadow: var(--shadow-md);\n    }\n\n    .btn-secondary {\n      background-color: white;\n      color: var(--text);\n      border: 1px solid var(--border);\n    }\n    .btn-secondary:hover {\n      background-color: var(--surface);\n    }\n\n    .btn-lg {\n      padding: 16px 32px;\n      font-size: 1.125rem;\n    }\n\n    /* Announcement Bar */\n    .announcement-bar {\n      background-color: var(--primary);\n      color: white;\n      text-align: center;\n      padding: 10px 24px;\n      font-size: 0.875rem;\n      font-weight: 500;\n    }\n    .announcement-bar a {\n      color: rgba(255,255,255,0.8);\n      text-decoration: underline;\n      margin-left: 8px;\n    }\n    .announcement-bar a:hover {\n      color: white;\n    }\n\n    /* Navbar */\n    .navbar {\n      border-bottom: 1px solid var(--border);\n      background-color: rgba(255, 255, 255, 0.9);\n      backdrop-filter: blur(8px);\n      position: sticky;\n      top: 0;\n      z-index: 100;\n    }\n    .navbar-container {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      height: 72px;\n    }\n    .logo {\n      font-weight: 800;\n      font-size: 1.25rem;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n    .nav-links {\n      display: flex;\n      gap: 32px;\n    }\n    .nav-links a {\n      font-weight: 500;\n      color: var(--text-muted);\n    }\n    .nav-links a:hover {\n      color: var(--text);\n    }\n    .nav-actions {\n      display: flex;\n      align-items: center;\n      gap: 24px;\n    }\n    .nav-actions .nav-link {\n      font-weight: 500;\n      color: var(--text-muted);\n    }\n    .nav-actions .nav-link:hover {\n      color: var(--text);\n    }\n    @media (max-width: 768px) {\n      .nav-links { display: none; }\n      .nav-actions .nav-link { display: none; }\n    }\n\n    /* Hero */\n    .hero {\n      padding-top: 120px;\n      padding-bottom: 64px;\n    }\n    .hero h1 {\n      max-width: 800px;\n      margin: 0 auto;\n      margin-bottom: 24px;\n    }\n    .hero .subtitle {\n      max-width: 600px;\n      margin: 0 auto;\n      margin-bottom: 40px;\n    }\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 16px;\n      margin-bottom: 80px;\n    }\n    @media (max-width: 480px) {\n      .hero-actions {\n        flex-direction: column;\n      }\n      .hero-actions .btn {\n        width: 100%;\n      }\n    }\n    \n    .hero-visual {\n      position: relative;\n      max-width: 1000px;\n      margin: 0 auto;\n      height: 400px;\n      background: linear-gradient(180deg, var(--surface) 0%, rgba(245, 245, 245, 0) 100%);\n      border-radius: var(--radius-lg) var(--radius-lg) 0 0;\n      border: 1px solid var(--border);\n      border-bottom: none;\n      overflow: hidden;\n      display: flex;\n      justify-content: center;\n      align-items: flex-end;\n    }\n    .mockup-stack {\n      display: flex;\n      gap: 24px;\n      transform: translateY(20%);\n    }\n    .mock-screen {\n      width: 240px;\n      height: 480px;\n      background: white;\n      border-radius: 32px;\n      box-shadow: var(--shadow-xl);\n      border: 8px solid var(--primary);\n      position: relative;\n      overflow: hidden;\n    }\n    .mock-screen::before {\n      content: '';\n      position: absolute;\n      top: 0; left: 50%;\n      transform: translateX(-50%);\n      width: 120px; height: 24px;\n      background: var(--primary);\n      border-radius: 0 0 16px 16px;\n    }\n    .mock-screen.center {\n      transform: translateY(-40px);\n      z-index: 2;\n    }\n    @media (max-width: 768px) {\n      .mockup-stack .mock-screen:not(.center) { display: none; }\n    }\n\n    /* Trusted By */\n    .trusted-by {\n      padding: 48px 0;\n      border-bottom: 1px solid var(--border);\n    }\n    .trusted-label {\n      font-size: 0.875rem;\n      text-transform: uppercase;\n      letter-spacing: 0.1em;\n      font-weight: 600;\n      margin-bottom: 32px;\n    }\n    .brand-row {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      align-items: center;\n      gap: 48px;\n      opacity: 0.6;\n    }\n    .brand-logo {\n      font-weight: 700;\n      font-size: 1.5rem;\n      color: var(--primary);\n    }\n\n    /* Stats */\n    .stats {\n      background-color: var(--primary);\n      color: white;\n    }\n    .stats .container {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n    }\n    .stats-intro {\n      margin-bottom: 64px;\n      text-align: center;\n    }\n    .stats-intro h2 { color: white; }\n    .stats-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 48px;\n      width: 100%;\n      text-align: center;\n    }\n    .stat-card h2 {\n      font-size: clamp(3rem, 6vw, 5rem);\n      color: white;\n      margin-bottom: 8px;\n    }\n    .stat-card p {\n      color: rgba(255, 255, 255, 0.7);\n      text-transform: uppercase;\n      letter-spacing: 0.1em;\n      font-weight: 600;\n    }\n    @media (max-width: 768px) {\n      .stats-grid { grid-template-columns: 1fr; gap: 40px; }\n    }\n\n    /* Feature: Search */\n    .section-header {\n      max-width: 600px;\n      margin: 0 auto 64px;\n    }\n    .search-interface {\n      display: flex;\n      flex-direction: column;\n      gap: 32px;\n    }\n    .tabs {\n      display: flex;\n      justify-content: center;\n      gap: 8px;\n      flex-wrap: wrap;\n      background: white;\n      padding: 8px;\n      border-radius: var(--radius-pill);\n      box-shadow: var(--shadow-sm);\n      width: fit-content;\n      margin: 0 auto;\n    }\n    .tab {\n      padding: 10px 20px;\n      border-radius: var(--radius-pill);\n      border: none;\n      background: transparent;\n      font-weight: 500;\n      font-size: 0.9375rem;\n      color: var(--text-muted);\n      cursor: pointer;\n      transition: all var(--transition);\n      font-family: inherit;\n    }\n    .tab:hover {\n      color: var(--text);\n      background: var(--surface);\n    }\n    .tab.active {\n      background: var(--primary);\n      color: white;\n    }\n\n    .pills-wrapper {\n      width: 100vw;\n      margin-left: calc(-50vw + 50%);\n      overflow-x: auto;\n      scrollbar-width: none;\n      -ms-overflow-style: none;\n      padding: 8px 24px;\n    }\n    .pills-wrapper::-webkit-scrollbar {\n      display: none;\n    }\n    .pills {\n      display: flex;\n      gap: 12px;\n      width: max-content;\n      margin: 0 auto;\n    }\n    .pill {\n      padding: 8px 16px;\n      border: 1px solid var(--border);\n      border-radius: var(--radius-pill);\n      background: white;\n      font-weight: 500;\n      font-size: 0.875rem;\n      color: var(--text);\n      cursor: pointer;\n      transition: all var(--transition);\n      font-family: inherit;\n    }\n    .pill:hover {\n      border-color: var(--text-muted);\n    }\n    .pill.active {\n      border-color: var(--accent);\n      background: rgba(79, 70, 229, 0.05);\n      color: var(--accent);\n    }\n\n    .search-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\n      gap: 24px;\n      transition: opacity var(--transition), transform var(--transition);\n    }\n    .mock-card {\n      background: white;\n      border-radius: var(--radius-md);\n      box-shadow: var(--shadow-sm);\n      border: 1px solid var(--border);\n      aspect-ratio: 9/16;\n      position: relative;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      transition: transform 0.2s ease, box-shadow 0.2s ease;\n    }\n    .mock-card:hover {\n      transform: translateY(-4px);\n      box-shadow: var(--shadow-md);\n    }\n    .mock-card::before {\n      content: '';\n      display: block;\n      height: 40px;\n      background: var(--surface);\n      border-bottom: 1px solid var(--border);\n    }\n    .mock-card::after {\n      content: '';\n      display: block;\n      flex: 1;\n      background: repeating-linear-gradient(180deg, transparent, transparent 12px, var(--surface) 12px, var(--surface) 24px) center top / 80% 80% no-repeat;\n      margin: 20px;\n      opacity: 0.5;\n    }\n\n    /* Feature: Flows */\n    .feature-flows {\n      overflow: hidden;\n    }\n    .flows-content {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 64px;\n      align-items: center;\n    }\n    .flows-toggle-container {\n      margin: 32px 0;\n    }\n    .flows-toggle {\n      display: inline-flex;\n      background: var(--surface);\n      border-radius: var(--radius-pill);\n      padding: 6px;\n    }\n    .toggle-btn {\n      padding: 10px 24px;\n      border-radius: var(--radius-pill);\n      border: none;\n      background: transparent;\n      font-weight: 500;\n      color: var(--text-muted);\n      cursor: pointer;\n      transition: all var(--transition);\n      font-family: inherit;\n    }\n    .toggle-btn.active {\n      background: white;\n      color: var(--text);\n      box-shadow: var(--shadow-sm);\n    }\n    .flow-desc p {\n      font-size: 1.125rem;\n      line-height: 1.6;\n    }\n    \n    .visual-content {\n      position: relative;\n    }\n    .flow-visual {\n      background: var(--surface);\n      border-radius: var(--radius-lg);\n      aspect-ratio: 4/3;\n      border: 1px solid var(--border);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      position: relative;\n      overflow: hidden;\n      box-shadow: var(--shadow-lg);\n      transition: opacity var(--transition);\n    }\n    .mock-video {\n      width: 100%; height: 100%;\n      background: linear-gradient(135deg, #e0e7ff 0%, #ede9fe 100%);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .play-btn {\n      width: 64px; height: 64px;\n      background: var(--accent);\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: white;\n      box-shadow: var(--shadow-md);\n    }\n    .mock-prototype {\n      width: 100%; height: 100%;\n      background: white;\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n      padding: 32px;\n      position: relative;\n    }\n    .proto-screen {\n      background: var(--surface);\n      border-radius: var(--radius-sm);\n      border: 1px solid var(--border);\n      position: relative;\n    }\n    .proto-connector {\n      position: absolute;\n      top: 50%; left: calc(100% + 8px);\n      width: 16px; height: 2px;\n      background: var(--accent);\n      z-index: 10;\n    }\n    \n    @media (max-width: 992px) {\n      .flows-content {\n        grid-template-columns: 1fr;\n        gap: 48px;\n      }\n      .flow-visual { aspect-ratio: 16/9; }\n    }\n\n    /* Inspiration Tools */\n    .tools-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 32px;\n    }\n    .tool-card {\n      background: white;\n      border: 1px solid var(--border);\n      border-radius: var(--radius-lg);\n      padding: 32px;\n      transition: transform var(--transition), box-shadow var(--transition);\n    }\n    .tool-card:hover {\n      transform: translateY(-8px);\n      box-shadow: var(--shadow-lg);\n    }\n    .tool-visual {\n      height: 160px;\n      background: var(--surface);\n      border-radius: var(--radius-md);\n      margin-bottom: 24px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 2rem;\n      color: var(--accent);\n    }\n    .tool-card h3 {\n      margin-bottom: 12px;\n    }\n    @media (max-width: 768px) {\n      .tools-grid { grid-template-columns: 1fr; }\n    }\n\n    /* Testimonials */\n    .testimonials {\n      overflow: hidden;\n    }\n    .marquee-wrapper {\n      display: flex;\n      flex-direction: column;\n      gap: 24px;\n      padding: 24px 0;\n      width: 100vw;\n      margin-left: calc(-50vw + 50%);\n      margin-top: 48px;\n    }\n    .marquee {\n      display: flex;\n      gap: 24px;\n      width: max-content;\n      animation: scrollLeft 40s linear infinite;\n    }\n    .marquee-reverse {\n      animation: scrollRight 40s linear infinite;\n    }\n    .marquee:hover, .marquee-reverse:hover {\n      animation-play-state: paused;\n    }\n    @keyframes scrollLeft {\n      0% { transform: translateX(0); }\n      100% { transform: translateX(-50%); }\n    }\n    @keyframes scrollRight {\n      0% { transform: translateX(-50%); }\n      100% { transform: translateX(0); }\n    }\n    .testimonial-card {\n      width: 350px;\n      background: white;\n      padding: 32px;\n      border-radius: var(--radius-md);\n      border: 1px solid var(--border);\n      box-shadow: var(--shadow-sm);\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      flex-shrink: 0;\n    }\n    .testimonial-card .quote {\n      color: var(--text);\n      font-size: 1.125rem;\n      margin-bottom: 24px;\n      font-weight: 500;\n      line-height: 1.6;\n    }\n    .testimonial-card .author {\n      font-size: 0.875rem;\n      color: var(--text-muted);\n    }\n    .testimonial-card .author strong {\n      color: var(--text);\n    }\n\n    /* CTA Section */\n    .cta {\n      border-top: 1px solid var(--border);\n      border-bottom: 1px solid var(--border);\n      padding-bottom: 0;\n      overflow: hidden;\n    }\n    .cta h2 {\n      margin-bottom: 16px;\n    }\n    .cta-actions {\n      display: flex;\n      justify-content: center;\n      gap: 16px;\n    }\n    @media (max-width: 480px) {\n      .cta-actions { flex-direction: column; }\n    }\n    \n    .app-icons-marquees {\n      margin-top: 80px;\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n      opacity: 0.4;\n      transform: rotate(-3deg) scale(1.1);\n      margin-bottom: -40px;\n    }\n    .icon-marquee {\n      display: flex;\n      gap: 16px;\n      width: max-content;\n      animation: scrollLeft 30s linear infinite;\n    }\n    .icon-marquee.reverse {\n      animation: scrollRight 30s linear infinite;\n    }\n    .app-icon {\n      width: 64px; height: 64px;\n      background: var(--text);\n      border-radius: 16px;\n      flex-shrink: 0;\n    }\n\n    /* Footer */\n    .footer {\n      padding: 64px 0 32px;\n      background: white;\n    }\n    .footer-grid {\n      display: grid;\n      grid-template-columns: 2fr 1fr 1fr 1fr;\n      gap: 48px;\n      margin-bottom: 64px;\n    }\n    .footer-brand .logo {\n      margin-bottom: 16px;\n    }\n    .footer-brand p {\n      max-width: 250px;\n    }\n    .footer-links h4 {\n      margin-bottom: 24px;\n    }\n    .footer-links ul {\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n    .footer-links a {\n      color: var(--text-muted);\n    }\n    .footer-links a:hover {\n      color: var(--text);\n    }\n    .footer-bottom {\n      padding-top: 32px;\n      border-top: 1px solid var(--border);\n      color: var(--text-muted);\n      font-size: 0.875rem;\n      display: flex;\n      justify-content: space-between;\n      flex-wrap: wrap;\n      gap: 16px;\n    }\n    @media (max-width: 768px) {\n      .footer-grid { grid-template-columns: 1fr 1fr; }\n      .footer-brand { grid-column: 1 / -1; }\n    }\n    @media (max-width: 480px) {\n      .footer-grid { grid-template-columns: 1fr; }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Announcement Bar -->\n  <div class=\"announcement-bar\">\n    2025 ScreenVault Awards — Celebrating the best on the internet. <a href=\"#\">Learn more &rarr;</a>\n  </div>\n\n  <!-- Navbar -->\n  <header class=\"navbar\">\n    <div class=\"container navbar-container\">\n      <a href=\"#\" class=\"logo\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"var(--accent)\"><path d=\"M12 2L2 22h20L12 2z\"/></svg>\n        ScreenVault\n      </a>\n      <nav class=\"nav-links\">\n        <a href=\"#\">Pricing</a>\n        <a href=\"#\">Awards</a>\n      </nav>\n      <div class=\"nav-actions\">\n        <a href=\"#\" class=\"nav-link\">Log in</a>\n        <a href=\"#\" class=\"btn btn-primary btn-sm\">Join for free</a>\n      </div>\n    </div>\n  </header>\n\n  <!-- Hero -->\n  <section class=\"hero text-center\">\n    <div class=\"container\">\n      <h1>Discover real-world design inspiration.</h1>\n      <p class=\"subtitle large\">Featuring over 1,000 iOS & Web apps, and 200 sites — New content weekly.</p>\n      <div class=\"hero-actions\">\n        <a href=\"#\" class=\"btn btn-primary btn-lg\">Join for free</a>\n        <a href=\"#\" class=\"btn btn-secondary btn-lg\">See our plans</a>\n      </div>\n      \n      <div class=\"hero-visual\">\n        <div class=\"mockup-stack\">\n          <div class=\"mock-screen\"></div>\n          <div class=\"mock-screen center\"></div>\n          <div class=\"mock-screen\"></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Trusted By -->\n  <section class=\"trusted-by\">\n    <div class=\"container text-center\">\n      <p class=\"trusted-label\">Trusted by design teams at</p>\n      <div class=\"brand-row\">\n        <span class=\"brand-logo\">Airbnb</span>\n        <span class=\"brand-logo\">Uber</span>\n        <span class=\"brand-logo\">Nike</span>\n        <span class=\"brand-logo\">Shopify</span>\n        <span class=\"brand-logo\">Figma</span>\n        <span class=\"brand-logo\">Stripe</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- Stats -->\n  <section class=\"stats\" id=\"stats-section\">\n    <div class=\"container\">\n      <div class=\"stats-intro\">\n        <h2>A growing library</h2>\n      </div>\n      <div class=\"stats-grid\">\n        <div class=\"stat-card\">\n          <h2 class=\"counter\" data-target=\"1150\">0</h2>\n          <p>apps</p>\n        </div>\n        <div class=\"stat-card\">\n          <h2 class=\"counter\" data-target=\"615900\">0</h2>\n          <p>screens</p>\n        </div>\n        <div class=\"stat-card\">\n          <h2 class=\"counter\" data-target=\"329200\">0</h2>\n          <p>flows</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Feature: Search -->\n  <section class=\"feature-search bg-surface\">\n    <div class=\"container\">\n      <div class=\"section-header text-center\">\n        <h2>Find design patterns in seconds.</h2>\n        <p>Combine categories and filters to narrow down exactly what you need.</p>\n      </div>\n      \n      <div class=\"search-interface\">\n        <div class=\"tabs\">\n          <button class=\"tab active\" data-tab=\"screens\">Screens</button>\n          <button class=\"tab\" data-tab=\"eleme