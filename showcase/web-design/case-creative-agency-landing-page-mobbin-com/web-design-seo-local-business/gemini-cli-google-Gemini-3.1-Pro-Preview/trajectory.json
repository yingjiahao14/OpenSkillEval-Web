a>\n      <a href=\"#\">Terms</a>\n    </div>\n  </div>\n\n  <script>\n    // Search grid generator\n    const grid = document.getElementById('search-grid');\n    function populateGrid() {\n      grid.innerHTML = '';\n      for (let i=0; i<8; i++) {\n        const item = document.createElement('div');\n        item.className = 'grid-item';\n        item.innerHTML = `<div class=\"placeholder-img\">Design Mockup ${i+1}</div>`;\n        grid.appendChild(item);\n      }\n    }\n    populateGrid();\n\n    // Tab switching logic\n    const tabs = document.querySelectorAll('.tab');\n    tabs.forEach(tab => {\n      tab.addEventListener('click', () => {\n        tabs.forEach(t => t.classList.remove('active'));\n        tab.classList.add('active');\n        // Simulate grid update\n        grid.style.opacity = '0.5';\n        setTimeout(() => {\n          populateGrid();\n          grid.style.opacity = '1';\n        }, 200);\n      });\n    });\n\n    // Pill filtering logic\n    const pills = document.querySelectorAll('.pill');\n    pills.forEach(pill => {\n      pill.addEventListener('click', () => {\n        pills.forEach(p => p.classList.remove('active'));\n        pill.classList.add('active');\n        // Simulate grid update\n        grid.style.opacity = '0.5';\n        setTimeout(() => {\n          populateGrid();\n          grid.style.opacity = '1';\n        }, 200);\n      });\n    });\n\n    // Flows toggle logic\n    const btnVideos = document.getElementById('btn-videos');\n    const btnProto = document.getElementById('btn-prototype');\n    const flowDisplay = document.getElementById('flow-display');\n\n    btnVideos.addEventListener('click', () => {\n      btnVideos.classList.add('active');\n      btnProto.classList.remove('active');\n      flowDisplay.style.opacity = '0';\n      setTimeout(() => {\n        flowDisplay.innerText = 'Playing Video Experience...';\n        flowDisplay.style.opacity = '1';\n      }, 200);\n    });\n\n    btnProto.addEventListener('click', () => {\n      btnProto.classList.add('active');\n      btnVideos.classList.remove('active');\n      flowDisplay.style.opacity = '0';\n      setTimeout(() => {\n        flowDisplay.innerText = 'Interactive Prototype Step-by-Step...';\n        flowDisplay.style.opacity = '1';\n      }, 200);\n    });\n\n    // Stats counter logic\n    const counters = document.querySelectorAll('.counter');\n    let hasCounted = false;\n\n    function animateCounters() {\n      counters.forEach(counter => {\n        const target = +counter.getAttribute('data-target');\n        const duration = 2000;\n        const increment = target / (duration / 16);\n        let current = 0;\n\n        const updateCounter = () => {\n          current += increment;\n          if (current < target) {\n            counter.innerText = Math.ceil(current).toLocaleString();\n            requestAnimationFrame(updateCounter);\n          } else {\n            counter.innerText = target.toLocaleString();\n          }\n        };\n        updateCounter();\n      });\n    }\n\n    const observer = new IntersectionObserver((entries) => {\n      if (entries[0].isIntersecting && !hasCounted) {\n        hasCounted = true;\n        animateCounters();\n      }\n    }, { threshold: 0.5 });\n\n    observer.observe(document.getElementById('stats'));\n  </script>\n</body>\n</html>",
