ar(--primary-red);\n            letter-spacing: -0.05em;\n            text-transform: uppercase;\n            margin-bottom: 3rem;\n            text-decoration: none;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            line-height: 1;\n        }\n\n        .logo .missing-e {\n            display: inline-block;\n            width: 0.5em;\n            height: 0.75em;\n            border: 3px dashed var(--primary-red);\n            margin: 0 0.06em;\n            box-sizing: border-box;\n        }\n\n        .error-message {\n            margin-bottom: 2rem;\n        }\n\n        .error-message h1 {\n            font-size: 2.25rem;\n            font-weight: 700;\n            margin: 0 0 1rem 0;\n            color: var(--text-dark);\n            letter-spacing: -0.02em;\n        }\n\n        .error-message p {\n            font-size: 1.125rem;\n            color: var(--text-gray);\n            margin: 0;\n        }\n\n        .search-container {\n            width: 100%;\n            max-width: 440px;\n            margin: 0 auto 2rem auto;\n            position: relative;\n        }\n\n        .search-input {\n            width: 100%;\n            padding: 1rem 3rem 1rem 1.25rem;\n            font-size: 1rem;\n            border: 1px solid var(--border-color);\n            border-radius: 8px;\n            box-sizing: border-box;\n            font-family: 'Inter', sans-serif;\n            color: var(--text-dark);\n            outline: none;\n            transition: border-color 0.2s, box-shadow 0.2s;\n            background-color: var(--bg-white);\n        }\n\n        .search-input:focus {\n            border-color: var(--teal-accent);\n            box-shadow: 0 0 0 3px rgba(30, 58, 95, 0.1);\n        }\n\n        .search-input::placeholder {\n            color: #999;\n        }\n\n        .search-button {\n            position: absolute;\n            right: 0.5rem;\n            top: 50%;\n            transform: translateY(-50%);\n            background: none;\n            border: none;\n            cursor: pointer;\n            color: var(--text-light);\n            padding: 0.5rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border-radius: 4px;\n        }\n\n        .search-button:hover {\n            color: var(--teal-accent);\n        }\n\n        .error-code {\n            background-color: var(--bg-muted);\n            padding: 0.5rem 1rem;\n            border-radius: 6px;\n            font-size: 0.875rem;\n            font-weight: 500;\n            color: var(--text-light);\n            margin-bottom: 2rem;\n            display: inline-block;\n        }\n\n        .divider {\n            width: 100%;\n            max-width: 200px;\n            height: 1px;\n            background-color: var(--border-color);\n            margin: 0 auto 2rem auto;\n        }\n\n        .next-steps {\n            text-align: center;\n            margin-bottom: 4rem;\n        }\n\n        .next-steps h2 {\n            font-size: 1rem;\n            font-weight: 600;\n            color: var(--text-dark);\n            margin: 0 0 1rem 0;\n        }\n\n        .next-steps ul {\n            list-style: none;\n            padding: 0;\n            margin: 0;\n            display: flex;\n            flex-direction: column;\n            gap: 1rem;\n        }\n\n        .next-steps a {\n            color: var(--text-light);\n            text-decoration: none;\n            font-size: 1rem;\n            font-weight: 500;\n            transition: color 0.2s;\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            gap: 0.5rem;\n        }\n\n        .next-steps a:hover {\n            color: var(--teal-accent);\n            text-decoration: underline;\n        }\n\n        .next-steps a::after {\n            content: \"→\";\n            font-family: system-ui, sans-serif;\n        }\n\n        /* Cookie Consent Banner */\n        .cookie-banner {\n            background-color: var(--text-dark);\n            color: var(--bg-white);\n            padding: 1.25rem 1.5rem;\n            font-size: 0.875rem;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            gap: 1.25rem;\n            text-align: left;\n            width: 100%;\n            box-sizing: border-box;\n            z-index: 1000;\n        }\n\n        @media (min-width: 768px) {\n            .cookie-banner {\n                flex-direction: row;\n                justify-content: space-between;\n                align-items: center;\n            }\n            .cookie-banner p {\n                margin: 0;\n                flex: 1;\n                padding-right: 2rem;\n            }\n        }\n\n        .cookie-banner a {\n            color: var(--bg-white);\n            text-decoration: underline;\n        }\n\n        .cookie-banner button {\n            background-color: var(--bg-white);\n            color: var(--text-dark);\n            border: none;\n            padding: 0.625rem 1.25rem;\n            font-size: 0.875rem;\n            font-weight: 600;\n            border-radius: 4px;\n            cursor: pointer;\n            white-space: nowrap;\n            transition: background-color 0.2s;\n        }\n\n        .cookie-banner button:hover {\n            background-color: #F0F0F0;\n        }\n\n        /* Preferences Modal */\n        .modal-overlay {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background-color: rgba(18, 18, 18, 0.6);\n            display: none;\n            align-items: center;\n            justify-content: center;\n            z-index: 1001;\n            opacity: 0;\n            transition: opacity 0.3s ease;\n        }\n\n        .modal-overlay.open {\n            display: flex;\n            opacity: 1;\n        }\n\n        .modal {\n            background-color: var(--bg-white);\n            padding: 2rem;\n            border-radius: 8px;\n            max-width: 450px;\n            width: 90%;\n            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);\n            text-align: left;\n        }\n\n        .modal h3 {\n            margin: 0 0 1rem 0;\n            font-size: 1.25rem;\n            color: var(--text-dark);\n        }\n\n        .modal p {\n            font-size: 0.875rem;\n            color: var(--text-gray);\n            margin: 0 0 1.5rem 0;\n            line-height: 1.5;\n        }\n\n        .modal-close {\n            background-color: var(--teal-accent);\n            color: white;\n            border: none;\n            padding: 0.75rem 1rem;\n            font-size: 0.875rem;\n            font-weight: 600;\n            border-radius: 4px;\n            cursor: pointer;\n            width: 100%;\n            transition: background-color 0.2s;\n        }\n\n        .modal-close:hover {\n            background-color: #152842;\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"huge-404\">404</div>\n\n    <main>\n        <!-- Hero Logo -->\n        <a href=\"/\" class=\"logo\" aria-label=\"IdeaForum Home\">\n            ID<span class=\"missing-e\"></span>AFORUM\n        </a>\n\n        <!-- Error Message -->\n        <div class=\"error-message\">\n            <h1>Sorry, we can't find that.</h1>\n            <p>Perhaps we can help you find the content you're looking for:</p>\n        </div>\n\n        <!-- Search -->\n        <form action=\"/search\" method=\"GET\" class=\"search-container\" id=\"search-form\">\n            <input type=\"text\" name=\"q\" class=\"search-input\" placeholder=\"Search IdeaForum...\" aria-label=\"Search IdeaForum\" required>\n            <button type=\"submit\" class=\"search-button\" aria-label=\"Submit search\">\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                    <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n                    <line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line>\n                </svg>\n            </button>\n        </form>\n\n        <!-- Error Code -->\n        <div class=\"error-code\">\n            HTTP Error 404\n        </div>\n\n        <div class=\"divider\"></div>\n\n        <!-- Next Steps -->\n        <div class=\"next-steps\">\n            <h2>What's next?</h2>\n            <ul>\n                <li><a href=\"/\">Go to the homepage</a></li>\n                <li><a href=\"/help\">Visit our Help Desk</a></li>\n            </ul>\n        </div>\n    </main>\n\n    <!-- Cookie Consent Banner -->\n    <div class=\"cookie-banner\" id=\"cookie-banner\">\n        <p>This website utilizes technologies such as cookies to enable essential site functionality, as well as for analytics, personalization, and targeted advertising. To learn more, view the following link: <a href=\"/privacy\" target=\"_blank\" rel=\"noopener noreferrer\">Privacy Policy</a></p>\n        <button id=\"manage-preferences-btn\">Manage Preferences</button>\n    </div>\n\n    <!-- Preferences Modal -->\n    <div class=\"modal-overlay\" id=\"preferences-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-title\">\n        <div class=\"modal\">\n            <h3 id=\"modal-title\">Manage Preferences</h3>\n            <p>Customize your cookie settings and privacy preferences below. Essential cookies are required for site functionality and cannot be disabled.</p>\n            <button class=\"modal-close\" id=\"close-modal-btn\">Save Preferences</button>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const searchForm = document.getElementById('search-form');\n            \n            // Search interaction\n            searchForm.addEventListener('submit', (e) => {\n                e.preventDefault();\n                const query = searchForm.querySelector('.search-input').value.trim();\n                if (query) {\n                    // In a real app this would submit, here we demonstrate the intent\n                    window.location.href = `/search?q=${encodeURIComponent(query)}`;\n                }\n            });\n\n            // Cookie Preferences Modal interaction\n            const manageBtn = document.getElementById('manage-preferences-btn');\n            const modal = document.getElementById('preferences-modal');\n            const closeBtn = document.getElementById('close-modal-btn');\n\n            manageBtn.addEventListener('click', () => {\n                modal.classList.add('open');\n                // Optional: set focus to the close button for accessibility\n                setTimeout(() => closeBtn.focus(), 100);\n            });\n\n            const closeModal = () => {\n                modal.classList.remove('open');\n            };\n\n            closeBtn.addEventListener('click', closeModal);\n\n            modal.addEventListener('click', (e) => {\n                // Close when clicking the overlay outside the modal\n                if (e.target === modal) {\n                    closeModal();\n                }\n            });\n\n            // Close modal on Escape key\n            document.addEventListener('keydown', (e) => {\n                if (e.key === 'Escape' && modal.classList.contains('open')) {\n                    closeModal();\n                }\n            });\n        });\n    </script>\n</body>\n</html>",
