 100vh;\n      -webkit-font-smoothing: antialiased;\n      -moz-osx-font-smoothing: grayscale;\n    }\n\n    /* Container for vertically stacked content */\n    main {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 4rem 1.5rem;\n      max-width: 800px;\n      margin: 0 auto;\n      text-align: center;\n      width: 100%;\n    }\n\n    /* Logo */\n    .brand-logo {\n      font-size: 2.5rem;\n      font-weight: 800;\n      color: var(--color-brand-red);\n      letter-spacing: -0.05em;\n      margin-bottom: 4rem;\n      text-transform: uppercase;\n      display: flex;\n      align-items: center;\n      text-decoration: none;\n    }\n    \n    .brand-logo .missing-e {\n      display: inline-block;\n      width: 0.6em;\n      height: 0.75em;\n      border: 3px dashed var(--color-brand-red);\n      border-radius: 2px;\n      margin: 0 0.05em;\n      position: relative;\n      top: -0.05em;\n    }\n\n    /* Error Details */\n    .error-wrapper {\n      position: relative;\n      width: 100%;\n      z-index: 1;\n      margin-bottom: 2.5rem;\n    }\n\n    .error-404-bg {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      font-size: 16rem;\n      font-weight: 900;\n      color: var(--color-gray-bg);\n      z-index: -1;\n      line-height: 1;\n      letter-spacing: -0.05em;\n      pointer-events: none;\n      user-select: none;\n    }\n\n    h1 {\n      font-size: 3rem;\n      font-weight: 700;\n      color: var(--color-teal-dark);\n      margin-bottom: 1rem;\n      letter-spacing: -0.02em;\n    }\n\n    .suggestion {\n      font-size: 1.25rem;\n      color: var(--color-gray-dark);\n      max-width: 500px;\n      margin: 0 auto;\n    }\n\n    /* Search */\n    .search-container {\n      width: 100%;\n      max-width: 520px;\n      margin: 0 auto 3rem auto;\n      position: relative;\n    }\n\n    .search-input {\n      width: 100%;\n      padding: 1.125rem 3.5rem 1.125rem 1.5rem;\n      font-size: 1.125rem;\n      font-family: var(--font-primary);\n      color: var(--color-dark);\n      background-color: var(--color-white);\n      border: 1.5px solid var(--color-gray-light);\n      border-radius: 8px;\n      outline: none;\n      transition: border-color 0.2s ease, box-shadow 0.2s ease;\n      box-shadow: 0 4px 6px rgba(0,0,0,0.02);\n    }\n\n    .search-input:focus {\n      border-color: var(--color-teal-text);\n      box-shadow: 0 0 0 4px rgba(44, 82, 130, 0.1);\n    }\n\n    .search-input::placeholder {\n      color: var(--color-gray-medium);\n      font-weight: 400;\n    }\n\n    .search-button {\n      position: absolute;\n      right: 1rem;\n      top: 50%;\n      transform: translateY(-50%);\n      background: none;\n      border: none;\n      cursor: pointer;\n      color: var(--color-teal-text);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 0.5rem;\n      border-radius: 4px;\n      transition: background-color 0.2s ease, color 0.2s ease;\n    }\n    \n    .search-button:hover {\n      background-color: var(--color-gray-bg);\n      color: var(--color-teal-dark);\n    }\n\n    .search-button svg {\n      width: 24px;\n      height: 24px;\n    }\n\n    /* Error Code Display */\n    .error-code-bar {\n      background-color: var(--color-gray-bg);\n      padding: 0.75rem 1.5rem;\n      border-radius: 6px;\n      display: inline-block;\n      margin-bottom: 2.5rem;\n      border: 1px solid var(--color-gray-light);\n    }\n\n    .error-code-bar span {\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: var(--color-gray-medium);\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n    }\n    \n    .divider {\n      width: 100%;\n      max-width: 120px;\n      height: 2px;\n      background-color: var(--color-gray-light);\n      margin: 0 auto 2.5rem auto;\n    }\n\n    /* Next Steps */\n    .next-steps {