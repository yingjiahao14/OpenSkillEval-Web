            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>CoinTracker Pro — Cryptocurrency Prices, Charts and Market Capitalizations</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      /* Brand Colors */\n      --brand-primary: oklch(54% 0.17 261);    /* #3861FB */\n      --brand-hover: oklch(45% 0.17 261);\n      --text-primary: oklch(20% 0.02 260);     /* #0D1421 */\n      --text-secondary: oklch(50% 0.03 260);   /* #808A9D */\n      --text-muted: oklch(75% 0.02 260);\n      \n      /* Surface & Layout */\n      --bg-body: oklch(99% 0 0);               /* White */\n      --bg-surface: oklch(97% 0.01 260);       /* Light gray */\n      --bg-hover: oklch(95% 0.01 260);\n      --border-color: oklch(90% 0.01 260);\n      \n      /* Status Colors */\n      --color-positive: oklch(73% 0.17 150);   /* #16c784 */\n      --color-negative: oklch(54% 0.19 25);    /* #ea3943 */\n      \n      /* Typography */\n      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    \n    body {\n      font-family: var(--font-sans);\n      color: var(--text-primary);\n      background-color: var(--bg-body);\n      line-height: 1.5;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { text-decoration: none; color: inherit; }\n    ul { list-style: none; }\n    button { cursor: pointer; font-family: inherit; }\n\n    .container {\n      max-width: 1400px;\n      margin: 0 auto;\n      padding: 0 16px;\n    }\n\n    /* Top Bar Metrics */\n    .top-bar-metrics {\n      font-size: 12px;\n      padding: 8px 0;\n      border-bottom: 1px solid var(--border-color);\n      display: flex;\n      gap: 24px;\n      color: var(--text-secondary);\n      overflow-x: auto;\n      white-space: nowrap;\n    }\n    \n    .top-bar-metrics .metric { display: flex; align-items: center; gap: 6px; }\n    .metric-label { font-weight: 500; }\n    .metric-value { color: var(--brand-primary); font-weight: 600; font-variant-numeric: tabular-nums; }\n    .metric-change.up { color: var(--color-positive); }\n    .metric-change.down { color: var(--color-negative); }\n\n    /* Header */\n    .header {\n      padding: 16px 0;\n      border-bottom: 1px solid var(--border-color);\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n\n    .brand {\n      font-size: 20px;\n      font-weight: 700;\n      color: var(--text-primary);\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n    \n    .brand-icon {\n      width: 24px;\n      height: 24px;\n      background: var(--brand-primary);\n      border-radius: 50%;\n    }\n\n    .nav-links {\n      display: flex;\n      gap: 24px;\n      font-weight: 600;\n      font-size: 14px;\n    }\n    \n    .nav-links a:hover { color: var(--brand-primary); }\n\n    .header-actions {\n      display: flex;\n      gap: 12px;\n    }\n\n    .btn {\n      padding: 8px 16px;\n      border-radius: 8px;\n      font-size: 14px;\n      font-weight: 600;\n      border: 1px solid transparent;\n      transition: all 0.2s;\n    }\n    .btn-outline { border-color: var(--border-color); background: transparent; }\n    .btn-outline:hover { background: var(--bg-surface); }\n    .btn-primary { background: var(--brand-primary); color: white; }\n    .btn-primary:hover { background: var(--brand-hover); }\n\n    /* Promotional Banner */\n    .promo-banner {\n      background: var(--bg-surface);\n      padding: 12px 16px;\n      font-size: 14px;\n      font-weight: 500;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      gap: 16px;\n      border-bottom: 1px solid var(--border-color);\n      position: relative;\n    }\n    .promo-banner .arrow { cursor: pointer; color: var(--text-secondary); }\n    .promo-banner .arrow:hover { color: var(--brand-primary); }\n    \n    /* AI Alerts Bar */\n    .ai-alerts {\n      padding: 16px 0;\n      display: flex;\n      gap: 16px;\n      align-items: center;\n      overflow-x: auto;\n      white-space: nowrap;\n    }\n    .ai-topic {\n      font-weight: 600;\n      font-size: 14px;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n    .ai-badge {\n      background: linear-gradient(135deg, var(--brand-primary), #a855f7);\n      color: white;\n      padding: 2px 6px;\n      border-radius: 4px;\n      font-size: 10px;\n      font-weight: 700;\n      text-transform: uppercase;\n    }\n    .ai-pill {\n      background: var(--bg-surface);\n      border: 1px solid var(--border-color);\n      border-radius: 100px;\n      padding: 6px 12px;\n      font-size: 13px;\n      color: var(--text-secondary);\n      cursor: pointer;\n    }\n    .ai-pill:hover { background: var(--border-color); color: var(--text-primary); }\n\n    /* Main Layout */\n    .main-content {\n      padding: 24px 0 64px;\n    }\n    \n    h1 {\n      font-size: 24px;\n      font-weight: 700;\n      margin-bottom: 24px;\n    }\n\n    /* Tabs Layout */\n    .table-controls {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-end;\n      margin-bottom: 16px;\n      gap: 16px;\n      flex-wrap: wrap;\n    }\n\n    .tabs-group {\n      display: flex;\n      gap: 8px;\n      border-bottom: 1px solid var(--border-color);\n      padding-bottom: 8px;\n    }\n    .tab {\n      padding: 8px 12px;\n      font-size: 14px;\n      font-weight: 600;\n      color: var(--text-secondary);\n      border-radius: 6px;\n      cursor: pointer;\n      border: none;\n      background: transparent;\n      transition: background 0.2s;\n    }\n    .tab:hover { background: var(--bg-surface); }\n    .tab.active {\n      color: var(--brand-primary);\n      background: oklch(54% 0.17 261 / 0.1);\n    }\n    \n    .filter-pills {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 16px;\n      flex-wrap: wrap;\n    }\n    .filter-pill {\n      padding: 6px 12px;\n      border: 1px solid var(--border-color);\n      border-radius: 6px;\n      font-size: 13px;\n      font-weight: 500;\n      color: var(--text-secondary);\n      background: transparent;\n      cursor: pointer;\n    }\n    .filter-pill:hover { background: var(--bg-surface); }\n    .filter-pill.active {\n      background: var(--text-primary);\n      color: var(--bg-body);\n      border-color: var(--text-primary);\n    }\n\n    .action-group {\n      display: flex;\n      gap: 8px;\n    }\n    .action-btn {\n      padding: 6px 12px;\n      font-size: 13px;\n      font-weight: 600;\n      border: 1px solid var(--border-color);\n      border-radius: 6px;\n      background: var(--bg-body);\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    .action-btn:hover { background: var(--bg-surface); }\n\n    /* Table */\n    .table-container {\n      overflow-x: auto;\n      border-radius: 8px;\n      border: 1px solid var(--border-color);\n      margin-bottom: 24px;\n    }\n    \n    table {\n      width: 100%;\n      border-collapse: collapse;\n      text-align: right;\n      font-variant-numeric: tabular-nums;\n      min-width: 1000px;\n    }\n    \n    th {\n      font-size: 12px;\n      font-weight: 600;\n      color: var(--text-secondary);\n      padding: 12px 16px;\n      border-bottom: 1px solid var(--border-color);\n      background: var(--bg-surface);\n      white-space: nowrap;\n    }\n    \n    td {\n      padding: 16px;\n      font-size: 14px;\n      font-weight: 500;\n      border-bottom: 1px solid var(--border-color);\n    }\n    \n    tr:hover td { background: var(--bg-surface); }\n    \n    /* Alignment overrides */\n    th:nth-child(1), td:nth-child(1) { text-align: left; width: 40px; }\n    th:nth-child(2), td:nth-child(2) { text-align: left; }\n    \n    .coin-name {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      font-weight: 600;\n      color: var(--text-primary);\n    }\n    .coin-ticker {\n      font-size: 13px;\n      color: var(--text-secondary);\n      font-weight: 500;\n    }\n    \n    .up { color: var(--color-positive); }\n    .down { color: var(--color-negative); }\n    \n    .sparkline {\n      font-family: monospace;\n      color: var(--text-secondary);\n      font-size: 10px;\n      letter-spacing: -1px;\n    }\n    .sparkline.up { color: var(--color-positive); }\n    .sparkline.down { color: var(--color-negative); }\n    \n    .index-tracker {\n      background: oklch(54% 0.17 261 / 0.04);\n    }\n\n    /* Pagination */\n    .pagination {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 16px 0;\n      font-size: 14px;\n      color: var(--text-secondary);\n    }\n    .page-numbers {\n      display: flex;\n      gap: 8px;\n    }\n    .page-btn {\n      width: 32px;\n      height: 32px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border-radius: 6px;\n      border: 1px solid transparent;\n      font-weight: 500;\n      cursor: pointer;\n      background: transparent;\n      color: inherit;\n    }\n    .page-btn:hover { background: var(--bg-surface); }\n    .page-btn.active { background: var(--brand-primary); color: white; border-color: var(--brand-primary); }\n\n    /* Market Summary & Info Content */\n    .market-summary, .info-content {\n      max-width: 800px;\n      margin-top: 48px;\n    }\n    .market-summary p { font-size: 14px; color: var(--text-secondary); margin-bottom: 12px; }\n    .market-summary strong { color: var(--text-primary); }\n    .read-more {\n      color: var(--brand-primary);\n      font-weight: 600;\n      font-size: 14px;\n      cursor: pointer;\n      display: inline-block;\n      margin-bottom: 48px;\n    }\n    \n    .info-content h2 { font-size: 20px; font-weight: 700; margin-bottom: 16px; margin-top: 32px; }\n    .info-content h3 { font-size: 16px; font-weight: 600; margin-bottom: 12px; margin-top: 24px; }\n    .info-content p { font-size: 15px; color: var(--text-secondary); margin-bottom: 16px; }\n\n    /* Footer */\n    .footer {\n      border-top: 1px solid var(--border-color);\n      padding: 48px 0 24px;\n      background: var(--bg-surface);\n    }\n    .footer-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n      gap: 32px;\n      margin-bottom: 48px;\n    }\n    .footer-col h4 { font-size: 16px; font-weight: 700; margin-bottom: 16px; }\n    .footer-col ul { display: flex; flex-direction: column; gap: 12px; }\n    .footer-col a { font-size: 14px; color: var(--text-secondary); }\n    .footer-col a:hover { color: var(--brand-primary); }\n    \n    .footer-bottom {\n      border-top: 1px solid var(--border-color);\n      padding-top: 24px;\n      font-size: 14px;\n      color: var(--text-secondary);\n      display: flex;\n      justify-content: space-between;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Top Bar Metrics -->\n  <div class=\"top-bar-metrics container\">\n    <div class=\"metric\">\n      <span class=\"metric-label\">Market Cap:</span>\n      <span class=\"metric-value\">$2.56T</span>\n      <span class=\"metric-change up\">↑ 1.46%</span>\n    </div>\n    <div class=\"metric\">\n      <span class=\"metric-label\">CTP20 Index:</span>\n      <span class=\"metric-value\">$155.36</span>\n      <span class=\"metric-change up\">↑ 1.5%</span>\n    </div>\n    <div class=\"metric\">\n      <span class=\"metric-label\">Fear & Greed:</span>\n      <span class=\"metric-value\">57</span>\n      <span class=\"metric-label\">Neutral</span>\n    </div>\n    <div class=\"met