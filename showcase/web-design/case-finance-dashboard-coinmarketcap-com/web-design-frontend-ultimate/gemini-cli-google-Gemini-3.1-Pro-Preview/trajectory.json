            "content": "const fs = require('fs');\n\nconst generateHTML = () => {\n  const rows = [\n    { rank: 1, name: 'Bitcoin', symbol: 'BTC', price: '$75,612.78', h1: '+0.45%', h24: '+1.33%', d7: '+4.84%', mcap: '$1.51T', vol: '$42.82B', supply: '20.01M BTC', spark: '▁▂▃▅▆', img: 'https://cryptologos.cc/logos/bitcoin-btc-logo.svg?v=029' },\n    { rank: 2, name: 'Ethereum', symbol: 'ETH', price: '$2,356.00', h1: '+0.51%', h24: '+0.80%', d7: '+6.29%', mcap: '$284.35B', vol: '$21.36B', supply: '120.69M ETH', spark: '▂▃▄▅▆', img: 'https://cryptologos.cc/logos/ethereum-eth-logo.svg?v=029' },\n    { rank: 3, name: 'Tether', symbol: 'USDT', price: '$1.00', h1: '+0.01%', h24: '+0.03%', d7: '+0.01%', mcap: '$185.84B', vol: '$138.79B', supply: '185.8B USDT', spark: '▅▅▅▅▅', img: 'https://cryptologos.cc/logos/tether-usdt-logo.svg?v=029' },\n    { rank: 4, name: 'XRP', symbol: 'XRP', price: '$1.44', h1: '+0.71%', h24: '+2.71%', d7: '+7.89%', mcap: '$89.13B', vol: '$4.03B', supply: '61.56B XRP', spark: '▂▃▃▅▇', img: 'https://cryptologos.cc/logos/xrp-xrp-logo.svg?v=029' },\n    { rank: 5, name: 'BNB', symbol: 'BNB', price: '$632.59', h1: '+0.38%', h24: '+1.89%', d7: '+4.98%', mcap: '$85.27B', vol: '$1.95B', supply: '134.78M BNB', spark: '▃▃▄▅▆', img: 'https://cryptologos.cc/logos/bnb-bnb-logo.svg?v=029' },\n    { rank: 7, name: 'Solana', symbol: 'SOL', price: '$88.25', h1: '+0.67%', h24: '+3.74%', d7: '+5.67%', mcap: '$50.77B', vol: '$6.71B', supply: '575.26M SOL', spark: '▂▃▄▅▆', img: 'https://cryptologos.cc/logos/solana-sol-logo.svg?v=029' },\n  ];\n\n  let tableRows = '';\n  for (let i = 0; i < 100; i++) {\n    const r = rows[i % rows.length];\n    const rank = i === 0 ? 1 : i === 1 ? 2 : i === 2 ? 3 : i === 3 ? 4 : i === 4 ? 5 : i + 2;\n    const priceNum = parseFloat(r.price.replace(/[$,]/g, ''));\n    const vary = 1 + (Math.random() * 0.04 - 0.02);\n    const newPrice = i < 6 ? r.price : '$' + (priceNum * vary).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 6 });\n    \n    tableRows += `\n      <tr class=\"border-b border-gray-100 hover:bg-gray-50/80 transition-colors group\">\n        <td class=\"py-3 px-4 text-sm text-gray-500 font-medium whitespace-nowrap\">\\${i < 6 ? r.rank : rank}</td>\n        <td class=\"py-3 px-4 text-sm font-medium text-gray-900 whitespace-nowrap\">\n          <div class=\"flex items-center gap-2\">\n            <div class=\"w-6 h-6 rounded-full bg-gray-100 flex items-center justify-center overflow-hidden border border-gray-200\">\n               <img src=\"\\${r.img}\" alt=\"\\${r.symbol}\" class=\"w-4 h-4 object-contain\" onerror=\"this.style.display='none'\">\n            </div>\n            <span class=\"font-semibold\">\\${r.name}</span>\n            <span class=\"text-gray-400 font-normal ml-1\">\\${r.symbol}</span>\n          </div>\n        </td>\n        <td class=\"py-3 px-4 text-sm text-right tabular-nums text-gray-900 font-medium\">\\${newPrice}</td>\n        <td class=\"py-3 px-4 text-sm text-right tabular-nums text-[#16c784] font-medium\">\\${r.h1}</td>\n        <td class=\"py-3 px-4 text-sm text-right tabular-nums text-[#16c784] font-medium\">\\${r.h24}</td>\n        <td class=\"py-3 px-4 text-sm text-right tabular-nums text-[#16c784] font-medium\">\\${r.d7}</td>\n        <td class=\"py-3 px-4 text-sm text-right tabular-nums text-gray-900\">\\${r.mcap}</td>\n        <td class=\"py-3 px-4 text-sm text-right tabular-nums text-gray-900\">\\${r.vol}</td>\n        <td class=\"py-3 px-4 text-sm text-right tabular-nums text-gray-900\">\\${r.supply}</td>\n        <td class=\"py-3 px-4 text-sm text-right text-gray-400 font-mono tracking-tighter opacity-70 group-hover:opacity-100 transition-opacity\">\\${r.spark}</td>\n      </tr>\n    `;\n  }\n\n  const html = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>CoinTracker Pro — Cryptocurrency Prices, Charts and Market Capitalizations</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script defer src=\"https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js\"></script>\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n    body { font-family: 'Inter', sans-serif; background-color: #ffffff; color: #0D1421; }\n    .tabular-nums { font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }\n    .sparkline { font-family: 'JetBrains Mono', monospace; font-size: 11px; }\n    /* Hide scrollbar for tabs */\n    .no-scrollbar::-webkit-scrollbar { display: none; }\n    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n  </style>\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          colors: {\n            brand: '#3861FB',\n            navy: '#0D1421',\n            gray: {\n              50: '#F8F9FA',\n              100: '#EFF2F5',\n              200: '#E2E8F0',\n              400: '#A1A1AA',\n              500: '#808A9D',\n              900: '#0D1421'\n            },\n            green: { 500: '#16c784' },\n            red: { 500: '#ea3943' }\n          },\n          fontFamily: {\n            sans: ['Inter', 'sans-serif'],\n            mono: ['JetBrains Mono', 'monospace']\n          }\n        }\n      }\n    }\n  </script>\n</head>\n<body class=\"antialiased text-navy\" x-data=\"{ \n  categoryTab: 'Top', \n  networkTab: 'All Networks',\n  showColumns: false,\n  showFilters: false,\n  summaryExpanded: false,\n  promoIndex: 0,\n  promos: [\n    '🚀 CTP Launch: Secure $GENIUS Airdrop — Join Now',\n    '⚡ New Feature: Real-time Solana DEX tracking now live',\n    '🏆 Trading Competition: Win up to $10,000 in BTC'\n  ]\n}\">\n\n  <!-- Global Market Stats Bar -->\n  <div class=\"bg-gray-50 border-b border-gray-100 text-[11px] font-medium py-2 px-4 md:px-6\">\n    <div class=\"max-w-[1400px] mx-auto flex flex-wrap items-center justify-between gap-4 text-gray-500\">\n      <div class=\"flex items-center gap-6\">\n        <div class=\"flex items-center gap-1.5\">\n          <span>Market Cap:</span>\n          <span class=\"text-brand tabular-nums font-semibold\">$2.56T</span>\n          <span class=\"text-green-500 flex items-center\"><i data-lucide=\"arrow-up\" class=\"w-3 h-3\"></i>1.46%</span>\n        </div>\n        <div class=\"flex items-center gap-1.5 hidden sm:flex\">\n          <span>CTP20 Index:</span>\n          <span class=\"text-brand tabular-nums font-semibold\">$155.36</span>\n          <span class=\"text-green-500 flex items-center\"><i data-lucide=\"arrow-up\" class=\"w-3 h-3\"></i>1.5%</span>\n        </div>\n        <div class=\"flex items-center gap-1.5 hidden md:flex\">\n          <span>Fear & Greed:</span>\n          <span class=\"text-gray-900 font-semibold\">57</span>\n          <span class=\"bg-gray-200 text-gray-700 px-1.5 py-0.5 rounded text-[10px]\">Neutral</span>\n        </div>\n        <div class=\"flex items-center gap-1.5 hidden lg:flex\">\n          <span>Altcoin Season:</span>\n          <span class=\"text-brand tabular-nums font-semibold\">37/100</span>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <div class=\"flex items-center gap-1 hover:text-brand cursor-pointer transition-colors\">\n          <span>English</span> <i data-lucide=\"chevron-down\" class=\"w-3 h-3\"></i>\n        </div>\n        <div class=\"flex items-center gap-1 hover:text-brand cursor-pointer transition-colors\">\n          <span>USD</span> <i data-lucide=\"chevron-down\" class=\"w-3 h-3\"></i>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-100 sticky top-0 z-50\">\n    <div class=\"max-w-[1400px] mx-auto px-4 md:px-6 h-16 flex items-center justify-between\">\n      <div class=\"flex items-center gap-8\">\n        <a href=\"#\" class=\"flex items-center gap-2\">\n          <div class=\"w-8 h-8 bg-brand rounded-lg flex items-center justify-center shadow-sm\">\n            <i data-lucide=\"bar-chart-2\" class=\"w-5 h-5 text-white\"></i>\n          </div>\n          <span class=\"font-bold text-lg tracking-tight text-navy\">CoinTracker<span class=\"text-brand\">Pro</span></span>\n        </a>\n        \n        <nav class=\"hidden lg:flex items-center gap-6 text-sm font-semibold text-gray-900\">\n          <a href=\"#\" class=\"text-brand flex items-center gap-1\">Cryptocurrencies <i data-lucide=\"chevron-down\" class=\"w-3 h-3 opacity-50\"></i></a>\n          <a href=\"#\" class=\"hover:text-brand transition-colors flex items-center gap-1\">Dashboards <i data-lucide=\"chevron-down\" class=\"w-3 h-3 opacity-50\"></i></a>\n          <a href=\"#\" class=\"hover:text-brand transition-colors flex items-center gap-1\">Exchanges <i data-lucide=\"chevron-down\" class=\"w-3 h-3 opacity-50\"></i></a>\n          <a href=\"#\" class=\"hover:text-brand transition-colors flex items-center gap-1\">DexScan <i data-lucide=\"chevron-down\" class=\"w-3 h-3 opacity-50\"></i></a>\n          <a href=\"#\" class=\"hover:text-brand transition-colors flex items-center gap-1\">More <i data-lucide=\"chevron-down\" class=\"w-3 h-3 opacity-50\"></i></a>\n        </nav>\n      </div>\n      \n      <div class=\"flex items-center gap-4\">\n        <div class=\"relative hidden md:block\">\n          <i data-lucide=\"search\" class=\"w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2\"></i>\n          <input type=\"text\" placeholder=\"Search tokens...\" class=\"pl-9 pr-4 py-1.5 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand w-64 transition-all placeholder:text-gray-400\">\n          <div class=\"absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1\">\n            <kbd class=\"hidden sm:inline-block px-1.5 py-0.5 text-[10px] text-gray-400 bg-white border border-gray-200 rounded\">/</kbd>\n          </div>\n        </div>\n        <div class=\"h-6 w-px bg-gray-200 hidden md:block\"></div>\n        <button class=\"text-sm font-semibold text-gray-900 hover:text-brand transition-colors px-2\">Log In</button>\n        <button class=\"text-sm font-semibold bg-brand text-white px-4 py-1.5 rounded-lg hover:bg-brand/90 transition-colors shadow-sm\">Sign Up</button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Promo Banner -->\n  <div class=\"bg-[#eef2ff] border-b border-[#e0e7ff] text-sm overflow-hidden relative\">\n    <div class=\"max-w-[1400px] mx-auto px-4 py-2.5 flex items-center justify-between\">\n      <div class=\"flex items-center gap-2\">\n        <span class=\"bg-brand text-white text-[10px] font-bold px-1.5 py-0.5 rounded uppercase tracking-wider\">Announcement</span>\n        <span class=\"font-medium text-brand\" x-text=\"promos[promoIndex]\"></span>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <button @click=\"promoIndex = promoIndex > 0 ? promoIndex - 1 : promos.length - 1\" class=\"text-brand/60 hover:text-brand transition-colors\"><i data-lucide=\"chevron-left\" class=\"w-4 h-4\"></i></button>\n        <button @click=\"promoIndex = promoIndex < promos.length - 1 ? promoIndex + 1 : 0\" class=\"text-brand/60 hover:text-brand transition-colors\"><i data-lucide=\"chevron-right\" class=\"w-4 h-4\"></i></button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Main Content -->\n  <main class=\"max-w-[1400px] mx-auto px-4 md:px-6 py-8\">\n    \n    <!-- AI Alerts / Topic Bar -->\n    <div class=\"bg-white border border-gray-200 rounded-xl p-4 mb-8 shadow-sm\">\n      <div class=\"flex items-start gap-4\">\n        <div class=\"w-10 h-10 rounded-full bg-[#f0fdf4] flex items-center justify-center flex-shrink-0 text-green-600 border border-green-100\">\n          <i data-lucide=\"sparkles\" class=\"w-5 h-5\"></i>\n        </div>\n        <div class=\"flex-1\">\n          <h3 class=\"text-sm font-bold text-gray-900 mb-1 flex items-center gap-2\">\n            Market Intelligence\n            <span class=\"bg-green-100 text-green-700 text-[10px] px-1.5 py-0.5 rounded uppercase font-bold tracking-wide\">Live Insight</span>\n          </h3>\n          <p class=\"text-sm text-gray-600 mb-3 font-medium\">Stablecoin issuer eyes Solana DeFi expansion 👀</p>\n          <div class=\"flex flex-wrap gap-2\">\n            <button class=\"text-xs px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-full text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors font-medium\">Why is the market up today?</button>\n            <button class=\"text-xs px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-full text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors font-medium\">Are altcoins outperforming Bitcoin?</button>\n            <button class=\"text-xs px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-full text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors font-medium\">What are the trending narratives?</button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Title & Controls -->\n    <div class=\"mb-6 flex flex-col gap-4\">\n      <h1 class=\"text-2xl font-bold text-gray-900 tracking-tight\">Today's Cryptocurrency Prices by Market Cap</h1>\n      \n      <!-- Category Tabs -->\n      <div class=\"flex items-center gap-6 border-b border-gray-200 overflow-x-auto no-scrollbar pb-px\">\n        <template x-for=\"tab in ['Top', 'Trending', 'Watchlist', 'Prediction Markets', 'Most Visited', 'New', 'More']\">\n          <button \n            @click=\"categoryTab = tab\"\n            :class=\"categoryTab === tab ? 'border-brand text-brand font-semibold' : 'border-transparent text-gray-500 hover:text-gray-900 font-medium'\"\n            class=\"pb-3 text-sm border-b-2 whitespace-nowrap transition-colors\"\n            x-text=\"tab\"></button>\n        </template>\n      </div>\n\n      <!-- Filters & Toggles -->\n      <div class=\"flex flex-wrap items-center justify-between gap-4 mt-2\">\n        <div class=\"flex items-center gap-2 overflow-x-auto no-scrollbar\">\n          <template x-for=\"net in ['All Networks', 'BSC', 'Solana', 'Base', 'Ethereum', 'More']\">\n            <button \n              @click=\"networkTab = net\"\n              :class=\"networkTab === net ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50 hover:border-gray-300'\"\n              class=\"px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all whitespace-nowrap\"\n              x-text=\"net\"></button>\n          </template>\n        </div>\n        \n        <div class=\"flex items-center gap-2\">\n          <div class=\"relative\" x-data=\"{ open: false }\" @click.outside=\"open = false\">\n            <button @click=\"open = !open\" class=\"px-3 py-1.5 text-xs font-semibold text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors flex items-center gap-1.5\">\n              <i data-lucide=\"sliders-horizontal\" class=\"w-3.5 h-3.5\"></i> Filters\n            </button>\n            <div x-show=\"open\" style=\"display:none;\" class=\"absolute right-0 mt-2 w-64 bg-white border border-gray-200 rounded-xl shadow-lg p-4 z-50\">\n              <h4 class=\"font-semibold text-sm mb-3\">Filter Assets</h4>\n              <div class=\"space-y-3 text-sm\">\n                <label class=\"flex items-center gap-2\"><input type=\"checkbox\" class=\"rounded text-brand focus:ring-brand\"> Market Cap &gt; $1B</label>\n                <label class=\"flex items-center gap-2\"><input type=\"checkbox\" class=\"rounded text-brand focus:ring-brand\"> Volume &gt; $100M</label>\n                <label class=\"flex items-center gap-2\"><input type=\"checkbox\" class=\"rounded text-brand focus:ring-brand\"> Proof of Work</label>\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"relative\" x-data=\"{ open: false }\" @click.outside=\"open = false\">\n            <button @click=\"open = !open\" class=\"px-3 py-1.5 text-xs font-semibold text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors flex items-center gap-1.5\">\n              <i data-lucide=\"layout-grid\" class=\"w-3.5 h-3.5\"></i> Columns\n            </button>\n            <div x-show=\"open\" style=\"display:none;\" class=\"absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-xl shadow-lg p-4 z-50\">\n              <h4 class=\"font-semibold text-sm mb-3\">Toggle Columns</h4>\n              <div class=\"space-y-3 text-sm\">\n                <label class=\"flex items-center gap-2\"><input type=\"checkbox\" checked class=\"rounded text-brand focus:ring-brand\"> 1h %</label>\n                <label class=\"flex items-center gap-2\"><input type=\"checkbox\" checked class=\"rounded text-brand focus:ring-brand\"> 24h %</label>\n                <label class=\"flex items-center gap-2\"><input type=\"checkbox\" checked class=\"rounded text-brand focus:ring-brand\"> 7d %</label>\n                <label class=\"flex items-center gap-2\"><input type=\"checkbox\" checked class=\"rounded text-brand focus:ring-brand\"> Volume</label>\n                <label class=\"flex items-center gap-2\"><input type=\"checkbox\" checked class=\"rounded text-brand focus:ring-brand\"> Circulating Supply</label>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- The Table Container -->\n    <div class=\"bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden mb-6\">\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full text-left border-collapse min-w-[1000px]\">\n          <thead>\n            <!-- Index Tracker Row (as table header sub-row) -->\n            <tr class=\"bg-gray-50 border-b border-gray-20