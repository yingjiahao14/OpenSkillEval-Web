r justify-end gap-1\"><i data-lucide=\"info\" class=\"w-3 h-3 text-gray-400\"></i> Volume(24h)</div></th>\n              <th class=\"py-3 px-4 text-xs font-semibold text-gray-900 text-right\"><div class=\"flex items-center justify-end gap-1\"><i data-lucide=\"info\" class=\"w-3 h-3 text-gray-400\"></i> Circulating Supply</div></th>\n              <th class=\"py-3 px-4 text-xs font-semibold text-gray-900 text-right\">Last 7 Days</th>\n            </tr>\n          </thead>\n          <tbody class=\"divide-y divide-gray-100\">\n            ${tableRows}\n          </tbody>\n        </table>\n      </div>\n      \n      <!-- Pagination -->\n      <div class=\"p-4 border-t border-gray-100 flex items-center justify-between bg-gray-50 text-sm\">\n        <div class=\"text-gray-500 font-medium\">Showing 1–100 of 8,364 assets</div>\n        <div class=\"flex items-center gap-1\">\n          <button class=\"w-8 h-8 flex items-center justify-center rounded border border-gray-200 bg-white text-gray-400 cursor-not-allowed\"><i data-lucide=\"chevron-left\" class=\"w-4 h-4\"></i></button>\n          <button class=\"w-8 h-8 flex items-center justify-center rounded border border-brand bg-brand text-white font-semibold\">1</button>\n          <button class=\"w-8 h-8 flex items-center justify-center rounded border border-gray-200 bg-white text-gray-700 hover:bg-gray-50 font-semibold transition-colors\">2</button>\n          <button class=\"w-8 h-8 flex items-center justify-center rounded border border-gray-200 bg-white text-gray-700 hover:bg-gray-50 font-semibold transition-colors\">3</button>\n          <button class=\"w-8 h-8 flex items-center justify-center rounded border border-gray-200 bg-white text-gray-700 hover:bg-gray-50 font-semibold transition-colors\">4</button>\n          <span class=\"w-8 h-8 flex items-center justify-center text-gray-500\">...</span>\n          <button class=\"w-8 h-8 flex items-center justify-center rounded border border-gray-200 bg-white text-gray-700 