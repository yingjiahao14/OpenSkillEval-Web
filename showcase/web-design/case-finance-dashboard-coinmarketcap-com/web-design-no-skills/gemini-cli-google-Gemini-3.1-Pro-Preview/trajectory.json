or);\n      padding: 16px 0;\n      position: sticky;\n      top: 0;\n      background: var(--bg-color);\n      z-index: 100;\n    }\n    .navbar-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n    .brand {\n      font-size: 20px;\n      font-weight: 700;\n      color: var(--text-dark);\n    }\n    .nav-links {\n      display: flex;\n      gap: 24px;\n      font-weight: 600;\n    }\n    .nav-links a:hover {\n      color: var(--primary-blue);\n    }\n    .nav-actions {\n      display: flex;\n      gap: 16px;\n      align-items: center;\n    }\n    .btn-login {\n      font-weight: 600;\n      color: var(--text-dark);\n    }\n    .btn-login:hover { color: var(--primary-blue); }\n    .btn-signup {\n      background: var(--primary-blue);\n      color: white;\n      padding: 8px 16px;\n      border-radius: 8px;\n      font-weight: 600;\n    }\n    .btn-signup:hover {\n      background: #2b4ed4;\n    }\n\n    /* Promo Banner */\n    .promo-banner {\n      background: linear-gradient(90deg, #E8F0FE 0%, #F8F9FA 100%);\n      border-bottom: 1px solid var(--border-color);\n      overflow: hidden;\n      position: relative;\n    }\n    .carousel {\n      max-width: 1400px;\n      margin: 0 auto;\n      padding: 12px 40px;\n      position: relative;\n      text-align: center;\n      font-weight: 600;\n      color: var(--primary-blue);\n    }\n    .carousel-item {\n      display: none;\n    }\n    .carousel-item.active {\n      display: block;\n      animation: fadeIn 0.3s ease;\n    }\n    @keyframes fadeIn {\n      from { opacity: 0; }\n      to { opacity: 1; }\n    }\n    .carousel-btn {\n      position: absolute;\n      top: 50%;\n      transform: translateY(-50%);\n      background: none;\n      border: none;\n      font-size: 16px;\n      color: var(--text-gray);\n      cursor: pointer;\n      padding: 4px 8px;\n    }\n    .carousel-btn:hover { color: var(--text-dark); }\n    .carousel-btn.prev { left: 10px; }\n    .carousel-btn.next { right: 10px; }\n\n    /* AI Alerts */\n    .ai-alerts {\n      padding: 24px 20px;\n      border-bottom: 1px solid var(--border-color);\n    }\n    .ai-prompt {\n      font-size: 16px;\n      margin-bottom: 16px;\n    }\n    .ai-prompt strong { color: var(--primary-blue); }\n    .ai-quick-asks {\n      display: flex;\n      gap: 12px;\n      flex-wrap: wrap;\n    }\n    .ai-quick-asks button {\n      background: var(--bg-gray);\n      border: 1px solid var(--border-color);\n      border-radius: 20px;\n      padding: 6px 16px;\n      font-size: 13px;\n      color: var(--text-dark);\n      cursor: pointer;\n      font-family: var(--font-main);\n      transition: all 0.2s;\n    }\n    .ai-quick-asks button:hover {\n      background: #E8F0FE;\n      color: var(--primary-blue);\n      border-color: #E8F0FE;\n    }\n\n    /* Controls Section */\n    .controls-section {\n      padding: 24px 20px 16px;\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n    }\n    .tabs-row {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 16px;\n    }\n    .category-tabs, .network-tabs {\n      display: flex;\n      gap: 8px;\n      overflow-x: auto;\n      padding-bottom: 4px;\n    }\n    .category-tabs::-webkit-scrollbar, .network-tabs::-webkit-scrollbar {\n      height: 0;\n    }\n    .tab-btn {\n      background: none;\n      border: none;\n      padding: 8px 12px;\n      font-size: 14px;\n      font-weight: 600;\n      color: var(--text-gray);\n      cursor: pointer;\n      border-radius: 8px;\n      white-space: nowrap;\n    }\n    .tab-btn:hover {\n      background: var(--bg-gray);\n      color: var(--text-dark);\n    }\n    .tab-btn.active {\n      background: var(--bg-gray);\n      color: var(--text-dark);\n    }\n    \n    .table-actions {\n      display: flex;\n      gap: 12px;\n      position: relative;\n    }\n    .action-btn {\n      background: var(--bg-gray);\