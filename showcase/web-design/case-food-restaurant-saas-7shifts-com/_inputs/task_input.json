{
  "application": "web-design",
  "case_id": "case-food-restaurant-saas-shiftwise",
  "language": "en",
  "site": {
    "type": "saas",
    "page_count": 5,
    "audience": "restaurant owners, managers, and hospitality teams",
    "tone": "professional, modern, bold",
    "responsive": true,
    "dark_mode": false
  },
  "brief": {
    "title": "ShiftWise — Simplify Restaurant Team Management",
    "one_liner": "An all-in-one workforce management platform built for the restaurant and hospitality industry.",
    "goal": "Convert restaurant owners and managers into free trial sign-ups by showcasing scheduling, communication, and labor compliance features."
  },
  "pages": [
    {
      "page_id": "home",
      "file": "index.html",
      "sections": [
        "header",
        "hero",
        "features",
        "how-it-works",
        "testimonials",
        "stats",
        "pricing-teaser",
        "cta",
        "footer"
      ],
      "objective": "Introduce the platform, highlight key benefits, and drive visitors to start a free trial."
    },
    {
      "page_id": "features",
      "file": "features.html",
      "sections": [
        "header",
        "hero",
        "scheduling",
        "team-communication",
        "labor-compliance",
        "integrations",
        "cta",
        "footer"
      ],
      "objective": "Detail the core product features with visuals and descriptions."
    },
    {
      "page_id": "pricing",
      "file": "pricing.html",
      "sections": [
        "header",
        "hero",
        "pricing-table",
        "faq",
        "cta",
        "footer"
      ],
      "objective": "Present pricing tiers and answer common billing questions."
    },
    {
      "page_id": "about",
      "file": "about.html",
      "sections": [
        "header",
        "hero",
        "mission",
        "team",
        "stats",
        "cta",
        "footer"
      ],
      "objective": "Share the company story, mission, and team behind the product."
    },
    {
      "page_id": "contact",
      "file": "contact.html",
      "sections": [
        "header",
        "hero",
        "contact-form",
        "office-locations",
        "footer"
      ],
      "objective": "Provide a way for prospects and customers to reach the team."
    }
  ],
  "navigation": [
    {
      "from": "home",
      "trigger": "Features nav link",
      "to": "features"
    },
    {
      "from": "home",
      "trigger": "Pricing nav link",
      "to": "pricing"
    },
    {
      "from": "home",
      "trigger": "About nav link",
      "to": "about"
    },
    {
      "from": "home",
      "trigger": "Contact nav link",
      "to": "contact"
    },
    {
      "from": "features",
      "trigger": "Logo click",
      "to": "home"
    },
    {
      "from": "pricing",
      "trigger": "Logo click",
      "to": "home"
    },
    {
      "from": "about",
      "trigger": "Logo click",
      "to": "home"
    },
    {
      "from": "contact",
      "trigger": "Logo click",
      "to": "home"
    }
  ],
  "interactions": [
    {
      "id": "faq-accordion",
      "page": "pricing",
      "trigger": "Click on a FAQ question",
      "expected": "The answer expands below the question; other open answers collapse.",
      "type": "toggle"
    },
    {
      "id": "pricing-toggle",
      "page": "pricing",
      "trigger": "Toggle between monthly and annual billing",
      "expected": "Pricing values update to reflect the selected billing cycle.",
      "type": "state-change"
    },
    {
      "id": "mobile-nav-toggle",
      "page": "home",
      "trigger": "Click hamburger menu icon on mobile",
      "expected": "Navigation drawer slides open with all nav links.",
      "type": "toggle"
    },
    {
      "id": "testimonial-carousel",
      "page": "home",
      "trigger": "Click next/previous arrow on testimonials",
      "expected": "Testimonial card transitions to the next or previous customer quote.",
      "type": "state-change"
    },
    {
      "id": "contact-form-submit",
      "page": "contact",
      "trigger": "Fill in and submit the contact form",
      "expected": "Form validates required fields and shows a success confirmation message.",
      "type": "input"
    }
  ],
  "data_display": [
    {
      "id": "stats-banner",
      "page": "home",
      "type": "stats",
      "source_ref": "## Platform Stats",
      "expected_content": [
        "750,000+",
        "35,000+",
        "98%",
        "15 hrs/week"
      ],
      "description": "Key platform metrics: restaurants served, managers using the tool, satisfaction rate, and average time saved per week."
    },
    {
      "id": "pricing-table",
      "page": "pricing",
      "type": "table",
      "source_ref": "## Pricing Plans",
      "expected_content": [
        "Free",
        "Starter",
        "Premium",
        "$29.99/mo",
        "$69.99/mo",
        "Unlimited locations"
      ],
      "description": "Comparison table of pricing tiers with feature breakdowns."
    },
    {
      "id": "features-list",
      "page": "features",
      "type": "list",
      "source_ref": "## Core Features",
      "expected_content": [
        "Drag-and-drop scheduling",
        "Team messaging",
        "Labor law compliance alerts",
        "POS integrations",
        "Time clocking"
      ],
      "description": "List of core product features with brief descriptions."
    },
    {
      "id": "integration-partners",
      "page": "features",
      "type": "list",
      "source_ref": "## Integrations",
      "expected_content": [
        "Point of Sale",
        "Payroll",
        "Accounting",
        "Delivery platforms"
      ],
      "description": "Categories of third-party integrations supported by the platform."
    }
  ]
}