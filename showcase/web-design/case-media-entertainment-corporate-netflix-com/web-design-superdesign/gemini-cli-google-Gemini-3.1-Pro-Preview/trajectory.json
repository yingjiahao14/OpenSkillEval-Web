            "content": "<!DOCTYPE html>\n<html lang=\"en\" class=\"dark\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>StreamWave — Unlimited Films, Series and More</title>\n  <script src=\"../vendor/js/tailwind.js\"></script>\n  <link href=\"../vendor/css/flowbite.min.css\" rel=\"stylesheet\">\n  <script src=\"../vendor/js/lucide.min.js\"></script>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n  <style>\n    body {\n      font-family: 'Inter', sans-serif;\n      background-color: #000000;\n      color: #ffffff;\n    }\n    .hero-bg {\n      background-image: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,0.6) 50%, rgba(0,0,0,1) 100%), url('https://images.unsplash.com/photo-1595769816263-9b910be24d5f?q=80&w=2079&auto=format&fit=crop');\n      background-size: cover;\n      background-position: center;\n    }\n    \n    /* Carousel styling */\n    .carousel-container {\n      display: flex;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      scrollbar-width: none; /* Firefox */\n      -ms-overflow-style: none; /* IE/Edge */\n      padding-bottom: 2rem;\n    }\n    .carousel-container::-webkit-scrollbar {\n      display: none; /* Chrome/Safari */\n    }\n    .carousel-item {\n      flex: 0 0 auto;\n      scroll-snap-align: start;\n    }\n    \n    /* Number styling for ranking */\n    .rank-number {\n      font-size: 8rem;\n      font-weight: 900;\n      line-height: 1;\n      -webkit-text-stroke: 2px #555;\n      color: black;\n      text-shadow: 2px 2px 10px rgba(0,0,0,0.5);\n    }\n    \n    /* FAQ Accordion overrides */\n    .accordion-button {\n      background-color: #232323;\n      transition: background-color 0.2s;\n    }\n    .accordion-button:hover {\n      background-color: #414141;\n    }\n  </style>\n  <script>\n    tailwind.config = {\n      darkMode: 'class',\n      theme: {\n        extend: {\n          colors: {\n            brand: {\n              red: '#E50914',\n              redHover: '#C11119',\n              dark: '#141414',\n              black: '#000000',\n              gray: '#232323',\n              lightgray: '#737373',\n            }\n          }\n        }\n      }\n    }\n  </script>\n</head>\n<body class=\"bg-brand-black text-white antialiased\">\n\n  <!-- Header -->\n  <header class=\"absolute top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-4 md:px-12 md:py-6\">\n    <div class=\"text-brand-red font-black text-3xl md:text-4xl tracking-tighter\">\n      STREAMWAVE\n    </div>\n    <div class=\"flex items-center gap-4\">\n      <select class=\"bg-transparent border border-gray-600 text-white text-sm rounded px-3 py-1.5 focus:ring-brand-red focus:border-brand-red\">\n        <option value=\"en\" class=\"text-black\">English</option>\n      </select>\n      <a href=\"login.html\" class=\"bg-brand-red hover:bg-brand-redHover text-white font-medium py-1.5 px-4 rounded transition\">\n        Sign In\n      </a>\n    </div>\n  </header>\n\n  <main>\n    <!-- Hero Section -->\n    <section class=\"hero-bg relative min-h-screen flex items-center justify-center pt-24 pb-12 px-6\">\n      <div class=\"relative z-10 max-w-4xl mx-auto text-center\">\n        <h1 class=\"text-4xl md:text-6xl font-black mb-4 tracking-tight leading-tight\">Unlimited films, series and more</h1>\n        <p class=\"text-xl md:text-2xl font-medium mb-6\">Starts at $15.98. Cancel at any time.</p>\n        <p class=\"text-lg md:text-xl mb-6\">Ready to watch? Enter your email to create or restart your membership.</p>\n        \n        <form class=\"flex flex-col sm:flex-row justify-center max-w-2xl mx-auto gap-2\" onsubmit=\"event.preventDefault();\">\n          <div class=\"relative flex-1\">\n            <input type=\"email\" id=\"hero-email\" class=\"block w-full px-4 pt-5 pb-2 text-base text-white bg-black/50 border border-gray-500 rounded focus:ring-brand-red focus:border-brand-red peer\" placeholder=\" \" required />\n            <label for=\"hero-email\" class=\"absolute text-gray-400 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3\">Email address</label>\n          </div>\n          <button type=\"submit\" class=\"bg-brand-red hover:bg-brand-redHover text-white text-xl font-bold py-3 px-6 rounded flex items-center justify-center gap-2 transition w-full sm:w-auto\">\n            Get Started <i data-lucide=\"chevron-right\" class=\"w-6 h-6\"></i>\n          </button>\n        </form>\n      </div>\n      <!-- gradient divider at bottom -->\n      <div class=\"absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-brand-black to-transparent\"></div>\n    </section>\n\n    <!-- Trending Content -->\n    <section class=\"py-16 px-6 md:px-12 max-w-[1400px] mx-auto overflow-hidden\">\n      <h2 class=\"text-2xl md:text-3xl font-bold mb-8\">Trending now</h2>\n      \n      <div class=\"relative group\">\n        <div id=\"trending-carousel\" class=\"carousel-container flex gap-6 md:gap-8 pb-4\">\n          <!-- Items 1-10 -->\n          <div class=\"carousel-item relative w-40 md:w-56 flex-shrink-0 group/item cursor-pointer\">\n            <div class=\"absolute -left-6 bottom-4 md:-left-8 md:bottom-2 rank-number z-10 transition duration-300 group-hover/item:scale-110\">1</div>\n            <img src=\"https://images.unsplash.com/photo-1536440136628-849c177e76a1?q=80&w=400&h=600&auto=format&fit=crop\" alt=\"Bloodhounds\" class=\"rounded-lg shadow-lg relative z-0 w-full h-auto aspect-[2/3] object-cover transition duration-300 group-hover/item:brightness-75\" />\n          </div>\n          <div class=\"carousel-item relative w-40 md:w-56 flex-shrink-0 group/item cursor-pointer\">\n            <div class=\"absolute -left-6 bottom-4 md:-left-8 md:botto