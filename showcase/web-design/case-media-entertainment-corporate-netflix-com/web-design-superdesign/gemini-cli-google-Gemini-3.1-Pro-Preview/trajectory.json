olute bottom-6 right-6 text-brand-red\">\n            <i data-lucide=\"tv\" class=\"w-10 h-10\"></i>\n          </div>\n        </div>\n        <div class=\"bg-brand-gray rounded-xl p-6 min-h-[280px] relative transition-transform hover:-translate-y-2 duration-300\">\n          <h3 class=\"text-xl font-bold mb-4\">Download your series to watch offline</h3>\n          <p class=\"text-brand-lightgray text-sm md:text-base\">Save your favourites easily and always have something to watch.</p>\n          <div class=\"absolute bottom-6 right-6 text-brand-red\">\n            <i data-lucide=\"download\" class=\"w-10 h-10\"></i>\n          </div>\n        </div>\n        <div class=\"bg-brand-gray rounded-xl p-6 min-h-[280px] relative transition-transform hover:-translate-y-2 duration-300\">\n          <h3 class=\"text-xl font-bold mb-4\">Watch everywhere</h3>\n          <p class=\"text-brand-lightgray text-sm md:text-base\">Stream unlimited films and series on your phone, tablet, laptop and TV.</p>\n          <div class=\"absolute bottom-6 right-6 text-brand-red\">\n            <i data-lucide=\"smartphone\" class=\"w-10 h-10\"></i>\n          </div>\n        </div>\n        <div class=\"bg-brand-gray rounded-xl p-6 min-h-[280px] relative transition-transform hover:-translate-y-2 duration-300\">\n          <h3 class=\"text-xl font-bold mb-4\">Create profiles for children</h3>\n          <p class=\"text-brand-lightgray text-sm md:text-base\">Send children on adventures with their favourite characters in a space made just for them — free with your membership.</p>\n          <div class=\"absolute bottom-6 right-6 text-brand-red\">\n            <i data-lucide=\"smile\" class=\"w-10 h-10\"></i>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- FAQ -->\n    <section class=\"py-16 px-6 md:px-12 max-w-4xl mx-auto\">\n      <h2 class=\"text-2xl md:text-3xl font-bold mb-8 text-center\">Frequently Asked Questions</h2>\n      \n      <div id=\"accordion-flush\" d