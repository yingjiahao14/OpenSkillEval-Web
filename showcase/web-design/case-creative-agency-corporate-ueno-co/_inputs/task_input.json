{
  "application": "web-design",
  "case_id": "case-creative-agency-corporate-volta",
  "language": "en",
  "site": {
    "type": "corporate",
    "page_count": 5,
    "audience": "enterprise brands and innovative companies seeking strategic design partnerships",
    "tone": "minimal, editorial, warm",
    "responsive": true,
    "dark_mode": false
  },
  "brief": {
    "title": "Volta Studio — Strategic Design and Innovation Agency",
    "one_liner": "A boutique strategic design and innovation studio creating Function + Feeling for industry-leading clients.",
    "goal": "Establish Volta as a premium, returned design agency with a strong founder narrative, showcase world-class client work, and attract carefully selected enterprise clients through a minimal yet impactful web presence."
  },
  "pages": [
    {
      "page_id": "home",
      "file": "index.html",
      "sections": [
        "header",
        "hero",
        "media-showcase",
        "client-marquee",
        "about"
      ],
      "objective": "Introduce the studio with a bold headline, visual showcase, scrolling client ticker, and about section establishing credibility and history."
    },
    {
      "page_id": "neweno",
      "file": "neweno.html",
      "sections": [
        "header",
        "founder-letter"
      ],
      "objective": "Present a personal letter from the founder explaining the studio's return, history, and renewed mission in an editorial long-form format."
    },
    {
      "page_id": "services",
      "file": "services.html",
      "sections": [
        "header",
        "philosophy",
        "divider",
        "service-details"
      ],
      "objective": "Explain the studio's design philosophy of Function + Feeling and detail the three core service areas: Branding, Products, and Experiences."
    },
    {
      "page_id": "clients",
      "file": "clients.html",
      "sections": [
        "header",
        "clients-heading",
        "clients-grid"
      ],
      "objective": "Display a comprehensive grid of past and current clients with brief project descriptions organized in a three-column layout."
    },
    {
      "page_id": "contact",
      "file": "contact.html",
      "sections": [
        "header",
        "contact-hero",
        "contact-links"
      ],
      "objective": "Provide a dramatic oversized Contact heading with simple email and social media links for reaching the studio."
    }
