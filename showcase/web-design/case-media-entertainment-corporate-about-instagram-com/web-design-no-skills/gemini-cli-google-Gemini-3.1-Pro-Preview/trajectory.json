            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SnapFrame — Capture, Create & Share What You Love</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root {\n      --primary-black: #000000;\n      --accent-purple: #7638FA;\n      --accent-orange: #FF7A00;\n      --bg-light: #FAFAFA;\n      --text-main: #111111;\n      --text-muted: #555555;\n      --surface: #FFFFFF;\n      --border: #EAEAEA;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n      background-color: var(--bg-light);\n      color: var(--text-main);\n      line-height: 1.5;\n      overflow-x: hidden;\n    }\n\n    a {\n      text-decoration: none;\n      color: inherit;\n    }\n\n    ul {\n      list-style: none;\n    }\n\n    img {\n      max-width: 100%;\n      display: block;\n    }\n\n    .container {\n      max-width: 1200px;\n      margin: 0 auto;\n      padding: 0 24px;\n    }\n\n    /* Header */\n    header {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100%;\n      background: rgba(255, 255, 255, 0.9);\n      backdrop-filter: blur(10px);\n      z-index: 100;\n      border-bottom: 1px solid var(--border);\n    }\n\n    .header-inner {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      height: 72px;\n    }\n\n    .logo {\n      font-size: 24px;\n      font-weight: 800;\n      letter-spacing: -0.5px;\n      background: linear-gradient(90deg, var(--accent-purple), var(--accent-orange));\n      -webkit-background-clip: text;\n      color: transparent;\n    }\n\n    .header-actions {\n      display: flex;\n      align-items: center;\n      gap: 16px;\n    }\n\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      padding: 12px 24px;\n      border-radius: 99px;\n      font-weight: 600;\n      font-size: 15px;\n      transition: all 0.2s ease;\n      cursor: pointer;\n      border: none;\n    }\n\n    .btn-primary {\n      background: var(--primary-black);\n      color: white;\n    }\n\n    .btn-primary:hover {\n      background: #222;\n      transform: translateY(-1px);\n    }\n\n    .btn-outline {\n      background: transparent;\n      border: 1px solid var(--border);\n      color: var(--text-main);\n    }\n\n    .btn-outline:hover {\n      border-color: var(--primary-black);\n      background: var(--bg-light);\n    }\n    \n    .btn-gradient {\n      background: linear-gradient(135deg, var(--accent-purple), var(--accent-orange));\n      color: white;\n    }\n    .btn-gradient:hover {\n      opacity: 0.9;\n      transform: translateY(-2px);\n      box-shadow: 0 8px 20px rgba(118, 56, 250, 0.3);\n    }\n\n    .hamburger {\n      background: none;\n      border: none;\n      cursor: pointer;\n      display: flex;\n      flex-direction: column;\n      gap: 5px;\n      padding: 8px;\n    }\n\n    .hamburger span {\n      display: block;\n      width: 24px;\n      height: 2px;\n      background: var(--primary-black);\n      transition: all 0.3s ease;\n    }\n\n    /* Mobile Nav Overlay */\n    .mobile-nav {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100vh;\n      background: var(--surface);\n      z-index: 200;\n      display: flex;\n      flex-direction: column;\n      padding: 24px;\n      transform: translateX(100%);\n      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    .mobile-nav.active {\n      transform: translateX(0);\n    }\n\n    .mobile-nav-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 48px;\n    }\n\n    .close-btn {\n      background: none;\n      border: none;\n      font-size: 28px;\n      cursor: pointer;\n      color: var(--text-main);\n    }\n\n    .mobile-nav-links {\n      display: flex;\n      flex-direction: column;\n      gap: 24px;\n      font-size: 24px;\n      font-weight: 600;\n    }\n\n    .mobile-nav-links a {\n      transition: color 0.2s;\n    }\n    .mobile-nav-links a:hover {\n      color: var(--accent-purple);\n    }\n\n    /* Hero */\n    .hero {\n      padding: 160px 0 100px;\n      text-align: center;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .hero-bg {\n      position: absolute;\n      top: -20%;\n      left: 50%;\n      transform: translateX(-50%);\n      width: 100vw;\n      height: 100%;\n      background: radial-gradient(circle at 30% 20%, rgba(118, 56, 250, 0.15) 0%, transparent 40%),\n                  radial-gradient(circle at 70% 80%, rgba(255, 122, 0, 0.15) 0%, transparent 40%);\n      z-index: -1;\n      pointer-events: none;\n    }\n\n    .hero h1 {\n      font-size: clamp(40px, 6vw, 72px);\n      font-weight: 800;\n      line-height: 1.1;\n      letter-spacing: -1.5px;\n      max-width: 900px;\n      margin: 0 auto 32px;\n    }\n    \n    .hero p {\n      font-size: clamp(18px, 2vw, 22px);\n      color: var(--text-muted);\n      max-width: 600px;\n      margin: 0 auto 40px;\n    }\n\n    /* Generic Section Layout */\n    .section {\n      padding: 100px 0;\n    }\n\n    .split-layout {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 48px;\n      align-items: center;\n    }\n\n    @media (min-width: 768px) {\n      .split-layout {\n        grid-template-columns: 1fr 1fr;\n        gap: 80px;\n      }\n      .split-layout.reverse {\n        direction: rtl;\n      }\n      .split-layout.reverse > * {\n        direction: ltr;\n      }\n    }\n\n    .section-content h2 {\n      font-size: clamp(32px, 4vw, 48px);\n      font-weight: 700;\n      line-height: 1.2;\n      margin-bottom: 24px;\n      letter-spacing: -1px;\n    }\n\n    .section-content p {\n      font-size: 18px;\n      color: var(--text-muted);\n      margin-bottom: 32px;\n    }\n\n    .section-link {\n      font-weight: 600;\n      color: var(--primary-black);\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      font-size: 18px;\n      border-bottom: 2px solid transparent;\n      padding-bottom: 2px;\n      transition: border-color 0.2s;\n    }\n\n    .section-link:hover {\n      border-color: var(--primary-black);\n    }\n\n    .visual-placeholder {\n      width: 100%;\n      aspect-ratio: 4/3;\n      border-radius: 24px;\n      overflow: hidden;\n      position: relative;\n    }\n\n    .vp-features {\n      background: linear-gradient(135deg, #FFE8F2 0%, #FFF3EB 100%);\n    }\n    .vp-features::after {\n      content: '';\n      position: absolute;\n      top: 10%; left: 10%; right: 10%; bottom: 10%;\n      background: linear-gradient(135deg, #FF7A00, #FF3366);\n      border-radius: 20px;\n      opacity: 0.1;\n    }\n\n    .vp-safety {\n      background: linear-gradient(135deg, #E8F0FF 0%, #F3E8FF 100%);\n    }\n    \n    .vp-creators {\n      background: linear-gradient(135deg, #1A1A1A 0%, #333 100%);\n    }\n\n    .vp-decorative {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      width: 60%;\n      height: 60%;\n      background: rgba(255,255,255,0.8);\n      border-radius: 16px;\n      box-shadow: 0 20px 40px rgba(0,0,0,0.1);\n    }\n    .vp-creators .vp-decorative {\n      background: linear-gradient(135deg, var(--accent-purple), #FF3366);\n      border-radius: 50%;\n    }\n\n    /* Tagline Banner */\n    .tagline-banner {\n      padding: 120px 0;\n      text-align: center;\n      background: var(--primary-black);\n      color: white;\n    }\n\n    .tagline-banner h2 {\n      font-size: clamp(36px, 5vw, 64px);\n      font-weight: 800;\n      line-height: 1.1;\n      letter-spacing: -2px;\n      max-width: 900px;\n      margin: 0 auto;\n      background: linear-gradient(90deg, #FFFFFF, #A0A0A0);\n      -webkit-background-clip: text;\n      color: transparent;\n    }\n\n    /* News */\n    .news-section {\n      padding: 100px 0;\n      background: var(--surface);\n    }\n\n    .news-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-end;\n      margin-bottom: 48px;\n    }\n    \n    .news-header h2 {\n      font-size: 32px;\n      font-weight: 700;\n      letter-spacing: -0.5px;\n    }\n\n    .news-header p {\n      color: var(--accent-purple);\n      font-weight: 600;\n      font-size: 14px;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n      margin-bottom: 8px;\n    }\n\n    .carousel-container {\n      width: 100%;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      scrollbar-width: none; /* Firefox */\n      -ms-overflow-style: none;  /* IE and Edge */\n      padding-bottom: 24px;\n    }\n\n    .carousel-container::-webkit-scrollbar {\n      display: none;\n    }\n\n    .news-carousel {\n      display: flex;\n      gap: 24px;\n      padding: 0 24px;\n      margin: 0 -24px; /* bleed to edge */\n    }\n\n    .news-card {\n      flex: 0 0 calc(80vw - 48px);\n      max-width: 400px;\n      scroll-snap-align: start;\n      background: var(--bg-light);\n      border-radius: 20px;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      transition: transform 0.2s;\n    }\n\n    .news-card:hover {\n      transform: translateY(-4px);\n    }\n\n    .news-thumb {\n      width: 100%;\n      aspect-ratio: 16/9;\n      background: #EAEAEA;\n    }\n\n    .news-thumb-1 { background: linear-gradient(45deg, #D4C4FA, #F9D8B6); }\n    .news-thumb-2 { background: linear-gradient(45deg, #BCE4F7, #DDF3CC); }\n    .news-thumb-3 { background: linear-gradient(45deg, #FAD6E1, #D8CAFA); }\n    .news-thumb-4 { background: linear-gradient(45deg, #FDE6AC, #FBD1C7); }\n\n    .news-content {\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      flex-grow: 1;\n    }\n\n    .news-tags {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      margin-bottom: 16px;\n    }\n\n    .tag {\n      font-size: 12px;\n      font-weight: 600;\n      padding: 4px 10px;\n      border-radius: 100px;\n      background: rgba(0,0,0,0.05);\n      color: var(--text-muted);\n    }\n\n    .news-title {\n      font-size: 20px;\n      font-weight: 700;\n      line-height: 1.3;\n      margin-bottom: 24px;\n      letter-spacing: -0.5px;\n      flex-grow: 1;\n    }\n\n    .news-date {\n      font-size: 14px;\n      color: var(--text-muted);\n      font-weight: 500;\n    }\n\n    /* CTA Download */\n    .cta-download {\n      padding: 120px 0;\n      text-align: center;\n      background: var(--bg-light);\n    }\n\n    .cta-download h2 {\n      font-size: clamp(32px, 4vw, 48px);\n      font-weight: 700;\n      margin-bottom: 16px;\n      letter-spacing: -1px;\n    }\n    \n    .cta-download p {\n      font-size: 20px;\n      color: var(--text-muted);\n      margin-bottom: 40px;\n    }\n\n    .cta-buttons {\n      display: flex;\n      justify-content: center;\n      gap: 16px;\n      flex-wrap: wrap;\n    }\n\n    .btn-store {\n      background: var(--primary-black);\n      color: white;\n      padding: 14px 32px;\n      border-radius: 12px;\n      font-weight: 600;\n      font-size: 16px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      transition: background 0.2s;\n      border: none;\n      cursor: pointer;\n    }\n\n    .btn-store:hover {\n      background: #222;\n    }\n\n    /* Footer */\n    footer {\n      background: var(--surface);\n      padding: 80px 0 40px;\n      border-top: 1px solid var(--border);\n    }\n\n    .footer-grid {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 40px;\n      margin-bottom: 80px;\n    }\n\n    @media (min-width: 768px) {\n      .footer-grid {\n        grid-template-columns: repeat(3, 1fr);\n      }\n    }\n\n    @media (min-width: 1024px) {\n      .footer-grid {\n        grid-template-columns: repeat(6, 1fr);\n      }\n    }\n\n    .footer-col h3 {\n      font-size: 14px;\n      font-weight: 600;\n      color: var(--text-muted);\n      margin-bottom: 24px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n\n    .footer-col ul {\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n    }\n\n    .footer-col a {\n      font-size: 15px;\n      color: var(--primary-black);\n      font-weight: 500;\n      transition: color 0.2s;\n    }\n\n    .footer-col a:hover {\n      color: var(--accent-purple);\n    }\n\n    .footer-bottom {\n      display: flex;\n      flex-direction: column;\n      gap: 24px;\n      padding-top: 40px;\n      border-top: 1px solid var(--border);\n    }\n\n    @media (min-width: 768px) {\n      .footer-bottom {\n        flex-direction: row;\n        justify-content: space-between;\n        align-items: center;\n      }\n    }\n\n    .footer-selectors {\n      display: flex;\n      gap: 16px;\n      align-items: center;\n    }\n\n    .lang-selector {\n      font-size: 14px;\n      font-weight: 500;\n      color: var(--text-muted);\n      cursor: pointer;\n    }\n\n    .footer-social {\n      display: flex;\n      gap: 16px;\n    }\n\n    .social-icon {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      background: var(--text-muted);\n      display: inline-block;\n      opacity: 0.8;\n      transition: opacity 0.2s;\n    }\n    .social-icon:hover {\n      opacity: 1;\n      background: var(--primary-black);\n    }\n\n    .footer-legal-container {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n    }\n\n    @media (min-width: 768px) {\n      .footer-legal-container {\n        align-items: flex-end;\n      }\n    }\n\n    .footer-legal {\n      display: flex;\n      gap: 16px;\n      flex-wrap: wrap;\n    }\n\n    .footer-legal a {\n      font-size: 13px;\n      color: var(--text-muted);\n    }\n    .footer-legal a:hover {\n      color: var(--primary-black);\n    }\n\n    .footer-copyright {\n      font-size: 13px;\n      color: var(--text-muted);\n      margin-top: 8px;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Header -->\n  <header>\n    <div class=\"container header-inner\">\n      <a href=\"index.html\" class=\"logo\">SnapFrame</a>\n      <div class=\"header-actions\">\n        <a href=\"index.html\" class=\"btn btn-primary\">Log in</a>\n        <button class=\"hamburger\" id=\"hamburger-menu\" aria-label=\"Open menu\">\n          <span></span>\n          <span></span>\n          <span></span>\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Mobile Nav -->\n  <div class=\"mobile-nav\" id=\"mobile-nav\">\n    <div class=\"mobile-nav-header\">\n      <div class=\"logo\">SnapFrame</div>\n      <button class=\"close-btn\" id=\"close-menu\" aria-label=\"Close menu\">&times;</button>\n    </div>\n    <div class=\"mobile-nav-links\">\n      <a href=\"index.html\">Home</a>\n      <a href=\"index.html\">Features</a>\n      <a href=\"index.html\">Safety</a>\n      <a href=\"index.html\">Creators</a>\n      <a href=\"index.html\">News</a>\n    </div>\n  </div>\n\n  <main>\n    <!-- Hero Section -->\n    <section class=\"hero\">\n      <div class=\"hero-bg\"></div>\n      <div class=\"container\">\n        <h1>SnapFrame brings you closer to the people and things you love</h1>\n        <p>SnapFrame is a social media platform that makes it easy to capture, create, and share what you love with the people who matter most.</p>\n        <a href=\"index.html\" class=\"btn btn-gradient\" style=\"padding: 16px 32px; font-size: 18px;\">Try it now</a>\n      </div>\n    </section>\n\n    <!-- Features Section -->\n    <section class=\"section\" id=