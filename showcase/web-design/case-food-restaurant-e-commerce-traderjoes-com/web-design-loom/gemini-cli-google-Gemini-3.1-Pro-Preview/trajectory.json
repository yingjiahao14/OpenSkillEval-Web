            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Fresh Pantry — Discover Everyday Deliciousness</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            --primary: #2D6A4F;\n            --primary-dark: #1b4332;\n            --accent: #F4A261;\n            --accent-hover: #e78c43;\n            --bg: #FEFAE0;\n            --text-main: #2b2b2b;\n            --text-light: #555555;\n            --white: #ffffff;\n            --radius-md: 12px;\n            --radius-lg: 24px;\n            --radius-pill: 9999px;\n            --shadow-sm: 0 4px 6px rgba(0, 0, 0, 0.05);\n            --shadow-md: 0 10px 15px rgba(0, 0, 0, 0.05);\n            --transition: all 0.3s ease;\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: var(--bg);\n            color: var(--text-main);\n            line-height: 1.6;\n            overflow-x: hidden;\n        }\n\n        h1, h2, h3, h4, .brand-logo {\n            font-family: 'Nunito', sans-serif;\n            color: var(--primary);\n        }\n\n        a {\n            text-decoration: none;\n            color: inherit;\n        }\n\n        ul {\n            list-style: none;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 20px;\n        }\n\n        /* Header */\n        header {\n            background-color: var(--white);\n            padding: 20px 0;\n            position: sticky;\n            top: 0;\n            z-index: 100;\n            box-shadow: var(--shadow-sm);\n        }\n\n        .header-content {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .brand-logo {\n            font-size: 1.8rem;\n            font-weight: 800;\n            letter-spacing: -0.5px;\n        }\n\n        .nav-links {\n            display: flex;\n            gap: 30px;\n        }\n\n        .nav-links a {\n            font-weight: 500;\n            transition: var(--transition);\n        }\n\n        .nav-links a:hover {\n            color: var(--accent);\n        }\n\n        /* Buttons */\n        .btn {\n            display: inline-block;\n            padding: 12px 24px;\n            border-radius: var(--radius-pill);\n            font-weight: 600;\n            cursor: pointer;\n            border: none;\n            transition: var(--transition);\n            font-family: 'Inter', sans-serif;\n            font-size: 1rem;\n            text-align: center;\n        }\n\n        .btn-primary {\n            background-color: var(--primary);\n            color: var(--white);\n        }\n\n        .btn-primary:hover {\n            background-color: var(--primary-dark);\n            transform: translateY(-2px);\n            color: var(--white);\n        }\n\n        .btn-accent {\n            background-color: var(--accent);\n            color: var(--white);\n        }\n\n        .btn-accent:hover {\n            background-color: var(--accent-hover);\n            transform: translateY(-2px);\n        }\n\n        .btn-outline {\n            background-color: transparent;\n            border: 2px solid var(--primary);\n            color: var(--primary);\n        }\n\n        .btn-outline:hover {\n            background-color: var(--primary);\n            color: var(--white);\n        }\n\n        /* Hero Section */\n        .hero {\n            padding: 80px 0;\n            text-align: center;\n        }\n\n        .hero h1 {\n            font-size: 3.5rem;\n            line-height: 1.1;\n            margin-bottom: 24px;\n            color: var(--primary-dark);\n        }\n\n        .hero p {\n            font-size: 1.25rem;\n            color: var(--text-light);\n            max-width: 700px;\n            margin: 0 auto 40px auto;\n        }\n\n        .hero-ctas {\n            display: flex;\n            gap: 20px;\n            justify-content: center;\n        }\n\n        /* Featured Products Carousel */\n        .section-header {\n            margin-bottom: 40px;\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-end;\n        }\n\n        .section-header h2 {\n            font-size: 2.5rem;\n        }\n\n        .section-padding {\n            padding: 80px 0;\n        }\n\n        .carousel-container {\n            position: relative;\n        }\n\n        .carousel-track {\n            display: flex;\n            gap: 24px;\n            overflow-x: auto;\n            scroll-behavior: smooth;\n            padding-bottom: 20px;\n            scrollbar-width: none; /* Firefox */\n        }\n\n        .carousel-track::-webkit-scrollbar {\n            display: none; /* Chrome/Safari */\n        }\n\n        .product-card {\n            min-width: 280px;\n            background-color: var(--white);\n            border-radius: var(--radius-md);\n            padding: 20px;\n            box-shadow: var(--shadow-sm);\n            transition: var(--transition);\n        }\n\n        .product-card:hover {\n            box-shadow: var(--shadow-md);\n            transform: translateY(-5px);\n        }\n\n        .product-img {\n            width: 100%;\n            height: 200px;\n            border-radius: var(--radius-md);\n            margin-bottom: 16px;\n        }\n        \n        .p1 { background: linear-gradient(135deg, #fdfcdc 0%, #f0ead2 100%); }\n        .p2 { background: linear-gradient(135deg, #ffe5d9 0%, #ffcad4 100%); }\n        .p3 { background: linear-gradient(135deg, #d8e2dc 0%, #ffe5d9 100%); }\n        .p4 { background: linear-gradient(135deg, #fcd5ce 0%, #f8edeb 100%); }\n        .p5 { background: linear-gradient(135deg, #e8e8e4 0%, #d8e2dc 100%); }\n        .p6 { background: linear-gradient(135deg, #fae1dd 0%, #fec89a 100%); }\n        .p7 { background: linear-gradient(135deg, #ffd7ba 0%, #fec89a 100%); }\n        .p8 { background: linear-gradient(135deg, #e9edc9 0%, #ccd5ae 100%); }\n\n        .product-card h3 {\n            font-size: 1.25rem;\n            margin-bottom: 8px;\n            color: var(--primary-dark);\n        }\n\n        .product-card p {\n            font-size: 0.9rem;\n            color: var(--text-light);\n            margin-bottom: 16px;\n            min-height: 60px;\n        }\n\n        .product-price {\n            font-weight: 700;\n            font-size: 1.25rem;\n            color: var(--accent);\n        }\n\n        .carousel-btn {\n            background-color: var(--white);\n            border: none;\n            width: 44px;\n            height: 44px;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            cursor: pointer;\n            box-shadow: var(--shadow-sm);\n            color: var(--primary);\n            font-size: 1.5rem;\n            transition: var(--transition);\n        }\n\n        .carousel-btn:hover {\n            background-color: var(--primary);\n            color: var(--white);\n        }\n\n        .carousel-nav {\n            display: flex;\n            gap: 12px;\n        }\n\n        /* Seasonal Picks */\n        .seasonal-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));\n            gap: 30px;\n        }\n\n        .seasonal-card {\n            display: flex;\n            background-color: var(--white);\n            border-radius: var(--radius-md);\n            overflow: hidden;\n            box-shadow: var(--shadow-sm);\n        }\n\n        .seasonal-img {\n            width: 200px;\n            flex-shrink: 0;\n        }\n\n        .seasonal-content {\n            padding: 24px;\n            flex: 1;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n        }\n\n        .seasonal-content h3 {\n            font-size: 1.25rem;\n            margin-bottom: 8px;\n        }\n\n        .seasonal-content p {\n            color: var(--text-light);\n            margin-bottom: 16px;\n            font-size: 0.95rem;\n        }\n\n        .s1 { background: linear-gradient(135deg, #ff99c8 0%, #fcf6bd 100%); }\n        .s2 { background: linear-gradient(135deg, #d0f4de 0%, #a9def9 100%); }\n        .s3 { background: linear-gradient(135deg, #e4c1f9 0%, #fcf6bd 100%); }\n        .s4 { background: linear-gradient(135deg, #ffb5a7 0%, #fcd5ce 100%); }\n\n        /* Brand Highlights */\n        .highlights-banner {\n            background-color: var(--primary);\n            color: var(--white);\n            padding: 60px 0;\n            margin: 40px 0;\n        }\n\n        .highlights-grid {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 30px;\n            text-align: center;\n        }\n\n        .highlight-item h3 {\n            font-size: 2.5rem;\n            color: var(--accent);\n            margin-bottom: 10px;\n        }\n\n        .highlight-item p {\n            font-size: 1.1rem;\n            font-weight: 500;\n        }\n\n        /* Categories */\n        .categories-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n            gap: 20px;\n        }\n\n        .category-card {\n            position: relative;\n            height: 250px;\n            border-radius: var(--radius-md);\n            overflow: hidden;\n            cursor: pointer;\n            transition: var(--transition);\n        }\n        \n        .c1 { background: linear-gradient(135deg, #f4a261 0%, #e76f51 100%); }\n        .c2 { background: linear-gradient(135deg, #2a9d8f 0%, #264653 100%); }\n        .c3 { background: linear-gradient(135deg, #4ea8de 0%, #5390d9 100%); }\n        .c4 { background: linear-gradient(135deg, #e9c46a 0%, #f4a261 100%); }\n        .c5 { background: linear-gradient(135deg, #8ab17d 0%, #2d6a4f 100%); }\n\n        .category-overlay {\n            position: absolute;\n            inset: 0;\n            background-color: rgba(0, 0, 0, 0.4);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            opacity: 0;\n            transition: var(--transition);\n        }\n\n        .category-overlay h3 {\n            color: var(--white);\n            font-size: 1.5rem;\n            text-align: center;\n            padding: 0 20px;\n            transform: translateY(20px);\n            transition: var(--transition);\n        }\n\n        .category-card:hover {\n            transform: scale(1.05);\n            z-index: 10;\n            box-shadow: var(--shadow-md);\n        }\n\n        .category-card:hover .category-overlay {\n            opacity: 1;\n        }\n\n        .category-card:hover .category-overlay h3 {\n            transform: translateY(0);\n        }\n\n        /* Store Locator */\n        .locator-section {\n            background-color: var(--white);\n            border-radius: var(--radius-lg);\n            padding: 60px;\n            box-shadow: var(--shadow-md);\n            text-align: center;\n            margin-bottom: 80px;\n        }\n\n        .locator-section h2 {\n            font-size: 2.5rem;\n            margin-bottom: 16px;\n        }\n\n        .locator-section p {\n            color: var(--text-light);\n            margin-bottom: 32px;\n            font-size: 1.1rem;\n        }\n\n        .search-form {\n            display: flex;\n            max-width: 500px;\n            margin: 0 auto;\n            gap: 12px;\n        }\n\n        .search-input {\n            flex: 1;\n            padding: 16px 24px;\n            border: 1px solid #ddd;\n            border-radius: var(--radius-pill);\n            font-size: 1rem;\n            font-family: inherit;\n        }\n\n        .search-input:focus {\n            outline: none;\n            border-color: var(--primary);\n        }\n\n        .store-results {\n            margin-top: 40px;\n            display: none;\n            text-align: left;\n            overflow-x: auto;\n        }\n\n        .store-results table {\n            width: 100%;\n            border-collapse: collapse;\n            min-width: 600px;\n        }\n\n        .store-results th, .store-results td {\n            padding: 16px;\n            border-bottom: 1px solid #eee;\n        }\n\n        .store-results th {\n            font-weight: 600;\n            color: var(--primary);\n        }\n\n        /* Newsletter */\n        .newsletter-section {\n            background-color: var(--accent);\n            padding: 80px 0;\n            text-align: center;\n            color: var(--white);\n        }\n\n        .newsletter-section h2 {\n            color: var(--white);\n            font-size: 2.5rem;\n            margin-bottom: 16px;\n        }\n\n        .newsletter-section p {\n            font-size: 1.1rem;\n            margin-bottom: 32px;\n        }\n        \n        .newsletter-form {\n            display: flex;\n            max-width: 500px;\n            margin: 0 auto;\n            gap: 12px;\n        }\n\n        .newsletter-msg {\n            margin-top: 20px;\n            font-weight: 600;\n            display: none;\n            background-color: rgba(255, 255, 255, 0.2);\n            padding: 12px;\n            border-radius: var(--radius-md);\n            max-width: 500px;\n            margin-left: auto;\n            margin-right: auto;\n        }\n\n        /* Footer */\n        footer {\n            background-color: var(--primary-dark);\n            color: var(--white);\n            padding: 80px 0 40px 0;\n        }\n\n        .footer-grid {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 40px;\n            margin-bottom: 60px;\n        }\n\n        .footer-col h4 {\n            color: var(--accent);\n            font-size: 1.25rem;\n            margin-bottom: 24px;\n        }\n\n        .footer-col ul {\n            display: flex;\n            flex-direction: column;\n            gap: 12px;\n        }\n\n        .footer-col a {\n            color: #ddd;\n            transition: var(--transition);\n        }\n\n        .footer-col a:hover {\n            color: var(--white);\n        }\n\n        .footer-bottom {\n            border-top: 1px solid rgba(255, 255, 255, 0.1);\n            padding-top: 24px;\n            text-align: center;\n            color: #aaa;\n        }\n\n        /* Responsive */\n        @media (max-width: 900px) {\n            .seasonal-grid { grid-template-columns: 1fr; }\n            .highlights-grid { grid-template-columns: repeat(2, 1fr); }\n            .footer-grid { grid-template-columns: repeat(2, 1fr); }\n        }\n\n        @media (max-width: 768px) {\n            .hero h1 { font-size: 2.5rem; }\n            .nav-links { display: none; }\n            .seasonal-card { flex-direction: column; }\n            .seasonal-img { width: 100%; height: 200px; }\n            .search-form, .newsletter-form { flex-direction: column; }\n            .section-header { flex-direction: column; align-items: flex-start; gap: 16px; }\n            .locator-section { padding: 40px 20px; }\n        }\n\n        @media (max-width: 480px) {\n            .highlights-grid { grid-template-columns: 1fr; }\n            .footer-grid { grid-template-columns: 1fr; }\n            .hero-ctas { flex-direction: column; }\n        }\n    </style>\n</head>\n<body>\n